---
// Shown for any URL that doesn't exist (Astro serves this for unknown routes).
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import StatePanel from '../components/StatePanel.astro';
import { routes } from '../lib/routes';
---

<Base title="Page not found · Inhandy">
  <div class="page paper-dots">
    <nav class="nav" aria-label="Main">
      <a href={routes.landing} class="nav__logo" aria-label="Inhandy home"><Logo size={36} /></a>
    </nav>
    <main class="main">
      <StatePanel mood="gasp" title="Arre, this page went missing" text="The link may be old or mistyped. Your money and plans are safe; only this page wandered off.">
        <div class="state__actions">
          <a href={routes.home} class="btn btn--mango btn--lg">Go to Home</a>
          <a href={routes.help} class="btn">Get help</a>
        </div>
      </StatePanel>
    </main>
  </div>
</Base>

<style>
  .page {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .nav {
    padding: 24px 32px;
  }

  .nav__logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 20px 64px;
  }

  @media (max-width: 639px) {
    .nav {
      padding: 16px;
    }

    .main {
      align-items: flex-start;
      padding: 16px 16px 48px;
    }
  }
</style>
