---
import AppShell from '../../../layouts/AppShell.astro';
import { routes } from '../../../lib/routes';
import { inr } from '../../../lib/format';
import { DEFAULT_JARS, MONTHLY_INHAND } from '../../../data/demo-plan';
import { sipProjection } from '../../../lib/sip';

const start = 2000;
const sipJar = (MONTHLY_INHAND * DEFAULT_JARS.find((j) => j.id === 'sip')!.pct) / 100;

const steps = [
  ['Finish KYC once', 'PAN, Aadhaar and a selfie video. Most apps do it in 10 minutes.'],
  [
    'Pick a direct, low-cost index fund',
    '“Direct” plans skip distributor commission. An index fund just follows the market, so no star manager to bet on.',
  ],
  ['Set the SIP date 2–3 days after payday', 'So the money is there. With payday on the 7th, the 10th works.'],
  ['Come back and tap “I’ve started it”', 'Handy moves the amount out of your SIP jar each month and tracks your streak.'],
];
---

<AppShell title="Start your first SIP" active="plan">
  <header class="head">
    <a href={routes.plan} class="back">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"></path></svg>
      Back to plan
    </a>
    <h1>Start your first SIP</h1>
    <p class="muted">A SIP (systematic investment plan) puts a fixed amount into a mutual fund every month, automatically.</p>
  </header>

  <section class="card amount" aria-label="Pick an amount" data-sip data-inhand={MONTHLY_INHAND}>
    <div class="amount__top">
      <label for="sip-amt" class="amount__label">Monthly amount</label>
      <span class="num amount__value" data-amt>{inr(start)}</span>
    </div>
    <input
      id="sip-amt"
      class="rng"
      type="range"
      min="500"
      max="10000"
      step="500"
      value={start}
      aria-valuetext={`${inr(start)} a month`}
      style={`--p: ${(((start - 500) / 9500) * 100).toFixed(1)}%; --c: var(--mint)`}
    />
    <p class="num muted">
      That’s <span data-pct>{((start / MONTHLY_INHAND) * 100).toFixed(1)}%</span> of your in-hand pay. Your SIP jar already holds {inr(sipJar)} a month.
    </p>
    <div class="num proj">
      {
        sipProjection(start).map((p) => (
          <div class="proj__item" data-years={p.years}>
            <span class="proj__label">{p.label}</span>
            <span class="proj__value" data-value>
              {inr(p.value)}
            </span>
            <span class="proj__in">
              you put in <span data-in>{inr(p.invested)}</span>
            </span>
          </div>
        ))
      }
    </div>
    <p class="muted">Illustration at an assumed 10% a year. Mutual funds go up and down; returns aren’t guaranteed. Not investment advice.</p>
  </section>

  <aside class="side">
    <section class="card steps" aria-labelledby="sip-steps">
      <h2 id="sip-steps" class="card__title">How to start, in 4 steps</h2>
      <ol class="steps__list">
        {
          steps.map(([t, b], i) => (
            <li class="step">
              <span class="num step__n" aria-hidden="true">
                {i + 1}
              </span>
              <span class="step__text">
                <b>{t}</b>
                <span class="muted">{b}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </section>
    <a href={routes.plan} class="btn btn--mango btn--lg">I’ve started it, track my SIP</a>
    <p class="muted">Inhandy doesn’t sell funds or take commission. Use any SEBI-registered platform.</p>
  </aside>
</AppShell>

<script>
  import { inr } from '../../../lib/format';
  import { sipProjection } from '../../../lib/sip';

  const box = document.querySelector<HTMLElement>('[data-sip]');
  if (box) {
    const inhand = Number(box.dataset.inhand);
    const input = box.querySelector<HTMLInputElement>('#sip-amt')!;

    input.addEventListener('input', () => {
      const v = parseInt(input.value, 10);
      box.querySelector('[data-amt]')!.textContent = inr(v);
      box.querySelector('[data-pct]')!.textContent = ((v / inhand) * 100).toFixed(1) + '%';
      input.setAttribute('aria-valuetext', `${inr(v)} a month`);
      input.style.setProperty('--p', (((v - 500) / 9500) * 100).toFixed(1) + '%');
      for (const p of sipProjection(v)) {
        const item = box.querySelector(`[data-years="${p.years}"]`)!;
        item.querySelector('[data-value]')!.textContent = inr(p.value);
        item.querySelector('[data-in]')!.textContent = inr(p.invested);
      }
    });
  }
</script>

<style>
  .muted {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .head {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
    color: var(--violet);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 40px;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .card {
    padding: 24px;
    border-radius: 28px;
    background: var(--white);
    border: 2.5px solid var(--ink);
    box-shadow: 0 6px 0 var(--ink);
  }

  .card__title {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
  }

  .amount {
    grid-column: span 7;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .amount__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .amount__label {
    font-weight: 800;
    font-size: 18px;
  }

  .amount__value {
    font-weight: 800;
    font-size: 36px;
    letter-spacing: -0.03em;
  }

  .proj {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .proj__item {
    padding: 14px;
    border-radius: 16px;
    background: #e2f8ef;
    min-width: 0;
  }

  .proj__label {
    display: block;
    font-size: 16px;
    font-weight: 700;
    color: #0a6b4d;
  }

  .proj__value {
    display: block;
    font-weight: 800;
    font-size: 22px;
  }

  .proj__in {
    font-size: 16px;
    color: var(--ink-muted);
  }

  .side {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .steps__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .step {
    display: flex;
    gap: 12px;
    padding: 10px 0;
    border-top: 2px dashed var(--line);
  }

  .step__n {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--mint);
    border: 2.5px solid var(--ink);
    box-sizing: border-box;
    font-weight: 800;
    font-size: 16px;
  }

  .step__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 16px;
  }

  .step__text .muted {
    line-height: 1.45;
  }

  @media (max-width: 1279px) {
    .amount,
    .side {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 639px) {
    .proj {
      grid-template-columns: minmax(0, 1fr);
    }

    .amount__value {
      font-size: 30px;
    }
  }
</style>
