---
// How to cancel: walks through each subscription picked for cancelling on the scan results.
// The list comes from the browser (what the user picked); the server renders the default picks.
import AppShell from '../../../layouts/AppShell.astro';
import Celebration from '../../../components/Celebration.astro';
import { routes } from '../../../lib/routes';
import { inr } from '../../../lib/format';
import { DEFAULT_CUT, SCAN_RESULTS } from '../../../data/demo-tools';

const picked = SCAN_RESULTS.filter((s) => DEFAULT_CUT.includes(s.id));
const first = picked[0];
---

<AppShell title="How to cancel" active="scan">
  <header class="head">
    <a href={`${routes.scan}?results`} class="back">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"></path></svg>
      Back to scan results
    </a>
    <h1>Let’s cancel them, one by one</h1>
    <p class="muted">We can’t cancel for you, but we’ll walk you through it. Most take under 2 minutes.</p>
  </header>

  <div class="guide" data-guide data-subs={JSON.stringify(SCAN_RESULTS)} data-default-cut={JSON.stringify(DEFAULT_CUT)}>
    <aside class="side">
      <div class="picker" role="group" aria-label="Subscriptions to cancel" data-picker>
        {
          picked.map((s, i) => (
            <button type="button" class="pick" data-pick={s.id} aria-pressed={i === 0 ? 'true' : 'false'}>
              <span class="pick__tile" aria-hidden="true">
                {s.label.charAt(0)}
              </span>
              <span class="pick__text">
                <span class="pick__label">{s.label}</span>
                <span class="num muted">
                  {inr(s.monthly)}/mo · {inr(s.monthly * 12)}/yr
                </span>
              </span>
              <span class="pick__status" data-status>To do</span>
            </button>
          ))
        }
      </div>
      <div class="saved">
        <span class="saved__label">Saved so far</span>
        <span class="num saved__amount" aria-live="polite"><span data-saved>₹0</span><span class="saved__per"> a year</span></span>
        <span class="num saved__label"><span data-done-count>0</span> of <span data-total>{picked.length}</span> cancelled</span>
      </div>
    </aside>

    <section class="card how" aria-labelledby="guide-h" data-how>
      <div class="how__top">
        <h2 id="guide-h" class="how__title">Cancel <span data-cur-label>{first?.label}</span></h2>
        <span class="num how__amt"><span data-cur-amt>{first ? inr(first.monthly) : ''}</span>/mo</span>
      </div>
      <p class="why" data-cur-why>{first?.why}</p>
      <ol class="steps" data-steps></ol>
      <div class="actions" data-actions-todo>
        <button type="button" class="btn btn--mango btn--lg" data-mark-done>
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10"></path></svg>
          I’ve cancelled it
        </button>
        <button type="button" class="btn" data-remind>
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7v5l3 2"></path></svg>
          Remind me tomorrow
        </button>
      </div>
      <div class="actions" data-actions-done hidden>
        <p class="killed pop-in" role="status">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10"></path></svg>
          <span data-killed></span>
        </p>
        <button type="button" class="btn" data-undo>Undo</button>
      </div>
      <p class="muted">
        Steps differ a little by app. If it was set up as a UPI autopay or card mandate, cancelling the membership doesn’t always stop
        the mandate, so do step 4 too.
      </p>
    </section>

    <section class="card empty" data-empty hidden>
      <h2 class="how__title">Nothing to cancel</h2>
      <p class="muted">You chose to keep everything. Pick something on the scan results to get cancel steps.</p>
      <a href={`${routes.scan}?results`} class="btn btn--mango">Back to scan results</a>
    </section>
  </div>
  <Celebration />
</AppShell>

<script>
  import { inr } from '../../../lib/format';
  import type { Subscription } from '../../../data/demo-tools';
  import { readLocal, writeLocal } from '../../../scripts/local-state';
  import { showToast } from '../../../scripts/toast';
  import { routes } from '../../../lib/routes';

  const root = document.querySelector<HTMLElement>('[data-guide]')!;
  const all = JSON.parse(root.dataset.subs!) as Subscription[];
  const cutIds = readLocal<string[]>('scan:cut', JSON.parse(root.dataset.defaultCut!));
  const picked = all.filter((s) => cutIds.includes(s.id));
  const done = new Set<string>(readLocal<string[]>('cancel:done', []));
  let cur = picked[0]?.id;

  const steps = (s: Subscription) => [
    [`Open ${s.where}`, 'Log in with the same number or email you signed up with.'],
    ['Find “Membership” or “Subscription”', 'Usually under Profile, Account or Settings.'],
    ['Turn off auto-renew', 'You keep access until the end of the period you already paid for.'],
    ['Check your UPI autopay or card mandate', `In your UPI app, open Autopay or Mandates and cancel the one for ${s.label}.`],
    ['Come back and tap “I’ve cancelled it”', 'We’ll watch your next statement to make sure it stopped.'],
  ];

  // Rebuild the picker from what was picked on the results screen
  const picker = root.querySelector<HTMLElement>('[data-picker]')!;
  const template = picker.querySelector<HTMLElement>('[data-pick]')?.cloneNode(true) as HTMLElement | undefined;
  if (template) {
    picker.replaceChildren(
      ...picked.map((s) => {
        const b = template.cloneNode(true) as HTMLElement;
        b.dataset.pick = s.id;
        b.querySelector('.pick__tile')!.textContent = s.label.charAt(0);
        b.querySelector('.pick__label')!.textContent = s.label;
        b.querySelector('.pick__text .muted')!.textContent = `${inr(s.monthly)}/mo · ${inr(s.monthly * 12)}/yr`;
        b.addEventListener('click', () => {
          cur = s.id;
          render();
        });
        return b;
      }),
    );
  }

  function render() {
    root.querySelector<HTMLElement>('[data-how]')!.hidden = picked.length === 0;
    root.querySelector<HTMLElement>('[data-empty]')!.hidden = picked.length > 0;
    root.querySelector('[data-total]')!.textContent = String(picked.length);

    let saved = 0;
    picker.querySelectorAll<HTMLElement>('[data-pick]').forEach((b) => {
      const s = picked.find((p) => p.id === b.dataset.pick)!;
      const isDone = done.has(s.id);
      if (isDone) saved += s.monthly * 12;
      b.setAttribute('aria-pressed', String(s.id === cur));
      b.classList.toggle('pick--done', isDone);
      b.querySelector('[data-status]')!.textContent = isDone ? 'Done' : 'To do';
    });
    root.querySelector('[data-saved]')!.textContent = inr(saved);
    root.querySelector('[data-done-count]')!.textContent = String(picked.filter((p) => done.has(p.id)).length);

    const s = picked.find((p) => p.id === cur);
    if (!s) return;
    root.querySelector('[data-cur-label]')!.textContent = s.label;
    root.querySelector('[data-cur-amt]')!.textContent = inr(s.monthly);
    root.querySelector('[data-cur-why]')!.textContent = s.why;
    const list = root.querySelector('[data-steps]')!;
    list.replaceChildren(
      ...steps(s).map(([title, body], i) => {
        const li = document.createElement('li');
        li.className = 'gstep';
        li.innerHTML = '<span class="num gstep__n" aria-hidden="true"></span><div class="gstep__text"><b></b><span></span></div>';
        li.querySelector('.gstep__n')!.textContent = String(i + 1);
        li.querySelector('b')!.textContent = title;
        li.querySelector('.gstep__text span')!.textContent = body;
        return li;
      }),
    );
    const isDone = done.has(s.id);
    root.querySelector<HTMLElement>('[data-actions-todo]')!.hidden = isDone;
    root.querySelector<HTMLElement>('[data-actions-done]')!.hidden = !isDone;
    root.querySelector('[data-killed]')!.textContent = `${s.label} killed. ${inr(s.monthly * 12)} a year back in your pocket.`;
  }

  root.querySelector('[data-mark-done]')!.addEventListener('click', () => {
    if (!cur) return;
    done.add(cur);
    writeLocal('cancel:done', [...done]);
    render();
    const s = picked.find((p) => p.id === cur)!;
    const killed = picked.filter((p) => done.has(p.id));
    const saved = killed.reduce((sum, p) => sum + p.monthly * 12, 0);
    document.dispatchEvent(
      new CustomEvent('celebrate', {
        detail: {
          title: `${s.label}: killed!`,
          amount: `+${inr(s.monthly * 12)}`,
          line: 'a year, back in your pocket',
          shareHref: `${routes.share}?card=graveyard&saved=${saved}&count=${killed.length}&from=cancel`,
        },
      }),
    );
  });

  root.querySelector('[data-undo]')!.addEventListener('click', () => {
    if (!cur) return;
    done.delete(cur);
    writeLocal('cancel:done', [...done]);
    render();
  });

  root.querySelector('[data-remind]')!.addEventListener('click', () => showToast('We’ll remind you tomorrow at 7 PM.', { kind: 'info' }));

  render();
</script>

<style>
  .muted {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .head {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-weight: 700;
    text-decoration: none;
    color: var(--violet);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 40px;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .guide {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 24px;
    align-items: start;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .picker {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pick {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 20px;
    background: var(--paper-deep);
    border: 2.5px solid var(--ink);
    color: var(--ink);
    text-align: left;
    font-size: 16px;
    cursor: pointer;
  }

  .pick[aria-pressed='true'] {
    background: var(--white);
    border: 3px solid var(--mango);
    box-shadow:
      0 5px 0 var(--ink),
      0 0 0 5px rgba(255, 178, 30, 0.3);
  }

  .pick__tile {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 13px;
    background: var(--danger-bg);
    border: 2px solid var(--ink);
    box-sizing: border-box;
    font-family: var(--font-display);
    font-weight: 800;
  }

  .pick--done .pick__tile {
    background: var(--mint);
  }

  .pick__text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .pick__label {
    font-weight: 800;
  }

  .pick__status {
    flex: none;
    padding: 3px 10px;
    border-radius: 99px;
    background: var(--white);
    font-weight: 800;
  }

  .pick--done .pick__status {
    background: #e2f8ef;
    color: #0a6b4d;
  }

  .saved {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px;
    border-radius: 24px;
    background: var(--ink);
    color: var(--paper);
  }

  .saved__label {
    font-weight: 600;
    color: #cfc8da;
  }

  .saved__amount {
    font-weight: 800;
    font-size: 40px;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--mint);
  }

  .saved__per {
    font-size: 16px;
    letter-spacing: 0;
    color: var(--paper);
  }

  .card {
    padding: 24px;
    border-radius: 28px;
    background: var(--white);
    border: 2.5px solid var(--ink);
    box-shadow: 0 6px 0 var(--ink);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .card[hidden],
  .actions[hidden] {
    display: none;
  }

  .how__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .how__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
  }

  .how__amt {
    font-weight: 800;
    font-size: 18px;
    white-space: nowrap;
  }

  .why {
    margin: 0;
    padding: 12px 14px;
    border-radius: 14px;
    background: var(--danger-bg);
    color: var(--danger);
    font-weight: 700;
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps :global(.gstep) {
    position: relative;
    display: flex;
    gap: 14px;
    padding-bottom: 18px;
  }

  /* Dashed line joining the step numbers */
  .steps :global(.gstep:not(:last-child))::before {
    content: '';
    position: absolute;
    left: 17px;
    top: 40px;
    bottom: 4px;
    border-left: 3px dashed var(--line);
  }

  .steps :global(.gstep__n) {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--mango);
    border: 2.5px solid var(--ink);
    box-sizing: border-box;
    font-weight: 800;
  }

  .steps :global(.gstep__text) {
    padding-top: 6px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .steps :global(.gstep__text span) {
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .killed {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-radius: 16px;
    background: #e2f8ef;
    color: #0a6b4d;
    font-weight: 800;
  }

  @media (max-width: 1023px) {
    .guide {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 639px) {
    .how__title {
      font-size: 22px;
    }

    .actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
