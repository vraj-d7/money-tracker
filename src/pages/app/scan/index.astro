---
// Autopay scan: upload → scanning → results.
// The chosen PDF is read in the browser and never uploaded; with no file, the sample results show.
import AppShell from '../../../layouts/AppShell.astro';
import Handy from '../../../components/Handy.astro';
import StatePanel from '../../../components/StatePanel.astro';
import { routes } from '../../../lib/routes';
import { DEFAULT_CUT, SCAN_STATUS } from '../../../data/demo-tools';

const trust = ['We never ask for your bank password', 'Your PDF never leaves this device', 'Transactions stay on this device too'];
const phases = [
  { id: 'upload', label: '1 · Upload' },
  { id: 'scan', label: '2 · Scanning' },
  { id: 'results', label: '3 · Results' },
];
---

<AppShell title="Autopay scan" active="scan">
  <div class="scan" data-scan data-phase="empty" data-default-cut={JSON.stringify(DEFAULT_CUT)}>
    <header class="head">
      <div class="head__text">
        <span class="eyebrow">Autopay scan</span>
        <h1 data-title>Let’s find your forgotten autopays</h1>
      </div>
      <ol class="phases" aria-label="Scan steps">
        {phases.map((p, i) => <li class="phase" data-phase-pill={p.id} aria-current={i === 0 ? 'step' : undefined}>{p.label}</li>)}
      </ol>
    </header>

    <!-- 0 · Empty: never scanned (or history deleted) -->
    <div class="empty" data-panel="empty">
      <StatePanel mood="chill" as="h2" title="No autopays spotted yet" text="Upload one bank statement and I’ll sniff out anything that quietly renews.">
        <div class="state__actions">
          <button type="button" class="btn btn--mango btn--lg" data-go-upload>Upload a statement</button>
          <a href={routes.help} class="safe-link">Why this is safe</a>
        </div>
      </StatePanel>
    </div>

    <!-- 1 · Upload -->
    <div class="split split--upload" data-panel="upload" hidden>
      <section class="card upload">
        <input type="file" accept="application/pdf,.pdf" id="statement" class="visually-hidden" data-file-input />
        <label for="statement" class="drop" data-drop>
          <span class="drop__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5M12 17v-6M9 14l3-3 3 3"></path></svg>
          </span>
          <span class="drop__title">Drop your bank statement PDF here, or click to choose</span>
          <span class="muted">Last 3 months works best · up to 10 MB</span>
        </label>
        <p class="error" data-file-error hidden></p>
        <div class="file" data-file hidden>
          <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0A6B4D" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10"></path></svg>
          <span class="file__text">
            <span class="file__name" data-file-name></span>
            <span class="num muted" data-file-size></span>
          </span>
          <button type="button" class="file__remove" aria-label="Remove file" data-file-remove>
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
          </button>
        </div>
        <div class="group">
          <label for="pdf-pass" class="group__label">PDF password <span class="muted">(if your bank set one)</span></label>
          <div class="field" data-pass-field>
            <input id="pdf-pass" type="password" autocomplete="off" placeholder="e.g. DDMMYYYY" aria-describedby="pdf-pass-hint" />
            <button type="button" class="field__show" aria-label="Show password" data-show-pass>Show</button>
          </div>
          <div class="alert" id="pdf-pass-err" role="alert" data-pass-error hidden>
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex: none"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 8v5M12 16.5v.5"></path></svg>
            <span><b data-pass-error-title></b> <span data-pass-error-text></span></span>
          </div>
          <p class="muted" id="pdf-pass-hint">Often your date of birth or customer ID. Used once to open the file, never saved.</p>
          <details class="pass-help" data-pass-help>
            <summary>Help me find my password</summary>
            <ul>
              <li>Date of birth as <b>DDMMYYYY</b>, e.g. 07031999</li>
              <li>First 4 letters of your name in capitals + DDMM, e.g. ANIK0703</li>
              <li>Your customer ID or the last digits of your account number</li>
              <li>Still stuck? The email your bank sent the statement with usually says the format.</li>
            </ul>
          </details>
        </div>
      </section>

      <aside class="upload-side">
        <div class="talk" data-talk data-mood="chill">
          <span data-mood-for="chill"><Handy mood="chill" size={96} decorative /></span>
          <span data-mood-for="gasp"><Handy mood="gasp" size={96} decorative /></span>
          <p class="talk__bubble" data-talk-text>Just the PDF. Not your net-banking login. Never.</p>
        </div>
        <ul class="trust">
          {
            trust.map((t) => (
              <li>
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0A6B4D" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z" /><path d="M9 12l2 2 4-4" /></svg>
                {t}
              </li>
            ))
          }
        </ul>
        <section class="looks">
          <h2 class="looks__title">What Handy looks for</h2>
          <p class="muted">Charges that repeat every month, free trials that turned paid, sneaky price hikes and things you stopped using.</p>
        </section>
        <button type="button" class="btn btn--mango btn--lg start" data-start>Scan a sample statement</button>
      </aside>
    </div>

    <!-- 2 · Scanning -->
    <section class="card scanning" aria-label="Scanning" data-panel="scan" hidden>
      <div class="scanning__art">
        <Handy mood="gasp" size={180} decorative />
        <svg class="sweep" aria-hidden="true" viewBox="0 0 80 80" width="120" height="120">
          <circle cx="32" cy="32" r="20" fill="#FFFFFF" fill-opacity="0.35" stroke="#15131C" stroke-width="5"></circle>
          <path d="M24 24 A10 10 0 0 1 34 20" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" fill="none"></path>
          <path d="M47 47 L68 68" stroke="#15131C" stroke-width="9" stroke-linecap="round"></path>
        </svg>
      </div>
      <div class="scanning__text">
        <h2 class="scanning__title">Handy is on the case…</h2>
        <p class="scanning__status" aria-live="polite" data-status>{SCAN_STATUS[0]}</p>
        <div class="prog" role="progressbar" aria-label="Scanning statement"><div class="prog__fill"></div></div>
        <div class="skeleton" aria-hidden="true">
          {
            ['70%', '52%', '64%', '46%'].map((w) => (
              <div class="sk">
                <span class="shimmer sk__icon" />
                <span class="sk__lines">
                  <span class="shimmer sk__line" style={`width: ${w}`} />
                  <span class="shimmer sk__line sk__line--short" />
                </span>
                <span class="shimmer sk__amt" />
              </div>
            ))
          }
        </div>
        <p class="muted lock">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="3"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>
          Your PDF never leaves this device.
        </p>
      </div>
    </section>

    <!-- 3 · Results -->
    <div class="split split--results" data-panel="results" hidden>
      <section class="subs" aria-label="Subscriptions found" data-subs>
        <p class="sample-note" data-sample-note hidden>
          <span class="sample-tag">Sample</span> These are example results. Scan your own statement to see yours.
        </p>
        <p class="none" data-none hidden>
          No repeating charges in this statement. Nice and clean! A statement covering 3 months or more gives Handy the best chance of
          spotting things.
        </p>
        <template id="sub-row">
          <div class="sub" data-sub>
            <div class="sub__info">
              <span class="sub__initial" aria-hidden="true" data-initial></span>
              <span class="sub__text">
                <span class="sub__label" data-label></span>
                <span class="sub__note" data-note></span>
              </span>
              <span class="num sub__amt"><span data-amt></span><span class="sub__per">/mo</span></span>
            </div>
            <div class="sub__choice" role="group">
              <button type="button" class="choice choice--keep" data-keep aria-pressed="true">Keep</button>
              <button type="button" class="choice choice--cut" data-cut aria-pressed="false">Cancel</button>
            </div>
          </div>
        </template>
      </section>
      <aside class="results-side">
        <div class="total">
          <Handy mood="gasp" size={64} decorative />
          <div class="total__text">
            <span class="num total__monthly"><span data-total-monthly></span><span class="total__per">/month</span></span>
            <span class="num total__yearly">That’s <span data-total-yearly></span> a year, on autopilot.</span>
          </div>
        </div>
        <div class="saving">
          <span class="saving__label">Cancelling <span data-cut-count></span> saves you</span>
          <span class="num saving__amount" aria-live="polite"><span data-saved-yearly></span><span class="saving__per"> a year</span></span>
          <a href={routes.cancelGuide} class="btn btn--mango saving__cta" data-guide-link>Show me how to cancel</a>
          <span class="saving__note">We walk you through each one. We can’t cancel on your behalf.</span>
        </div>
        <button type="button" class="btn" data-reset>Scan another statement</button>
      </aside>
    </div>
  </div>
</AppShell>

<script>
  import { inr } from '../../../lib/format';
  import { SCAN_STATUS } from '../../../data/demo-tools';
  import { findAutopays } from '../../../lib/statement';
  import { readLocal, writeLocal } from '../../../scripts/local-state';
  import { readStatement } from '../../../scripts/statement-read';
  import { saveScan, scanResults, useSample } from '../../../scripts/scan-store';

  const root = document.querySelector<HTMLElement>('[data-scan]')!;
  const fileInput = root.querySelector<HTMLInputElement>('[data-file-input]')!;
  const startBtn = root.querySelector<HTMLButtonElement>('[data-start]')!;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const MAX_BYTES = 10 * 1024 * 1024;
  let file: File | null = null;
  let statusTimer = 0;
  let scanTimer = 0;

  let results = scanResults();
  let cut = new Set<string>(readLocal<string[]>('scan:cut', JSON.parse(root.dataset.defaultCut!)));

  function setPhase(phase: 'empty' | 'upload' | 'scan' | 'results') {
    root.dataset.phase = phase;
    root.querySelector<HTMLElement>('.phases')!.hidden = phase === 'empty';
    root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== phase));
    root.querySelectorAll<HTMLElement>('[data-phase-pill]').forEach((p) => {
      if (p.dataset.phasePill === phase) p.setAttribute('aria-current', 'step');
      else p.removeAttribute('aria-current');
    });
    root.querySelector('[data-title]')!.textContent =
      phase === 'results'
        ? `Found ${results.subs.length} ${results.subs.length === 1 ? 'thing' : 'things'} on autopay`
        : 'Let’s find your forgotten autopays';
    window.scrollTo({ top: 0 });
  }

  // File picking (click or drag-and-drop)
  function setFile(f: File | null) {
    const err = root.querySelector<HTMLElement>('[data-file-error]')!;
    err.hidden = true;
    setPassError(null);
    if (f && !(f.type === 'application/pdf' || f.name.toLowerCase().endsWith('.pdf'))) {
      err.textContent = 'That’s not a PDF. Download the statement from your bank as a PDF and try again.';
      err.hidden = false;
      f = null;
    } else if (f && f.size > MAX_BYTES) {
      err.textContent = 'That file is over 10 MB. Try a shorter date range.';
      err.hidden = false;
      f = null;
    }
    file = f;
    root.querySelector<HTMLElement>('[data-file]')!.hidden = !f;
    if (f) {
      root.querySelector('[data-file-name]')!.textContent = f.name;
      root.querySelector('[data-file-size]')!.textContent = `${Math.max(1, Math.round(f.size / 1024))} KB`;
    } else {
      fileInput.value = '';
    }
    startBtn.textContent = f ? 'Scan for subscriptions' : 'Scan a sample statement';
  }

  fileInput.addEventListener('change', () => setFile(fileInput.files?.[0] ?? null));
  root.querySelector('[data-file-remove]')!.addEventListener('click', () => setFile(null));

  const drop = root.querySelector<HTMLElement>('[data-drop]')!;
  drop.addEventListener('dragover', (e) => {
    e.preventDefault();
    drop.classList.add('drop--over');
  });
  drop.addEventListener('dragleave', () => drop.classList.remove('drop--over'));
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    drop.classList.remove('drop--over');
    setFile(e.dataTransfer?.files?.[0] ?? null);
  });

  // Password show/hide
  const pass = root.querySelector<HTMLInputElement>('#pdf-pass')!;
  const showBtn = root.querySelector<HTMLButtonElement>('[data-show-pass]')!;
  showBtn.addEventListener('click', () => {
    const show = pass.type === 'password';
    pass.type = show ? 'text' : 'password';
    showBtn.textContent = show ? 'Hide' : 'Show';
    showBtn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
  });

  // Password problems show on the field, with Handy reacting on the side
  const talk = root.querySelector<HTMLElement>('[data-talk]')!;
  const talkText = talk.querySelector('[data-talk-text]')!;
  const calmLine = talkText.textContent;
  function setPassError(reason: 'needs-password' | 'wrong-password' | null) {
    const box = root.querySelector<HTMLElement>('[data-pass-error]')!;
    box.hidden = !reason;
    root.querySelector('[data-pass-field]')!.classList.toggle('field--error', !!reason);
    pass.setAttribute('aria-invalid', String(!!reason));
    pass.setAttribute('aria-describedby', reason ? 'pdf-pass-err pdf-pass-hint' : 'pdf-pass-hint');
    talk.dataset.mood = reason === 'wrong-password' ? 'gasp' : 'chill';
    talkText.textContent = reason === 'wrong-password' ? 'Arre, that key didn’t fit. Happens to everyone.' : calmLine;
    if (!reason) return;
    box.querySelector('[data-pass-error-title]')!.textContent =
      reason === 'wrong-password' ? 'That password didn’t open your PDF.' : 'This PDF is locked with a password.';
    box.querySelector('[data-pass-error-text]')!.textContent =
      reason === 'wrong-password' ? 'Check the format and try again.' : 'Type the password your bank set, then scan again.';
    root.querySelector<HTMLDetailsElement>('[data-pass-help]')!.open = true;
    pass.focus();
  }
  pass.addEventListener('input', () => {
    if (pass.getAttribute('aria-invalid') === 'true') setPassError(null);
  });

  // Scanning → results. A picked file is read right here in the browser; with no file, the sample results show.
  startBtn.addEventListener('click', async () => {
    let steps = SCAN_STATUS;
    if (file) {
      startBtn.disabled = true;
      startBtn.textContent = 'Reading your statement…';
      const res = await readStatement(file, pass.value).catch(() => ({ ok: false, reason: 'unreadable' }) as const);
      startBtn.disabled = false;
      startBtn.textContent = 'Scan for subscriptions';
      if (!res.ok) {
        if (res.reason === 'needs-password' || res.reason === 'wrong-password') {
          setPassError(res.reason);
        } else {
          const err = root.querySelector<HTMLElement>('[data-file-error]')!;
          err.textContent =
            res.reason === 'no-transactions'
              ? 'We couldn’t find any transactions in this PDF. If it’s a scanned photo of a statement, download the statement from net banking instead.'
              : 'We couldn’t read that PDF. It might be damaged. Download it from your bank again and retry.';
          err.hidden = false;
        }
        return;
      }
      saveScan(findAutopays(res.txns), res.txns);
      steps = [`Read ${res.txns.length} transactions from ${res.pages} ${res.pages === 1 ? 'page' : 'pages'}…`, ...SCAN_STATUS.slice(1)];
    } else {
      useSample();
    }
    results = scanResults();
    cut = new Set(readLocal<string[]>('scan:cut', []));
    pass.value = ''; // never kept around

    setPhase('scan');
    let i = 0;
    const status = root.querySelector('[data-status]')!;
    status.textContent = steps[0];
    window.clearInterval(statusTimer);
    statusTimer = window.setInterval(() => {
      i = (i + 1) % steps.length;
      status.textContent = steps[i];
    }, 1400);
    window.clearTimeout(scanTimer);
    scanTimer = window.setTimeout(
      () => {
        window.clearInterval(statusTimer);
        setPhase('results');
        renderResults();
      },
      reduceMotion ? 1500 : 5600,
    );
  });

  // Results: one row per autopay, each with keep / cancel, and live totals
  const subsBox = root.querySelector<HTMLElement>('[data-subs]')!;
  const rowTemplate = subsBox.querySelector<HTMLTemplateElement>('#sub-row')!;

  function renderResults() {
    subsBox.querySelectorAll('[data-sub]').forEach((r) => r.remove());
    subsBox.querySelector<HTMLElement>('[data-sample-note]')!.hidden = !results.sample;
    subsBox.querySelector<HTMLElement>('[data-none]')!.hidden = results.subs.length > 0;
    for (const s of results.subs) {
      const row = (rowTemplate.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
      row.dataset.sub = s.id;
      row.querySelector('[data-initial]')!.textContent = s.label.charAt(0).toUpperCase();
      row.querySelector('[data-label]')!.textContent = s.label;
      const note = row.querySelector<HTMLElement>('[data-note]')!;
      note.textContent = s.note;
      note.classList.toggle('sub__note--flag', !!s.flag);
      row.querySelector('[data-amt]')!.textContent = inr(s.monthly);
      row.querySelector('.sub__choice')!.setAttribute('aria-label', `Keep or cancel ${s.label}`);
      row.querySelector('[data-keep]')!.addEventListener('click', () => pick(s.id, false));
      row.querySelector('[data-cut]')!.addEventListener('click', () => pick(s.id, true));
      subsBox.append(row);
    }
    renderTotals();
  }

  function pick(id: string, cancel: boolean) {
    if (cancel) cut.add(id);
    else cut.delete(id);
    writeLocal('scan:cut', [...cut]);
    renderTotals();
  }

  function renderTotals() {
    let total = 0;
    let saved = 0;
    for (const s of results.subs) {
      const isCut = cut.has(s.id);
      total += s.monthly;
      if (isCut) saved += s.monthly * 12;
      const row = subsBox.querySelector<HTMLElement>(`[data-sub="${CSS.escape(s.id)}"]`);
      if (!row) continue;
      row.classList.toggle('sub--cut', isCut);
      row.querySelector('[data-keep]')!.setAttribute('aria-pressed', String(!isCut));
      row.querySelector('[data-cut]')!.setAttribute('aria-pressed', String(isCut));
    }
    const picked = results.subs.filter((s) => cut.has(s.id)).length;
    root.querySelector('[data-total-monthly]')!.textContent = inr(total);
    root.querySelector('[data-total-yearly]')!.textContent = inr(total * 12);
    root.querySelector('[data-saved-yearly]')!.textContent = inr(saved);
    root.querySelector('[data-cut-count]')!.textContent = `${picked} ${picked === 1 ? 'thing' : 'things'}`;
    root.querySelector<HTMLElement>('[data-guide-link]')!.toggleAttribute('aria-disabled', picked === 0);
  }

  root.querySelector('[data-reset]')!.addEventListener('click', () => {
    setFile(null);
    setPhase('upload');
  });

  root.querySelector('[data-go-upload]')!.addEventListener('click', () => {
    setPhase('upload');
    fileInput.focus();
  });

  // Scanned before (or coming back from the cancel guide): show the results; otherwise the empty state
  if (readLocal('scan:done', false) || new URLSearchParams(window.location.search).has('results')) {
    setPhase('results');
    renderResults();
  } else {
    setPhase('empty');
  }
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .muted {
    margin: 0;
    font-size: 16px;
    line-height: 1.45;
    color: var(--ink-muted);
    font-weight: 500;
  }

  .scan {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }

  .head__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .eyebrow {
    font-weight: 700;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 40px;
    letter-spacing: -0.03em;
  }

  .phases {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .phase {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 99px;
    background: var(--white);
    border: 2px solid var(--line);
    font-weight: 600;
  }

  .phase[aria-current='step'] {
    background: var(--mango);
    border-color: var(--ink);
    font-weight: 800;
  }

  .card {
    padding: 28px;
    border-radius: 28px;
    background: var(--white);
    border: 2.5px solid var(--ink);
    box-shadow: 0 6px 0 var(--ink);
  }

  .split {
    display: grid;
    gap: 24px;
    align-items: start;
  }

  .split[hidden],
  .scanning[hidden],
  .empty[hidden],
  .phases[hidden] {
    display: none;
  }

  .empty {
    display: flex;
    justify-content: center;
    padding: 48px 0;
  }

  .safe-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    font-weight: 700;
    color: var(--violet);
  }

  .split--upload {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }

  .split--results {
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
  }

  /* Upload */
  .upload {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .drop {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 48px 24px;
    border-radius: 26px;
    background: #fffbf2;
    border: 3px dashed #8a5800;
    text-align: center;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .drop:hover,
  .drop--over {
    background: var(--cream);
  }

  /* The real file input is hidden; show its focus ring on the drop zone */
  #statement:focus-visible + .drop {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .drop__icon {
    display: inline-flex;
