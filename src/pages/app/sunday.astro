---
// Sunday recap: a 4-slide story. Auto-advances every 5 s; tap the right/left side, use ←/→, or the arrow buttons.
import Base from '../../layouts/Base.astro';
import Handy from '../../components/Handy.astro';
import { routes } from '../../lib/routes';
import { inr } from '../../lib/format';
import { WEEK, weekByCategory, weekSpent } from '../../data/demo-week';
import { demoHome } from '../../data/demo-home';
import type { HandyMood } from '../../lib/handy';

const saved = WEEK.plan - weekSpent;
const renewing = demoHome.renewals.items.filter((r) => !r.warn);
const renewingTotal = renewing.reduce((s, r) => s + r.amount, 0);
// The streak slide is filled in by the script from real check-ins
const streak = 1;
const spentPct = Math.round((weekSpent / WEEK.plan) * 100);
const topCats = [...weekByCategory].filter((c) => c.category !== 'Other').sort((a, b) => b.amount - a.amount);

const slides: {
  eyebrow: string;
  title: string;
  big: string;
  body: string;
  bg: string;
  accent: string;
  mood: HandyMood;
  cta: string;
  action: 'next' | 'jar' | 'share';
}[] = [
  { eyebrow: 'This week', title: 'You spent', big: inr(weekSpent), body: `Chill, that’s ${inr(saved)} under your weekly plan.`, bg: '#FFB21E', accent: '#15131C', mood: 'happy', cta: 'Next', action: 'next' },
  { eyebrow: 'Saved', title: 'You kept', big: inr(saved), body: 'Leftover money can go to your Emergency jar. Future you says thanks.', bg: '#FFE7B0', accent: '#0A6B4D', mood: 'cheer', cta: 'Next', action: 'jar' },
  { eyebrow: 'Heads up', title: 'Renewing this week', big: inr(renewingTotal), body: `${renewing.length === 2 ? 'Two' : renewing.length} autopays coming. Still using both?`, bg: '#FFE7B0', accent: '#B3362A', mood: 'gasp', cta: 'Review them', action: 'next' },
  { eyebrow: 'Streak', title: `${streak} Sundays in a row`, big: `${streak} weeks`, body: 'See you next Sunday. Chai pe milte hain.', bg: '#FFB21E', accent: '#15131C', mood: 'chai', cta: 'Share streak', action: 'share' },
];
const moods = [...new Set(slides.map((s) => s.mood))];
---

<Base title="Sunday recap · Inhandy">
  <div
    class="stage"
    data-recap
    data-backgrounds={JSON.stringify(slides.map((s) => s.bg))}
    data-moods={JSON.stringify(slides.map((s) => s.mood))}>
    <a href={routes.home} class="btn stage__close" aria-label="Close recap">
      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </a>

    <button type="button" class="btn arrow" data-prev aria-label="Previous slide">
      <svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"></path></svg>
    </button>

    <div class="story" role="region" aria-roledescription="story" aria-label="Sunday recap. Use the left and right arrow keys to move." tabindex="0" data-story style={`background: ${slides[0].bg}`}>
      <div class="story__blob" aria-hidden="true"></div>

      <div class="story__top">
        <div class="story__progress" role="progressbar" aria-label="Story progress" aria-valuemin="1" aria-valuemax={slides.length} aria-valuenow="1" data-progress>
          {slides.map((_, i) => <span class="seg"><span class="seg__fill" data-seg={i} /></span>)}
        </div>
        <div class="story__who">
          <Handy mood="chai" size={40} decorative />
          <span class="story__who-text">
            <span class="story__who-name">Sunday recap <span class="sample-tag" data-recap-tag>Sample</span></span>
            <span class="story__who-date" data-recap-date>{WEEK.shortRange}</span>
          </span>
        </div>
      </div>

      <button type="button" class="tap tap--prev" data-prev aria-label="Previous slide"></button>
      <button type="button" class="tap tap--next" data-next aria-label="Next slide"></button>

      {
        slides.map((s, i) => (
          <div class="slide" data-slide={i} hidden={i !== 0} aria-live="polite">
            <p class="slide__eyebrow"><span data-s-eyebrow>{s.eyebrow}</span></p>
            <h1 class="slide__title" data-s-title>{s.title}</h1>
            <p class="num slide__big" style={`color: ${s.accent}`} data-s-big>
              {s.big}
            </p>
            <p class="slide__body" data-s-body>{s.body}</p>

            {i === 0 && (
              <div class="panel">
                <div class="panel__row">
                  <span>Spent</span>
                  <span class="num" data-panel-text>
                    {spentPct}% of {inr(WEEK.plan)} plan
                  </span>
                </div>
                <div class="panel__bar">
                  <div style={`width: ${spentPct}%`} data-panel-bar />
                </div>
                <div class="panel__chips">
                  {topCats.map((c) => (
                    <span class="num pill" data-chip={c.category}>
                      {c.category} {inr(c.amount)}
                    </span>
                  ))}
                </div>
              </div>
            )}
            {i === 2 && (
              <div class="renewals" data-renewals>
                <template id="recap-renewal">
                  <div class="renewal" data-renewal>
                    <span data-r-label />
                    <span class="num" data-r-amt />
                  </div>
                </template>
                {renewing.map((r) => (
                  <div class="renewal" data-renewal>
                    <span>{r.label}</span>
                    <span class="num">
                      {r.note.match(/(Mon|Tue|Wed|Thu|Fri|Sat|Sun)/)?.[0]} · {inr(r.amount)}
                    </span>
                  </div>
                ))}
              </div>
            )}
            {i === 3 && (
              <div class="flames" aria-hidden="true">
                {Array.from({ length: 7 }, (_, k) => (
                  <svg class:list={{ flick: k === streak - 1, dim: k >= streak }} width="38" height="46" viewBox="0 0 24 28">
                    <path d="M12 27c5 0 8.5-3.5 8.5-8.5 0-6-6-8.5-6-14.5-3.5 2.4-6 6-6 9.6-1.2-1.2-2.4-2.4-2.4-4.8-2.4 2.4-2.6 6-2.6 9.7C3.5 23.5 7 27 12 27z" fill="#FFB21E" stroke="#15131C" stroke-width="1.6" stroke-linejoin="round" />
                    <path d="M12 25c2.5 0 4.2-1.8 4.2-4.2 0-3-3-4.4-3-7.4-2 1.4-4.5 3.8-4.5 7 0 2.8 1.2 4.6 3.3 4.6z" fill="#FFD27A" />
                  </svg>
                ))}
              </div>
            )}
          </div>
        ))
      }

      <div class="story__foot">
        <div class="story__handy" data-handy={slides[0].mood}>
          {
            moods.map((m) => (
              <span data-mood={m}>
                <Handy mood={m} size={110} decorative />
              </span>
            ))
          }
        </div>
        {
          slides.map((s, i) =>
            s.action === 'share' ? (
              <a href={`${routes.share}?card=streak&weeks=${streak}`} class="btn btn--ink cta" data-cta={i} hidden={i !== 0}>
                {s.cta}
              </a>
            ) : (
              <button type="button" class="btn btn--ink cta" data-cta={i} data-action={s.action} hidden={i !== 0}>
                {s.cta}
              </button>
            ),
          )
        }
      </div>
    </div>

    <button type="button" class="btn arrow" data-next aria-label="Next slide">
      <svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg>
    </button>

    <p class="hint">Use ← and → to move between slides</p>
  </div>

  <div id="toast-region" class="toast-region" aria-live="polite"></div>
</Base>

<script>
  import { inr } from '../../lib/format';
  import { checkinStreak, weekKey } from '../../lib/streaks';
  import { routes } from '../../lib/routes';
  import { readLocal, writeLocal } from '../../scripts/local-state';
  import { loadPlan, savePlan } from '../../scripts/plan-store';
  import { loadProfile, monthlyInhand } from '../../scripts/profile-store';
  import { realRenewals, realWeek } from '../../scripts/scan-store';
  import { showToast } from '../../scripts/toast';

  const root = document.querySelector<HTMLElement>('[data-recap]')!;
  const backgrounds = JSON.parse(root.dataset.backgrounds!) as string[];
  const moodsBySlide = JSON.parse(root.dataset.moods!) as string[];
  const story = root.querySelector<HTMLElement>('[data-story]')!;
  const count = backgrounds.length;

  const slide = (i: number) => root.querySelector<HTMLElement>(`[data-slide="${i}"]`)!;
  const fill = (i: number, key: 'eyebrow' | 'title' | 'big' | 'body', text: string) => {
    slide(i).querySelector(`[data-s-${key}]`)!.textContent = text;
  };

  // Finishing this recap counts as this week's check-in, so the streak slide includes it
  const checkins = readLocal<string[]>('checkins', []);
  const thisWeek = weekKey(new Date());
  const streakNow = checkinStreak([...checkins, thisWeek]);
  fill(3, 'title', streakNow === 1 ? 'Your first Sunday' : `${streakNow} Sundays in a row`);
  fill(3, 'big', streakNow === 1 ? '1 week' : `${streakNow} weeks`);
  slide(3).querySelectorAll('.flames svg').forEach((flame, i) => {
    flame.classList.toggle('flick', i === Math.min(streakNow, 7) - 1);
    flame.classList.toggle('dim', i >= streakNow);
  });
  root.querySelector<HTMLAnchorElement>('[data-cta="3"]')!.href = `${routes.share}?card=streak&weeks=${streakNow}`;

  // The user's own week, once a statement has been scanned on this device
  const week = realWeek();
  let leftover = 0;
  if (week) {
    leftover = Math.max(0, week.plan - week.spent);
    const pct = week.plan ? Math.round((week.spent / week.plan) * 100) : 0;
    root.querySelector('[data-recap-date]')!.textContent = week.shortRange;
    root.querySelector<HTMLElement>('[data-recap-tag]')!.hidden = true;

    fill(0, 'eyebrow', week.title);
    fill(0, 'big', inr(week.spent));
    fill(0, 'body', week.spent <= week.plan
      ? `Chill, that’s ${inr(week.plan - week.spent)} under your weekly plan.`
      : `That’s ${inr(week.spent - week.plan)} over your weekly plan. Next week’s a fresh start.`);
    slide(0).querySelector('[data-panel-text]')!.textContent = `${pct}% of ${inr(week.plan)} plan`;
    slide(0).querySelector<HTMLElement>('[data-panel-bar]')!.style.width = `${Math.min(100, pct)}%`;
    for (const c of week.byCategory) {
      const chip = slide(0).querySelector(`[data-chip="${c.category}"]`);
      if (chip) chip.textContent = `${c.category} ${inr(c.amount)}`;
    }

    fill(1, 'big', inr(leftover));
    if (leftover > 0) {
      fill(1, 'body', 'Move it to your Emergency jar? Future you says thanks.');
    } else {
      fill(1, 'title', 'Nothing left over');
      fill(1, 'body', 'No stress. Check Salary-day plan if this keeps happening.');
    }
    // One move per week, even if the recap is opened again
    if (readLocal('sunday:moved', '') === week.range) leftover = 0;
    else if (leftover > 0) root.querySelector('[data-cta="1"]')!.textContent = 'Move to jar';
  }

  // Autopays due in the next 7 days, from a real scan
  const renewals = realRenewals();
  if (renewals) {
    const soon = renewals.items.filter((r) => r.daysLeft <= 7);
    const box = slide(2).querySelector<HTMLElement>('[data-renewals]')!;
    const tpl = box.querySelector<HTMLTemplateElement>('#recap-renewal')!;
    box.querySelectorAll('[data-renewal]').forEach((r) => r.remove());
    for (const r of soon) {
      const el = (tpl.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
      el.querySelector('[data-r-label]')!.textContent = r.label;
      el.querySelector('[data-r-amt]')!.textContent = `${r.short} · ${inr(r.amount)}`;
      box.append(el);
    }
    fill(2, 'big', inr(soon.reduce((s, r) => s + r.amount, 0)));
    fill(2, 'body', soon.length === 0
      ? 'Nothing due in the next 7 days. Enjoy the quiet.'
      : soon.length === 1 ? 'One autopay coming. Still using it?' : `${soon.length} autopays coming. Still using them?`);
  }
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let idx = 0;
  let timer = 0;

  function go(next: number) {
    idx = Math.max(0, Math.min(count - 1, next));
    story.style.background = backgrounds[idx];
    root.querySelectorAll<HTMLElement>('[data-slide]').forEach((s) => {
      const on = Number(s.dataset.slide) === idx;
      s.hidden = !on;
      if (on && !reduceMotion) {
        s.classList.remove('slide-in');
        void s.offsetWidth;
        s.classList.add('slide-in');
      }
    });
    root.querySelectorAll<HTMLElement>('[data-cta]').forEach((c) => (c.hidden = Number(c.dataset.cta) !== idx));
    root.querySelector<HTMLElement>('.story__handy')!.dataset.handy = moodsBySlide[idx];
    root.querySelector('[data-progress]')!.setAttribute('aria-valuenow', String(idx + 1));
    if (idx === count - 1 && !checkins.includes(thisWeek)) {
      checkins.push(thisWeek);
      writeLocal('checkins', checkins);
    }
    root.querySelectorAll<HTMLElement>('[data-seg]').forEach((seg) => {
      const i = Number(seg.dataset.seg);
      seg.classList.remove('seg__fill--run');
      seg.style.width = i < idx ? '100%' : '0%';
      if (i === idx && !reduceMotion && idx < count - 1) {
        void seg.offsetWidth;
        seg.classList.add('seg__fill--run');
      } else if (i === idx) {
        seg.style.width = '100%';
      }
    });
    root.querySelectorAll<HTMLButtonElement>('.arrow[data-prev]').forEach((b) => (b.disabled = idx === 0));
    root.querySelectorAll<HTMLButtonElement>('.arrow[data-next]').forEach((b) => (b.disabled = idx === count - 1));

    // Auto-advance, except on the last slide or with reduced motion
    window.clearTimeout(timer);
    if (!reduceMotion && idx < count - 1) timer = window.setTimeout(() => go(idx + 1), 5000);
  }

  root.querySelectorAll('[data-prev]').forEach((b) => b.addEventListener('click', () => go(idx - 1)));
  root.querySelectorAll('[data-next]').forEach((b) => b.addEventListener('click', () => go(idx + 1)));

  story.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') go(idx + 1);
    else if (e.key === 'ArrowLeft') go(idx - 1);
  });
  document.addEventListener('keydown', (e) => {
    if (e.target === story) return;
    if (e.key === 'ArrowRight') go(idx + 1);
    else if (e.key === 'ArrowLeft') go(idx - 1);
    else if (e.key === 'Escape') window.location.href = root.querySelector<HTMLAnchorElement>('.stage__close')!.href;
  });

  root.querySelectorAll<HTMLButtonElement>('button[data-action]').forEach((b) =>
    b.addEventListener('click', () => {
      if (b.dataset.action === 'jar' && week && leftover > 0) {
        // Put this week's real leftover into the Emergency fund goal, starting one if needed
        const plan = loadPlan();
        let emergency = plan.goals.find((g) => g.id === 'emer');
        if (!emergency) {
          emergency = { id: 'emer', label: 'Emergency fund', sub: '3 months of take-home pay', icon: 'shield', target: monthlyInhand(loadProfile()) * 3, saved: 0 };
          plan.goals.push(emergency);
        }
        emergency.saved = Math.min(emergency.target, emergency.saved + leftover);
        savePlan(plan);
        writeLocal('sunday:moved', week.range);
        showToast(`${inr(leftover)} moved to your Emergency fund`);
        leftover = 0;
        b.textContent = 'Next';
      }
      go(idx + 1);
    }),
  );

  go(0);
  story.focus({ preventScroll: true });
</script>

<style>
  .stage {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
    padding: 32px 24px 72px;
    background: rgba(21, 19, 28, 0.92);
  }

  .stage__close {
    position: absolute;
    top: 32px;
    right: 40px;
    z-index: 10;
    width: 52px;
    height: 52px;
    padding: 0;
    box-shadow: 0 5px 0 #000;
  }

  .arrow {
    flex: none;
    width: 64px;
    height: 64px;
    padding: 0;
    border-radius: 50%;
    box-shadow: 0 5px 0 #000;
  }

  .arrow:disabled {
    opacity: 0.4;
    cursor: default;
    transform: none;
  }

  .story {
    position: relative;
    width: 440px;
    height: 800px;
    max-height: calc(100dvh - 104px);
    flex: none;
    overflow: hidden;
    box-sizing: border-box;
    border-radius: 36px;
    border: 3px solid var(--ink);
    box-shadow: 0 10px 0 #000;
    color: var(--ink);
    transition: background 0.35s;
  }

  .story:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
  }

  .story__blob {
    position: absolute;
    right: -120px;
    top: 120px;
    width: 380px;
    height: 380px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
  }

  .story__top {
    position: relative;
    z-index: 3;
    padding: 16px 16px 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .story__progress {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 5px;
  }

  .seg {
    height: 6px;
    border-radius: 99px;
    background: rgba(21, 19, 28, 0.18);
    overflow: hidden;
  }

  .seg__fill {
    display: block;
    height: 100%;
    width: 0;
    background: var(--ink);
  }

  .seg__fill--run {
    animation: fill 5s linear forwards;
  }

  @keyframes fill {
    from {
      width: 0;
    }
    to {
      width: 100%;
    }
  }

  .story__who {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .story__who-text {
    display: flex;
    flex-direction: column;
  }

  .story__who-name {
    font-weight: 800;
  }

  .story__who-date {
    font-weight: 600;
    opacity: 0.8;
  }

  .tap {
    position: absolute;
    z-index: 2;
    top: 120px;
    height: calc(100% - 280px);
    background: transparent;
    border: none;
  }

  .tap--prev {
    left: 0;
    width: 30%;
    cursor: w-resize;
  }

  .tap--next {
    right: 0;
    width: 70%;
    cursor: e-resize;
  }

  .slide {
    position: relative;
    z-index: 1;
    padding: 40px 28px 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
    pointer-events: none;
  }

  .slide[hidden] {
    display: none;
  }

  .slide-in {
    animation: slide-in 0.4s cubic-bezier(0.3, 1.4, 0.5, 1);
  }

  @keyframes slide-in {
    0% {
      opacity: 0;
      transform: scale(0.96);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }

  .slide__eyebrow {
    margin: 0;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .slide__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 46px;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .slide__big {
    margin: 0;
    font-weight: 800;
    font-size: 84px;
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .slide__body {
    margin: 0;
    max-width: 320px;
    font-size: 18px;
    line-height: 1.45;
    font-weight: 500;
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.6);
    border: 2.5px solid var(--ink);
  }

  .panel__row {
    display: flex;
    justify-content: space-between;
    font-weight: 700;
  }

  .panel__bar {
    height: 16px;
    border-radius: 99px;
    background: rgba(21, 19, 28, 0.18);
    border: 2px solid var(--ink);
    overflow: hidden;
  }

  .panel__bar div {
    height: 100%;
    background: var(--mint);
  }

  .panel__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }

  .pill {
    padding: 4px 10px;
    border-radius: 99px;
    background: var(--white);
    border: 2px solid var(--ink);
    font-weight: 800;
  }

  .renewals {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .renewal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.6);
    border: 2.5px solid var(--ink);
    font-weight: 800;
  }

  .flames {
    display: flex;
    gap: 8px;
  }

  .flames .dim {
    opacity: 0.3;
  }

  .flick {
    animation: flick 1.6s ease-in-out infinite;
    transform-origin: 50% 90%;
  }

  @keyframes flick {
    0%,
    100% {
      transform: scale(1) rotate(-3deg);
    }
    50% {
      transform: scale(1.1) rotate(3deg);
    }
  }

  .story__foot {
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0 20px 28px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
  }

  .story__handy {
    line-height: 0;
  }

  .story__handy > span {
    display: none;
  }

  .story__handy[data-handy='happy'] > [data-mood='happy'],
  .story__handy[data-handy='cheer'] > [data-mood='cheer'],
  .story__handy[data-handy='gasp'] > [data-mood='gasp'],
  .story__handy[data-handy='chai'] > [data-mood='chai'] {
    display: block;
  }

  .cta {
    min-height: 56px;
    padding: 12px 22px;
    border-width: 3px;
    border-radius: 18px;
    font-weight: 800;
  }

  .cta[hidden] {
    display: none;
  }

  .hint {
    position: absolute;
    bottom: 28px;
    left: 0;
    right: 0;
    margin: 0;
    text-align: center;
    font-weight: 600;
    color: var(--paper);
  }

  /* Phone: the story fills the screen; tap left/right to move */
