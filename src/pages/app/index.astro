---
import AppShell from '../../layouts/AppShell.astro';
import Handy from '../../components/Handy.astro';
import { demoHome as home } from '../../data/demo-home';
import { routes } from '../../lib/routes';
import { inr } from '../../lib/format';
import { DEFAULT_PROFILE, longDate, monthlyInhand, paydayCycle, shortDate } from '../../scripts/profile-store';

// Rendered with the default profile at build time; the script below swaps in the saved profile and today's date
const cycle = paydayCycle(DEFAULT_PROFILE);
const expected = monthlyInhand(DEFAULT_PROFILE);
const today = new Date();

const RING = 314.16; // circumference of the r=50 payday ring
const progress = (cycle.cycleDays - cycle.daysLeft) / cycle.cycleDays;
const ringOffset = (RING * (1 - progress)).toFixed(1);

const { spent, plan } = home.week;
const spentPct = Math.min(100, (spent / plan) * 100).toFixed(1);
const underBy = plan - spent;

---

<AppShell title="Home" active="home">
  <header class="head">
    <div class="head__who">
      <span class="head__avatar" aria-hidden="true" data-initials></span>
      <div class="head__text">
        <span class="head__date head__date--long" data-today-long>{longDate(today)}</span>
        <span class="head__date head__date--short" data-today-short>{shortDate(today)}</span>
        <h1>Hey <span data-first-name>there</span></h1>
      </div>
    </div>
    <div class="head__actions">
      <a href={routes.scan} class="btn head__scan">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V3M7 8l5-5 5 5M4 14v5a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-5"></path></svg>
        Scan a statement
      </a>
      <a href={routes.notifications} class="icon-btn" aria-label="Notifications" data-bell>
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"></path></svg>
        <span class="icon-btn__dot" aria-hidden="true" data-bell-dot hidden></span>
      </a>
    </div>
  </header>

  <form class="name-ask" data-name-ask hidden novalidate>
    <label for="ask-name" class="name-ask__label">What should we call you?</label>
    <div class="name-ask__row">
      <div class="field name-ask__field">
        <input id="ask-name" type="text" placeholder="Your first name" autocomplete="given-name" maxlength="40" aria-describedby="ask-name-err" />
      </div>
      <button type="submit" class="btn btn--mango">Save</button>
    </div>
    <p class="name-ask__err" id="ask-name-err" role="alert" data-name-err hidden>Type your first name first.</p>
  </form>

  <section class="pay-ask" aria-labelledby="pay-ask-h" data-pay-ask hidden>
    <div class="pay-ask__text">
      <h2 id="pay-ask-h" class="pay-ask__title">Add your pay to make this yours</h2>
      <p class="pay-ask__body"><b class="num" data-pay-ask-amount></b> is only an example so far. Your plan, jars and coach all work from this number.</p>
    </div>
    <div class="pay-ask__actions">
      <a href={routes.salaryDetails} class="btn btn--mango">Add my pay</a>
      <button type="button" class="btn" data-pay-ask-ok>That’s about right</button>
    </div>
  </section>

  <section class="card payday" aria-label="Days to payday">
    <div class="payday__ring">
      <svg viewBox="0 0 120 120" aria-hidden="true">
        <circle cx="60" cy="60" r="50" fill="none" stroke="#15131C" stroke-opacity="0.14" stroke-width="12"></circle>
        <circle
          class="ring"
          cx="60"
          cy="60"
          r="50"
          fill="none"
          stroke="#15131C"
          stroke-width="12"
          stroke-linecap="round"
          stroke-dasharray={RING}
          stroke-dashoffset={ringOffset}
          data-ring-to={ringOffset}
          data-ring-from={RING}></circle>
      </svg>
      <div class="payday__count">
        <span class="num payday__days" data-count-from={cycle.cycleDays} data-count-to={cycle.daysLeft} data-payday-days>
          {cycle.daysLeft}
        </span>
        <span class="payday__unit" data-payday-unit>{cycle.daysLeft === 1 ? 'day' : 'days'}</span>
      </div>
    </div>
    <div class="payday__body">
      <p class="eyebrow">To payday</p>
      <h2 class="payday__title" data-payday-title>Salary aa rahi hai!</h2>
      <p class="num payday__meta"><span data-payday-date>{shortDate(cycle.next)}</span> · <b data-payday-expected>{inr(expected)}</b> expected <a href={routes.salaryDetails} class="payday__change">Not right? Change</a></p>
      <a href={routes.plan} class="btn btn--ink payday__cta">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2ED3A0" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10"></path></svg>
        See salary-day plan
      </a>
    </div>
    <span class="payday__handy payday__handy--big"><Handy mood="cheer" size={120} decorative /></span>
    <span class="payday__handy payday__handy--small"><Handy mood="happy" size={58} decorative /></span>
  </section>

  <section class="card week" aria-labelledby="week-h">
    <div class="card__top">
      <h2 id="week-h" class="card__title"><span data-week-title>This week</span> <span class="sample-tag" data-week-tag>Sample</span></h2>
      <span class="card__links">
        <a href={routes.addSpend} class="link">Add a spend</a>
        <a href={routes.week} class="link">Details</a>
      </span>
    </div>
    <p class="num week__total">
      <span class="week__spent" data-count-from="0" data-count-to={spent} data-format="inr">{inr(spent)}</span> of <span data-week-plan>{inr(plan)}</span> plan
    </p>
    <div class="bar" role="img" aria-label={`Spent ${inr(spent)} of a ${inr(plan)} plan`} data-week-bar>
      <div class="bar__fill" style={`width: ${spentPct}%`} data-week-fill></div>
    </div>
    <div class="week__cats">
      {
        home.week.categories.map((c) => (
          <div class="cat">
            <span class="cat__label">{c.label}</span>
            <span class="num cat__amt" data-cat-amt={c.label}>{inr(c.amount)}</span>
          </div>
        ))
      }
    </div>
    <p class:list={['note', underBy >= 0 ? 'note--good' : 'note--bad']} data-week-note>
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" data-week-tick><path d="M5 12l4 4 10-10"></path></svg>
      <span data-week-note-text>{inr(Math.abs(underBy))} under plan. Chill, you’re on track.</span>
    </p>
    <p class="sample-note" data-week-sample>Sample spends. <a href={routes.scan}>Scan a statement</a> to see yours.</p>
    <p class="sample-note" data-scan-due hidden>Salary’s in. <a href={routes.scan}>Scan your latest statement</a> to update your spends.</p>
  </section>

  <section class="card renewals" aria-labelledby="renew-h">
    <h2 id="renew-h" class="card__title">Upcoming renewals <span class="sample-tag" data-renew-tag>Sample</span></h2>
    <span class="num renewals__total" data-renew-total>{inr(home.renewals.monthTotal)} this month</span>
    <p class="sample-note" data-renew-none hidden>Nothing renewing that we can see. Nice.</p>
    <template id="renewal-row">
      <div class="renewal" data-renew-row>
        <span class="renewal__icon" aria-hidden="true" data-renew-initial></span>
        <div class="renewal__text">
          <span class="renewal__label" data-renew-label></span>
          <span class="renewal__note" data-renew-note></span>
        </div>
        <span class="num renewal__amt" data-renew-amt></span>
      </div>
    </template>
    {
      home.renewals.items.map((r) => (
        <div class="renewal" data-renew-row>
          <span class:list={['renewal__icon', { 'renewal__icon--warn': r.warn }]} aria-hidden="true">
            {r.icon === 'tv' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="12" rx="3" /><path d="M8 21h8M10 10.5v3l3-1.5z" /></svg>
            )}
            {r.icon === 'music' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l11-2v13" /><circle cx="6.5" cy="18" r="2.5" /><circle cx="17.5" cy="16" r="2.5" /></svg>
            )}
            {r.icon === 'gym' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8v8M18 8v8M3 10v4M21 10v4M6 12h12" /></svg>
            )}
          </span>
          <div class="renewal__text">
            <span class="renewal__label">{r.label}</span>
            <span class:list={['renewal__note', { 'renewal__note--warn': r.warn }]}>{r.note}</span>
          </div>
          <span class="num renewal__amt">{inr(r.amount)}</span>
        </div>
      ))
    }
  </section>

  <section class="card streak" aria-label="Check-in streak">
    <svg class="flick" aria-hidden="true" width="52" height="60" viewBox="0 0 24 28"><path d="M12 27c5 0 8.5-3.5 8.5-8.5 0-6-6-8.5-6-14.5-3.5 2.4-6 6-6 9.6-1.2-1.2-2.4-2.4-2.4-4.8-2.4 2.4-2.6 6-2.6 9.7C3.5 23.5 7 27 12 27z" fill="#FFB21E" stroke="#15131C" stroke-width="1.6" stroke-linejoin="round"></path><path d="M12 25c2.5 0 4.2-1.8 4.2-4.2 0-3-3-4.4-3-7.4-2 1.4-4.5 3.8-4.5 7 0 2.8 1.2 4.6 3.3 4.6z" fill="#FFD27A"></path></svg>
    <div class="streak__body">
      <p class="streak__title" data-streak-title>Start your check-in streak</p>
      <div class="streak__weeks" role="img" aria-label="Check-ins over the last 7 weeks" data-streak-weeks>
        {Array.from({ length: 7 }, () => <span class="streak__week" />)}
      </div>
      <p class="streak__next" data-streak-next>Your first check-in: the Sunday recap.</p>
    </div>
  </section>

  <section class="card ask" aria-labelledby="ask-h">
    <div class="ask__top">
      <span class="ask__handy"><Handy mood="chai" size={48} decorative /></span>
      <h2 id="ask-h" class="card__title">Ask your coach</h2>
    </div>
    <form class="ask__field" action={routes.coach} method="get">
      <label for="ask-input" class="visually-hidden">Ask your coach a question</label>
      <input id="ask-input" name="q" type="text" placeholder="Can I afford this?" autocomplete="off" />
      <button type="submit" class="btn ask__send" aria-label="Send question">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </button>
    </form>
    <div class="ask__chips">
      {
        home.coachPrompts.map((p) => (
          <button type="button" class="chip" data-prompt={p}>
            {p}
          </button>
        ))
      }
    </div>
  </section>
</AppShell>

<script>
  import { inr } from '../../lib/format';
  import { displayName, initials, loadProfile, longDate, monthlyInhand, paydayCycle, saveProfile, shortDate } from '../../scripts/profile-store';
  import { checkinStreak, recentWeeks, weekKey } from '../../lib/streaks';
  import { readLocal } from '../../scripts/local-state';
  import { unreadCount } from '../../scripts/notifications';
  import { realRenewals, realWeek, scanReminder } from '../../scripts/scan-store';

  // Greet whoever is saved in the profile, on today's date
  const profile = loadProfile();
  const today = new Date();
  document.querySelector('[data-first-name]')!.textContent = profile.name || 'there';
  document.querySelector('[data-initials]')!.textContent = initials(profile);

  // No name yet (an older account, or onboarding was skipped): ask once, right here
  const nameAsk = document.querySelector<HTMLFormElement>('[data-name-ask]')!;
  nameAsk.hidden = !!profile.name;
  nameAsk.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = nameAsk.querySelector<HTMLInputElement>('#ask-name')!;
    const name = input.value.trim();
    nameAsk.querySelector<HTMLElement>('[data-name-err]')!.hidden = !!name;
    input.setAttribute('aria-invalid', String(!name));
    if (!name) {
      input.focus();
      return;
    }
    saveProfile({ name });
    const saved = loadProfile();
    document.querySelector('[data-first-name]')!.textContent = saved.name;
    document.querySelector('[data-initials]')!.textContent = initials(saved);
    document.querySelectorAll('[data-nav-name]').forEach((el) => (el.textContent = displayName(saved)));
    document.querySelectorAll('[data-nav-initials]').forEach((el) => (el.textContent = initials(saved)));
    nameAsk.hidden = true;
  });

  // Pay not given yet (onboarding skipped): say the amounts are an example, and ask
  const payAsk = document.querySelector<HTMLElement>('[data-pay-ask]')!;
  payAsk.hidden = profile.payConfirmed;
  payAsk.querySelector('[data-pay-ask-amount]')!.textContent = `${inr(monthlyInhand(profile))} a month`;
  payAsk.querySelector('[data-pay-ask-ok]')!.addEventListener('click', () => {
    saveProfile({ payConfirmed: true });
    payAsk.hidden = true;
  });

  document.querySelector('[data-today-long]')!.textContent = longDate(today);
  document.querySelector('[data-today-short]')!.textContent = shortDate(today);

  // Payday countdown from the saved salary day and CTC (set before the count-up below reads it)
  const cycle = paydayCycle(profile, today);
  const days = document.querySelector<HTMLElement>('[data-payday-days]')!;
  days.dataset.countFrom = String(cycle.cycleDays);
  days.dataset.countTo = String(cycle.daysLeft);
  days.textContent = String(cycle.daysLeft);
  document.querySelector('[data-payday-unit]')!.textContent = cycle.daysLeft === 1 ? 'day' : 'days';
  document.querySelector('[data-payday-date]')!.textContent = cycle.daysLeft === 0 ? 'Today' : shortDate(cycle.next);
  document.querySelector('[data-payday-expected]')!.textContent = inr(monthlyInhand(profile));
  if (cycle.daysLeft === 0) document.querySelector('[data-payday-title]')!.textContent = 'Salary aa gayi! 🎉';
  const ring = document.querySelector<SVGCircleElement>('[data-ring-to]')!;
  const ringTo = (314.16 * (cycle.daysLeft / cycle.cycleDays)).toFixed(1);
  ring.dataset.ringTo = ringTo;
  ring.setAttribute('stroke-dashoffset', ringTo);

  // Spends from the user's own statement, once one has been scanned on this device
  const week = realWeek();
  if (week) {
    const under = week.plan - week.spent;
    const spentEl = document.querySelector<HTMLElement>('.week__spent')!;
    spentEl.dataset.countTo = String(week.spent);
    spentEl.textContent = inr(week.spent);
    document.querySelector('[data-week-title]')!.textContent = week.title;
    document.querySelector<HTMLElement>('[data-week-tag]')!.hidden = true;
    document.querySelector<HTMLElement>('[data-week-sample]')!.hidden = true;
    document.querySelector<HTMLElement>('[data-scan-due]')!.hidden = !scanReminder();
    document.querySelector('[data-week-plan]')!.textContent = inr(week.plan);
    document.querySelector('[data-week-bar]')!.setAttribute('aria-label', `Spent ${inr(week.spent)} of a ${inr(week.plan)} plan`);
    document.querySelector<HTMLElement>('[data-week-fill]')!.style.width = `${Math.min(100, week.plan ? (week.spent / week.plan) * 100 : 100).toFixed(1)}%`;
    for (const c of week.byCategory) document.querySelector(`[data-cat-amt="${c.category}"]`)!.textContent = inr(c.amount);
    const note = document.querySelector<HTMLElement>('[data-week-note]')!;
    note.classList.toggle('note--good', under >= 0);
    note.classList.toggle('note--bad', under < 0);
    document.querySelector<SVGElement>('[data-week-tick]')!.style.display = under >= 0 ? '' : 'none';
    document.querySelector('[data-week-note-text]')!.textContent =
      under >= 0 ? `${inr(under)} under plan. Chill, you’re on track.` : `${inr(-under)} over plan this week.`;
  }

  // Renewals from a real scan: the next three, soonest first
  const renewals = realRenewals();
  if (renewals) {
    const box = document.querySelector<HTMLElement>('.renewals')!;
    const row = box.querySelector<HTMLTemplateElement>('#renewal-row')!;
    box.querySelectorAll('[data-renew-row]').forEach((r) => r.remove());
    box.querySelector<HTMLElement>('[data-renew-tag]')!.hidden = true;
    box.querySelector('[data-renew-total]')!.textContent = `${inr(renewals.monthTotal)} a month`;
    box.querySelector<HTMLElement>('[data-renew-none]')!.hidden = renewals.items.length > 0;
    for (const r of renewals.items.slice(0, 3)) {
      const el = (row.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
      const icon = el.querySelector('[data-renew-initial]')!;
      icon.textContent = r.label.charAt(0).toUpperCase();
      icon.classList.toggle('renewal__icon--warn', r.flag);
      el.querySelector('[data-renew-label]')!.textContent = r.label;
      const noteEl = el.querySelector('[data-renew-note]')!;
      noteEl.textContent = r.note;
      noteEl.classList.toggle('renewal__note--warn', r.flag);
      el.querySelector('[data-renew-amt]')!.textContent = inr(r.amount);
      box.append(el);
    }
  }

  // The real check-in streak, from Sunday recaps the user has finished
  const checkins = readLocal<string[]>('checkins', []);
  const streak = checkinStreak(checkins);
  const doneThisWeek = checkins.includes(weekKey(new Date()));
  document.querySelector('[data-streak-title]')!.textContent = streak ? `${streak}-week check-in streak` : 'Start your check-in streak';
  document.querySelector('[data-streak-next]')!.textContent = streak
    ? doneThisWeek ? 'Done for this week. See you Sunday!' : 'Next check-in: Sunday. Don’t break it now!'
    : 'Your first check-in: the Sunday recap.';
  const dots = document.querySelectorAll<HTMLElement>('.streak__week');
  recentWeeks(checkins).forEach((done, i) => dots[i].classList.toggle('streak__week--done', done));
  document.querySelector('[data-streak-weeks]')!.setAttribute('aria-label', `${recentWeeks(checkins).filter(Boolean).length} check-ins in the last 7 weeks`);

  const unread = unreadCount(readLocal<string[]>('notifications:read', []));
  document.querySelector<HTMLElement>('[data-bell-dot]')!.hidden = unread === 0;
  document.querySelector('[data-bell]')!.setAttribute('aria-label', unread ? `Notifications, ${unread} new` : 'Notifications');

  // Chips fill the question box
  const input = document.getElementById('ask-input') as HTMLInputElement | null;
  document.querySelectorAll<HTMLButtonElement>('.chip[data-prompt]').forEach((chip) => {
    chip.addEventListener('click', () => {
      if (!input) return;
      input.value = chip.dataset.prompt ?? '';
      input.focus();
    });
  });

  // Count-up and ring fill on load (the page already shows the final values without JS)
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const counters = [...document.querySelectorAll<HTMLElement>('[data-count-to]')];
    const rings = [...document.querySelectorAll<SVGCircleElement>('[data-ring-to]')];

    const show = (el: HTMLElement, v: number) => {
      el.textContent = el.dataset.format === 'inr' ? inr(v) : String(Math.max(0, Math.round(v)));
    };

    counters.forEach((el) => show(el, Number(el.dataset.countFrom)));
    rings.forEach((r) => r.setAttribute('stroke-dashoffset', r.dataset.ringFrom ?? '0'));

    requestAnimationFrame(() => {
      rings.forEach((r) => r.setAttribute('stroke-dashoffset', r.dataset.ringTo ?? '0'));
      const t0 = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - t0) / 900);
        const k = 1 - Math.pow(1 - t, 3);
        counters.forEach((el) => {
          const from = Number(el.dataset.countFrom);
          const to = Number(el.dataset.countTo);
          show(el, from + (to - from) * k);
        });
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  }
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Asks for pay until it's been given or confirmed */
  .pay-ask {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 24px;
    padding: 18px 20px;
    border-radius: 24px;
    background: var(--cream);
    border: 2.5px solid var(--ink);
  }

  .pay-ask[hidden] {
    display: none;
  }

  .pay-ask__text {
    flex: 1;
    min-width: min(100%, 280px);
  }

  .pay-ask__title {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 20px;
  }

  .pay-ask__body {
    margin: 0;
    line-height: 1.45;
    color: var(--ink-muted);
  }

  .pay-ask__body b {
    color: var(--ink);
  }

  .pay-ask__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* Asks for a name when none is saved */
  .name-ask {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 20px;
    border-radius: 24px;
    background: var(--cream);
    border: 2.5px solid var(--ink);
  }

  .name-ask[hidden],
  .name-ask__err[hidden] {
    display: none;
  }

  .name-ask__label {
    font-weight: 800;
  }

  .name-ask__row {
    display: flex;
    gap: 10px;
  }

  .name-ask__field {
    flex: 1;
    min-width: 0;
  }

  .name-ask__err {
    margin: 0;
    font-weight: 700;
    color: var(--danger);
  }

  /* Header */
  .head {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .head__who {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .head__avatar {
    display: none;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 16px;
    background: var(--mango);
    border: 2.5px solid var(--ink);
    box-sizing: border-box;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 18px;
  }

  .head__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

