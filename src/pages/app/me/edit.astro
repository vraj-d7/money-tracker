---
import AppShell from '../../../layouts/AppShell.astro';
import { routes } from '../../../lib/routes';
import { backendOn } from '../../../scripts/backend';
import { DEFAULT_PROFILE, initials } from '../../../scripts/profile-store';

const p = DEFAULT_PROFILE;
const cities = ['Bengaluru', 'Mumbai', 'Delhi NCR', 'Pune', 'Hyderabad', 'Chennai', 'Other'];
---

<AppShell title="Edit profile" active="me">
  <header class="head">
    <a href={routes.me} class="back">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"></path></svg>
      Back to Me
    </a>
    <h1>Edit profile</h1>
  </header>

  <form class="card form" aria-label="Profile" data-profile-form novalidate>
    <div class="avatar-row">
      <span class="avatar" aria-hidden="true" data-initials>{initials(p)}</span>
      <p class="muted">Your initials are your avatar. No photo needed.</p>
    </div>
    <div class="two">
      <div class="group">
        <label for="pf-first" class="group__label">First name</label>
        <div class="field"><input id="pf-first" name="first" type="text" value={p.name} placeholder="First name" autocomplete="given-name" required /></div>
      </div>
      <div class="group">
        <label for="pf-last" class="group__label">Last name</label>
        <div class="field"><input id="pf-last" name="last" type="text" value={p.lastName} placeholder="Last name" autocomplete="family-name" /></div>
      </div>
    </div>
    <div class="group">
      <label for="pf-mail" class="group__label">Email (for receipts)</label>
      <div class="field"><input id="pf-mail" name="mail" type="email" value={p.email} placeholder="you@example.com" autocomplete="email" aria-describedby="mail-error" /></div>
      <p class="error" id="mail-error" data-mail-error hidden>That email doesn’t look right.</p>
    </div>
    <div class="group">
      <span class="group__label">Mobile number</span>
      <div class="num phone">
        <span data-phone></span>
        {!backendOn && <a href={routes.auth} class="link">Change</a>}
      </div>
    </div>
    <fieldset class="group">
      <legend class="group__label">City</legend>
      <div class="chips">
        {
          cities.map((c) => (
            <button type="button" class="chip" data-city={c} aria-pressed={c === p.city ? 'true' : 'false'}>
              {c}
            </button>
          ))
        }
      </div>
    </fieldset>
    <div class="actions">
      <button type="submit" class="btn btn--mango btn--lg">Save changes</button>
      <a href={routes.me} class="btn">Cancel</a>
    </div>
  </form>
</AppShell>

<script>
  import { routes } from '../../../lib/routes';
  import { initials, loadProfile, saveProfile } from '../../../scripts/profile-store';

  const form = document.querySelector<HTMLFormElement>('[data-profile-form]')!;
  const first = form.querySelector<HTMLInputElement>('#pf-first')!;
  const last = form.querySelector<HTMLInputElement>('#pf-last')!;
  const mail = form.querySelector<HTMLInputElement>('#pf-mail')!;
  const p = loadProfile();
  let city = p.city;

  first.value = p.name;
  last.value = p.lastName;
  mail.value = p.email;
  form.querySelector('[data-phone]')!.textContent = p.phone ? `+91 ${p.phone}` : 'Not added yet';

  const showInitials = () => (form.querySelector('[data-initials]')!.textContent = initials({ name: first.value, lastName: last.value }));
  first.addEventListener('input', showInitials);
  last.addEventListener('input', showInitials);
  showInitials();

  const cityBtns = [...form.querySelectorAll<HTMLButtonElement>('[data-city]')];
  const showCity = () => cityBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.city === city)));
  cityBtns.forEach((b) =>
    b.addEventListener('click', () => {
      city = b.dataset.city!;
      showCity();
    }),
  );
  showCity();

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!first.value.trim()) {
      first.focus();
      return;
    }
    const email = mail.value.trim();
    const bad = email !== '' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    form.querySelector<HTMLElement>('[data-mail-error]')!.hidden = !bad;
    if (bad) {
      mail.focus();
      return;
    }
    saveProfile({ name: first.value.trim(), lastName: last.value.trim(), email, city });
    window.location.href = routes.me;
  });
</script>

<style>
  .muted {
    margin: 0;
    font-size: 16px;
    color: var(--ink-muted);
  }

  .head {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-weight: 700;
    text-decoration: none;
    color: var(--violet);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 40px;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .card {
    padding: 24px;
    border-radius: 28px;
    background: var(--white);
    border: 2.5px solid var(--ink);
    box-shadow: 0 6px 0 var(--ink);
  }

  .form {
    grid-column: span 7;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .avatar-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .avatar {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: 22px;
    background: var(--mango);
    border: 3px solid var(--ink);
    box-sizing: border-box;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 28px;
  }

  .two {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 0;
    border: none;
    min-width: 0;
  }

  .group__label {
    padding: 0;
    font-weight: 700;
  }

  fieldset .group__label {
    margin-bottom: 8px;
  }

  .error {
    margin: 0;
    color: var(--danger);
    font-weight: 700;
  }

  .error[hidden] {
    display: none;
  }

  .phone {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 56px;
    padding: 0 16px;
    border-radius: 16px;
    background: var(--paper-deep);
  }

  .link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--violet);
    font-weight: 700;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    min-height: 44px;
    padding: 0 16px;
    border-radius: 99px;
    background: var(--white);
    border: 2.5px solid var(--ink);
    color: var(--ink);
    font-weight: 700;
    font-size: 16px;
    cursor: pointer;
  }

  .chip[aria-pressed='true'] {
    background: var(--mango);
    box-shadow: 0 3px 0 var(--ink);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 1279px) {
    .form {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 639px) {
    .form {
      padding: 20px;
    }

    .two {
      grid-template-columns: minmax(0, 1fr);
    }

    .actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
