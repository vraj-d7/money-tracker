---
import AppShell from '../../../layouts/AppShell.astro';
import FixedPayFields from '../../../components/FixedPayFields.astro';
import { routes } from '../../../lib/routes';
import { inr } from '../../../lib/format';
import { regimesWithDetails } from '../../../lib/salary';
import { DEFAULT_PROFILE } from '../../../scripts/profile-store';

const p = DEFAULT_PROFILE;
const r = regimesWithDetails(p.ctc, p.tax);

const fields = [
  { key: 'basicPct', label: 'Basic pay (% of CTC)', prefix: '', placeholder: '50' },
  { key: 'hra', label: 'HRA you receive (per month)', prefix: '₹', placeholder: '0' },
  { key: 'rent', label: 'Rent you pay (per month)', prefix: '₹', placeholder: '0' },
  { key: 'c80', label: 'Other 80C (ELSS, PPF, insurance)', prefix: '₹', placeholder: '0' },
  { key: 'd80', label: 'Health insurance (80D)', prefix: '₹', placeholder: '0' },
  { key: 'pt', label: 'Professional tax (per year)', prefix: '₹', placeholder: '2400' },
] as const;
---

<AppShell title="Salary and tax details" active="me">
  <header class="head">
    <a href={routes.me} class="back">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"></path></svg>
      Back to Me
    </a>
    <h1>Salary and tax details</h1>
    <p class="muted">Your pay powers every screen. The more you add, the closer it gets to your payslip.</p>
  </header>

  <section class="card form" aria-label="Details" data-details>
    <fieldset class="group">
      <legend class="group__label">How do you know your pay?</legend>
      <div class="chips">
        <button type="button" class="chip" data-pay="ctc" aria-pressed="true">I know my CTC</button>
        <button type="button" class="chip" data-pay="fixed" aria-pressed="false">I get a fixed monthly salary</button>
      </div>
    </fieldset>
    <FixedPayFields />
    <div class="group" data-ctc-only>
      <label for="sd-ctc" class="group__label">Your CTC (per year)</label>
      <div class="field">
        <span class="field__prefix">₹</span>
        <input id="sd-ctc" class="num" type="text" inputmode="numeric" autocomplete="off" aria-describedby="sd-ctc-error" data-ctc-input />
      </div>
      <p class="sd-error" id="sd-ctc-error" role="alert" data-ctc-error hidden>Enter a CTC between ₹2,00,000 and ₹1,00,00,000.</p>
    </div>
    <div class="two" data-ctc-only>
      {
        fields.map((f) => (
          <div class="group">
            <label for={`sd-${f.key}`} class="group__label">
              {f.label}
            </label>
            <div class="field">
              {f.prefix && <span class="field__prefix">{f.prefix}</span>}
              <input id={`sd-${f.key}`} class="num" type="text" inputmode="numeric" data-field={f.key} value={p.tax[f.key].toLocaleString('en-IN')} placeholder={f.placeholder} />
            </div>
          </div>
        ))
      }
    </div>
    <fieldset class="group" data-ctc-only>
      <legend class="group__label">Do you live in a metro city?</legend>
      <div class="chips">
        <button type="button" class="chip" data-metro="yes" aria-pressed="false">Yes, metro</button>
        <button type="button" class="chip" data-metro="no" aria-pressed="true">No</button>
      </div>
      <p class="muted">Mumbai, Delhi, Kolkata and Chennai count as metro for HRA (50% of basic); others 40%.</p>
    </fieldset>
    <button type="button" class="btn btn--mango btn--lg" data-save>Save and recalculate</button>
  </section>

  <aside class="result" data-ctc-only>
    <span class="result__label">With these details</span>
    <p class="num result__verdict" aria-live="polite" data-verdict>Both regimes land at zero tax for you.</p>
    <dl class="num result__list">
      <dt>HRA exemption</dt><dd data-out="hra">{inr(r.hraExempt)}</dd>
      <dt>80C used</dt><dd data-out="c80">{inr(r.c80Used)}</dd>
      <dt>Old regime tax</dt><dd data-out="old">{inr(r.oldTax)}</dd>
      <dt>New regime tax</dt><dd data-out="new">{inr(r.newTax)}</dd>
    </dl>
    <p class="muted">Yearly estimate for a <span data-ctc>₹{p.ctc}L</span> CTC. Not tax advice.</p>
  </aside>
</AppShell>

<script>
  import { inr } from '../../../lib/format';
  import { routes } from '../../../lib/routes';
  import { regimesWithDetails } from '../../../lib/salary';
  import { loadProfile, saveProfile, type Profile, type TaxDetails } from '../../../scripts/profile-store';
  import { wireFixedPay } from '../../../scripts/pay-form';

  const root = document.querySelector<HTMLElement>('[data-details]')!;
  const p = loadProfile();
  const tax: TaxDetails = { ...p.tax };
  // Links can open this on a choice with ?pay=fixed
  const asked = new URLSearchParams(window.location.search).get('pay');
  let payType: Profile['payType'] = asked === 'fixed' || asked === 'ctc' ? asked : p.payType;
  let ctc = p.ctc;
  const fixedPay = wireFixedPay(p);
  const ctcInput = root.querySelector<HTMLInputElement>('[data-ctc-input]')!;
  const ctcError = root.querySelector<HTMLElement>('[data-ctc-error]')!;
  const lakhLabel = (l: number) => (l >= 100 ? '₹1Cr' : `₹${+l.toFixed(2)}L`);
  ctcInput.value = Math.round(ctc * 100000).toLocaleString('en-IN');

  function showPayType() {
    root.querySelectorAll<HTMLElement>('[data-pay]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pay === payType)));
    fixedPay.show(payType === 'fixed');
    document.querySelectorAll<HTMLElement>('[data-ctc-only]').forEach((el) => (el.hidden = payType === 'fixed'));
  }
  root.querySelectorAll<HTMLElement>('[data-pay]').forEach((b) =>
    b.addEventListener('click', () => {
      payType = b.dataset.pay as Profile['payType'];
      showPayType();
    }),
  );
  ctcInput.addEventListener('input', () => {
    const rupees = Number(ctcInput.value.split('.')[0].replace(/\D/g, ''));
    ctcInput.value = rupees ? rupees.toLocaleString('en-IN') : '';
    const ok = rupees >= 200000 && rupees <= 10000000;
    ctcError.hidden = ok || !rupees;
    if (!ok) return;
    ctc = rupees / 100000;
    document.querySelector('[data-ctc]')!.textContent = lakhLabel(ctc);
    render();
  });
  const inputs = [...root.querySelectorAll<HTMLInputElement>('[data-field]')];
  const num = (v: string) => parseInt(v.replace(/[^0-9]/g, ''), 10) || 0;

  function render() {
    root.querySelectorAll<HTMLElement>('[data-metro]').forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.metro === 'yes') === tax.metro)));
    const r = regimesWithDetails(ctc, tax);
    const out = (k: string, v: number) => (document.querySelector(`[data-out="${k}"]`)!.textContent = inr(v));
    out('hra', r.hraExempt);
    out('c80', r.c80Used);
    out('old', r.oldTax);
    out('new', r.newTax);
    const diff = Math.abs(r.oldTax - r.newTax) / 12;
    document.querySelector('[data-verdict]')!.textContent =
      r.oldTax === 0 && r.newTax === 0
        ? 'Both regimes land at zero tax for you.'
        : diff < 1
          ? 'Both regimes cost you the same.'
          : `${r.newTax <= r.oldTax ? 'New' : 'Old'} regime ${r.newTax <= r.oldTax ? 'still wins' : 'wins'}, by ${inr(diff)} a month.`;
  }

  inputs.forEach((input) => {
    const key = input.dataset.field as keyof TaxDetails;
    input.value = (tax[key] as number).toLocaleString('en-IN');
    input.addEventListener('input', () => {
      const v = num(input.value);
      (tax[key] as number) = key === 'basicPct' ? Math.min(100, v) : v;
      input.value = input.value.trim() === '' ? '' : (tax[key] as number).toLocaleString('en-IN');
      render();
    });
  });

  root.querySelectorAll<HTMLElement>('[data-metro]').forEach((b) =>
    b.addEventListener('click', () => {
      tax.metro = b.dataset.metro === 'yes';
      render();
    }),
  );

  root.querySelector('[data-save]')!.addEventListener('click', () => {
    if (payType === 'fixed') {
      if (!fixedPay.validate()) return;
      saveProfile({ payConfirmed: true, payType, ...fixedPay.values() });
    } else {
      const rupees = Number(ctcInput.value.split('.')[0].replace(/\D/g, ''));
      if (rupees < 200000 || rupees > 10000000) {
        ctcError.hidden = false;
        ctcInput.focus();
        return;
      }
      saveProfile({ payConfirmed: true, payType, ctc, tax });
    }
    window.location.href = `${routes.me}?done=tax`;
  });

  document.querySelector('[data-ctc]')!.textContent = lakhLabel(ctc);
  showPayType();
  render();
</script>

<style>
  [data-ctc-only][hidden],
  .sd-error[hidden] {
    display: none;
  }

  .sd-error {
    margin: 0;
    font-weight: 700;
    color: var(--danger);
  }

  .muted {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .head {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-weight: 700;
    text-decoration: none;
    color: var(--violet);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 40px;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .card {
    padding: 24px;
    border-radius: 28px;
    background: var(--white);
    border: 2.5px solid var(--ink);
    box-shadow: 0 6px 0 var(--ink);
  }

  .form {
    grid-column: span 7;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .two {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .group {
    margin: 0;
    padding: 0;
    border: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .group__label {
    padding: 0;
    font-weight: 700;
  }

  fieldset .group__label {
    margin-bottom: 8px;
  }

  .field__prefix {
    font-weight: 800;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    min-height: 44px;
    padding: 0 16px;
    border-radius: 99px;
    background: var(--white);
    border: 2.5px solid var(--ink);
    color: var(--ink);
    font-weight: 700;
    font-size: 16px;
    cursor: pointer;
  }

  .chip[aria-pressed='true'] {
    background: var(--mango);
    box-shadow: 0 3px 0 var(--ink);
  }

  .result {
    grid-column: span 5;
    align-self: start;
    position: sticky;
    top: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    border-radius: 28px;
    background: #e2f8ef;
    border: 2.5px solid var(--ink);
  }

  .result__label {
    font-weight: 800;
    color: #0a6b4d;
  }

  .result__verdict {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 28px;
    line-height: 1.15;
  }

  .result__list {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 12px;
  }

  .result__list dd {
    margin: 0;
    font-weight: 800;
  }

  @media (max-width: 1279px) {
    .form,
    .result {
      grid-column: 1 / -1;
    }

    .result {
      position: static;
    }
  }

  @media (max-width: 639px) {
    .form {
      padding: 18px;
    }

    .two {
      grid-template-columns: minmax(0, 1fr);
    }

    .result__verdict {
      font-size: 22px;
    }
  }
</style>
