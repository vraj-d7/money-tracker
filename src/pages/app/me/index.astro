---
import AppShell from '../../../layouts/AppShell.astro';
import { routes } from '../../../lib/routes';
import { inr } from '../../../lib/format';
import { COACH_MODES } from '../../../lib/coach';
import { compareRegimes } from '../../../lib/salary';
import { DEFAULT_PROFILE, describePayday, displayName, initials } from '../../../scripts/profile-store';

const p = DEFAULT_PROFILE;
const cmp = compareRegimes(p.ctc);

const toggles = [
  { key: 'sunday', label: 'Sunday check-in', sub: 'A 1-minute recap at 9 AM' },
  { key: 'renew', label: 'Renewal alerts', sub: '2 days before an autopay charges' },
  { key: 'pf', label: 'PF deposit alerts', sub: 'If your employer misses a month' },
  { key: 'payday', label: 'Payday countdown', sub: 'A nudge 3 days before salary day' },
] as const;

const samples: Record<string, string> = {
  hype: '“₹600 under plan?! You’re a legend!”',
  honest: '“₹600 under plan. Food was 26% of spend.”',
  mom: '“Beta, ₹840 on delivery? Ghar ka khana kya bura hai?”',
};

const icon = {
  salary: 'M7 5h10M7 9h10M7 5c4 0 5 2 5 4s-1 4-5 4l8 7',
  payday: 'M4 6h16v14H4zM4 10h16M8 3v4M16 3v4',
  help: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6V14M12 17v.5',
  logout: 'M15 4h4v16h-4M10 8l-4 4 4 4M6 12h10',
  download: 'M12 3v12M7 10l5 5 5-5M4 20h16',
  trash: 'M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3',
};

const settings = [
  { href: routes.salaryDetails, icon: icon.salary, label: 'Salary and tax details', sub: 'Basic pay, HRA, rent, 80C' },
  { href: routes.paydaySettings, icon: icon.payday, label: 'Payday', sub: describePayday(p.payday), id: 'payday' },
  { href: routes.help, icon: icon.help, label: 'Help and FAQs', sub: 'How Inhandy works' },
  { href: routes.logout, icon: icon.logout, label: 'Log out', sub: 'You can log back in with your number' },
];
---

<AppShell title="Me" active="me">
  <header class="head"><h1>Me</h1></header>

  <div class="col col--main">
    <section class="card profile" aria-labelledby="prof-h">
      <div class="profile__top">
        <span class="avatar" aria-hidden="true" data-initials>{initials(p)}</span>
        <div class="profile__who">
          <h2 id="prof-h" class="profile__name" data-name>{displayName(p)}</h2>
          <span class="num muted" data-contact>+91 {p.phone} · {p.email}</span>
        </div>
        <a href={routes.editProfile} class="btn">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4L19 9l-4-4L4 16zM14 6l4 4"></path></svg>
          Edit profile
        </a>
      </div>
      <dl class="facts">
        <div class="fact"><dt>CTC</dt><dd class="num" data-fact="ctc">₹{p.ctc}L a year</dd></div>
        <div class="fact"><dt>City</dt><dd data-fact="city">{p.city}</dd></div>
        <div class="fact"><dt>Payday</dt><dd data-fact="payday">{describePayday(p.payday)}</dd></div>
        <div class="fact">
          <dt>Tax regime</dt>
          <dd class="num" data-fact="regime">{cmp.winner === 'new' ? 'New' : 'Old'} (saves {inr(cmp.monthlyGap)}/mo)</dd>
        </div>
      </dl>
      <p class="muted">These power your salary maths. Change them any time; every screen updates.</p>
    </section>

    <section class="card" aria-labelledby="notif-h">
      <h2 id="notif-h" class="card__title">Notifications</h2>
      {
        toggles.map((t) => (
          <div class="toggle">
            <span class="toggle__text">
              <span id={`tg-${t.key}`} class="toggle__label">
                {t.label}
              </span>
              <span class="muted">{t.sub}</span>
            </span>
            <button type="button" role="switch" class="switch" aria-checked={p.notifications[t.key] ? 'true' : 'false'} aria-labelledby={`tg-${t.key}`} data-toggle={t.key}>
              <span class="switch__knob" />
            </button>
          </div>
        ))
      }
      <p class="muted small">Notifications start working once Inhandy can send them; your choices are saved now.</p>
    </section>

    <section class="card" aria-labelledby="mode-h">
      <h2 id="mode-h" class="card__title">Coach vibe</h2>
      <div class="modes" role="group" aria-label="Coach mode">
        {
          COACH_MODES.map((m) => (
            <button type="button" class="modes__btn" data-mode={m.id} data-sample={samples[m.id]} aria-pressed={m.id === p.coachMode ? 'true' : 'false'}>
              {m.label}
            </button>
          ))
        }
      </div>
      <p class="muted" data-mode-sample>{samples[p.coachMode]}</p>
    </section>
  </div>

  <div class="col col--side">
    <section class="plan" aria-labelledby="planbox-h">
      <div class="plan__top">
        <h2 id="planbox-h" class="card__title">Your plan</h2>
        <span class="plan__badge">Free</span>
      </div>
      <p class="plan__text">
        Salary explainer, offer face-off and the first ITR checklist stay free forever. The Coach plan adds Sunday check-ins, renewal alerts
        and unlimited chats for ₹19/week.
      </p>
      <a href={routes.paywall} class="btn btn--mango btn--lg">See the Coach plan</a>
    </section>

    <section class="card list" aria-label="Settings">
      {
        settings.map((s) => (
          <a href={s.href} class="rowlink row">
            <span class="row__icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d={s.icon} />
              </svg>
            </span>
            <span class="row__text">
              <span class="row__label">{s.label}</span>
              <span class="muted" data-row-sub={s.id}>
                {s.sub}
              </span>
            </span>
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
          </a>
        ))
      }
    </section>

    <section class="card list" aria-label="Your data">
      <button type="button" class="rowlink row" data-download>
        <span class="row__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={icon.download}></path></svg>
        </span>
        <span class="row__text">
          <span class="row__label">Download my data</span>
          <span class="muted">Everything Inhandy has saved, as a file</span>
        </span>
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg>
      </button>
      <a href={routes.deleteStatements} class="rowlink row">
        <span class="row__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={icon.trash}></path></svg>
        </span>
        <span class="row__text">
          <span class="row__label">Delete my statements</span>
          <span class="muted">Removes scan history; jars stay</span>
        </span>
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg>
      </a>
      <a href={routes.deleteAccount} class="rowlink row row--danger">
        <span class="row__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={icon.trash}></path></svg>
        </span>
        <span class="row__text">
          <span class="row__label">Delete my account</span>
          <span class="muted">Everything, gone for good</span>
        </span>
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg>
      </a>
    </section>
    <p class="muted center">Inhandy v1.0 · Made with chai in India</p>
  </div>
</AppShell>

<script>
  import { inr } from '../../../lib/format';
  import { compareRegimes } from '../../../lib/salary';
  import {
    describePayday,
    displayName,
    initials,
    loadProfile,
    saveProfile,
    type CoachMode,
    type NotificationKey,
  } from '../../../scripts/profile-store';
  import { showToast } from '../../../scripts/toast';

  const p = loadProfile();
  const cmp = compareRegimes(p.ctc);
  const set = (sel: string, text: string) => document.querySelectorAll(sel).forEach((el) => (el.textContent = text));

  // Profile facts from what's saved
  set('[data-name]', displayName(p));
  set('[data-initials]', initials(p));
  set('[data-contact]', [p.phone && `+91 ${p.phone}`, p.email].filter(Boolean).join(' · ') || 'Add your email in Edit profile');
  set('[data-fact="ctc"]', p.ctc >= 100 ? '₹1Cr a year' : `₹${p.ctc}L a year`);
  set('[data-fact="city"]', p.city);
  set('[data-fact="payday"]', describePayday(p.payday));
  set('[data-row-sub="payday"]', describePayday(p.payday));
  set(
    '[data-fact="regime"]',
    cmp.monthlyGap < 1 ? 'Either (same in-hand)' : `${cmp.winner === 'new' ? 'New' : 'Old'} (saves ${inr(cmp.monthlyGap)}/mo)`,
  );

  // Notification switches
  document.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((sw) => {
    const key = sw.dataset.toggle as NotificationKey;
    sw.setAttribute('aria-checked', String(p.notifications[key]));
    sw.addEventListener('click', () => {
      p.notifications[key] = !p.notifications[key];
      sw.setAttribute('aria-checked', String(p.notifications[key]));
      saveProfile({ notifications: p.notifications });
    });
  });

  // Coach vibe
  const sample = document.querySelector('[data-mode-sample]')!;
  const modeBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-mode]')];
  const showMode = (mode: CoachMode) => {
    modeBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));
    sample.textContent = modeBtns.find((b) => b.dataset.mode === mode)?.dataset.sample ?? '';
  };
  modeBtns.forEach((b) =>
    b.addEventListener('click', () => {
      saveProfile({ coachMode: b.dataset.mode as CoachMode });
      showMode(b.dataset.mode as CoachMode);
    }),
  );
  showMode(p.coachMode);

  // Download everything saved in this browser as one JSON file
  document.querySelector('[data-download]')!.addEventListener('click', () => {
    const data: Record<string, unknown> = {};
    try {
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i)!;
        if (!k.startsWith('inhandy:')) continue;
        try {
          data[k.slice('inhandy:'.length)] = JSON.parse(localStorage.getItem(k)!);
        } catch {
          data[k.slice('inhandy:'.length)] = localStorage.getItem(k);
        }
      }
    } catch {
      // Storage blocked: download an empty export
    }
    const file = { exportedAt: new Date().toISOString(), profile: loadProfile(), saved: data };
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([JSON.stringify(file, null, 2)], { type: 'application/json' }));
    a.download = 'inhandy-my-data.json';
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    showToast('Downloaded inhandy-my-data.json');
  });

  // Toasts left by the confirm screens (e.g. after deleting statements)
  const done = new URLSearchParams(window.location.search).get('done');
  const doneMessages: Record<string, string> = {
    statements: 'Statement history deleted. Your jars and goals are safe.',
    tax: 'Salary and tax details saved.',
  };
  if (done && doneMessages[done]) {
    history.replaceState(null, '', window.location.pathname);
    showToast(doneMessages[done]);
  }
</script>

<style>
  .muted {
    margin: 0;
    font-size: 16px;
    line-height: 1.45;
    color: var(--ink-muted);
  }

  .small {
    font-size: 14px;
  }

  .center {
    text-align: center;
  }

  .head {
    grid-column: 1 / -1;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 40px;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }

  .col--main {
    grid-column: span 7;
  }

  .col--side {
    grid-column: span 5;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    border-radius: 28px;
    background: var(--white);
    border: 2.5px solid var(--ink);
    box-shadow: 0 6px 0 var(--ink);
  }

  .card__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
  }

  .profile {
    gap: 18px;
  }

  .profile__top {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .avatar {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: 22px;
    background: var(--mango);
    border: 3px solid var(--ink);
    box-sizing: border-box;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 28px;
  }

  .profile__who {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .profile__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 26px;
  }

  .facts {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .fact {
    padding: 12px 14px;
    border-radius: 16px;
    background: var(--paper-deep);
  }

  .fact dt {
    font-weight: 600;
    color: var(--ink-muted);
  }

  .fact dd {
    margin: 2px 0 0;
    font-weight: 800;
    font-size: 18px;
  }

  .toggle {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 0;
    border-top: 2px dashed var(--line);
  }

  .toggle__text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .toggle__label {
    font-weight: 700;
  }

  .switch {
    position: relative;
    flex: none;
    width: 56px;
    height: 32px;
    padding: 0;
    border-radius: 99px;
    border: 2.5px solid var(--ink);
    background: #f1e7d3;
    cursor: pointer;
    transition: background-color 0.2s var(--ease);
  }

  .switch::before {
    content: '';
    position: absolute;
    inset: -8px -4px;
  }

  .switch[aria-checked='true'] {
    background: var(--mint);
  }

  .switch__knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 23px;
    height: 23px;
    border-radius: 50%;
    background: var(--white);
    border: 2px solid var(--ink);
    box-sizing: border-box;
    transition: transform 0.2s var(--ease);
  }

  .switch[aria-checked='true'] .switch__knob {
    transform: translateX(24px);
  }

  .modes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 4px;
    padding: 4px;
    border-radius: 18px;
    background: var(--paper-deep);
    border: 2px solid var(--ink);
  }

  .modes__btn {
    min-height: 44px;
    border-radius: 14px;
    background: transparent;
    border: 2px solid transparent;
    color: var(--ink);
    font-weight: 800;
    font-size: 16px;
    cursor: pointer;
  }

  .modes__btn[aria-pressed='true'] {
    background: var(--mango);
    border-color: var(--ink);
    box-shadow: 0 3px 0 var(--ink);
  }

  .plan {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    border-radius: 28px;
    background: var(--cream);
    border: 2.5px solid var(--ink);
    box-shadow: 0 6px 0 var(--ink);
  }

  .plan__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .plan__badge {
    padding: 4px 12px;
    border-radius: 99px;
    background: var(--white);
    border: 2px solid var(--ink);
    font-weight: 800;
  }

  .plan__text {
    margin: 0;
    line-height: 1.5;
  }

  .list {
    padding: 12px;
    gap: 2px;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    min-height: 60px;
    padding: 8px 12px;
    box-sizing: border-box;
    border-radius: 16px;
    background: transparent;
    border: none;
    color: var(--ink);
    text-align: left;
    text-decoration: none;
    font-size: 16px;
    cursor: pointer;
  }

  .row__icon {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 13px;
    background: var(--paper-deep);
  }

  .row__text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .row__label {
    font-weight: 700;
  }

  .row--danger {
    color: var(--danger);
  }

  .row--danger .row__icon {
    background: var(--danger-bg);
  }

  @media (max-width: 1279px) {
    .col--main,
    .col--side {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 639px) {
    .profile__top {
      flex-wrap: wrap;
    }

    .profile__top .btn {
      width: 100%;
    }

    .facts {
      grid-template-columns: minmax(0, 1fr);
    }

    .card {
      padding: 20px;
    }

    .list {
      padding: 8px;
    }
  }
</style>
