---
// Log out. With an account: saves any last changes, signs out and clears this browser's copy
// (it's all in the account). In test mode there's no session, so it just goes to the login page.
import SheetPage from '../../../layouts/SheetPage.astro';
import ConfirmDialog from '../../../components/ConfirmDialog.astro';
import { routes } from '../../../lib/routes';
import { backendOn } from '../../../scripts/backend';
---

<SheetPage title="Log out" active="me" closeHref={routes.me} width={520}>
  <ConfirmDialog
    title="Log out of Inhandy?"
    text={backendOn
      ? 'Your plan, jars and goals are saved to your account. Log back in any time with your email.'
      : 'Your plan, jars and goals stay saved. Log back in any time with your email.'}
    icon="M15 4h4v16h-4M10 8l-4 4 4 4M6 12h10"
  >
    <div class="confirm__actions">
      <a href={routes.auth} class="btn btn--mango btn--lg confirm__primary" data-logout>Log out</a>
      <a href={routes.me} class="btn">Cancel</a>
    </div>
  </ConfirmDialog>
</SheetPage>

<script>
  import { backendOn } from '../../../scripts/backend';
  import { routes } from '../../../lib/routes';

  if (backendOn) {
    const btn = document.querySelector<HTMLAnchorElement>('[data-logout]')!;
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      btn.textContent = 'Logging out…';
      const { supabase } = await import('../../../scripts/supabase');
      const { pushNow, clearLocal } = await import('../../../scripts/sync');
      await pushNow().catch(() => {});
      await supabase!.auth.signOut();
      clearLocal();
      window.location.href = routes.auth;
    });
  }
</script>
