---
import AppShell from '../../../layouts/AppShell.astro';
import { routes } from '../../../lib/routes';
import { DEFAULT_PROFILE } from '../../../scripts/profile-store';

const p = DEFAULT_PROFILE;
---

<AppShell title="Payday" active="me">
  <header class="head">
    <a href={routes.me} class="back">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"></path></svg>
      Back to Me
    </a>
    <h1>Payday</h1>
    <p class="muted">Your countdown, salary-day plan and reminders run off this date.</p>
  </header>

  <section class="card" aria-label="Payday" data-payday>
    <fieldset class="group">
      <legend class="group__label">Salary usually lands on</legend>
      <div class="days" role="group">
        {
          Array.from({ length: 31 }, (_, i) => (
            <button type="button" class="num day" data-day={i + 1} aria-pressed={p.payday === i + 1 ? 'true' : 'false'} aria-label={`Day ${i + 1}`}>
              {i + 1}
            </button>
          ))
        }
      </div>
      <button type="button" class="chip chip--wide" data-day="last" aria-pressed={p.payday === 'last' ? 'true' : 'false'}>Last working day of the month</button>
    </fieldset>
    <fieldset class="group" data-shift-group>
      <legend class="group__label">If that day is a weekend</legend>
      <div class="chips">
        <button type="button" class="chip" data-shift="before" aria-pressed="true">Paid the working day before</button>
        <button type="button" class="chip" data-shift="after" aria-pressed="false">Paid the working day after</button>
      </div>
    </fieldset>
    <p class="num next" role="status">Next payday: <span data-next></span></p>
    <button type="button" class="btn btn--mango btn--lg" data-save>Save payday</button>
  </section>
</AppShell>

<script>
  import { routes } from '../../../lib/routes';
  import { describeNextPayday, loadProfile, saveProfile, type Profile } from '../../../scripts/profile-store';

  const root = document.querySelector<HTMLElement>('[data-payday]')!;
  const p = loadProfile();
  let payday: Profile['payday'] = p.payday;
  let shift: Profile['paydayShift'] = p.paydayShift;

  function render() {
    root.querySelectorAll<HTMLElement>('[data-day]').forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.day === String(payday))),
    );
    root.querySelectorAll<HTMLElement>('[data-shift]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.shift === shift)));
    // "Last working day" already avoids weekends, so the shift choice doesn't apply
    root.querySelector<HTMLElement>('[data-shift-group]')!.hidden = payday === 'last';
    root.querySelector('[data-next]')!.textContent = describeNextPayday({ payday, paydayShift: shift });
  }

  root.querySelectorAll<HTMLElement>('[data-day]').forEach((b) =>
    b.addEventListener('click', () => {
      payday = b.dataset.day === 'last' ? 'last' : Number(b.dataset.day);
      render();
    }),
  );
  root.querySelectorAll<HTMLElement>('[data-shift]').forEach((b) =>
    b.addEventListener('click', () => {
      shift = b.dataset.shift as Profile['paydayShift'];
      render();
    }),
  );
  root.querySelector('[data-save]')!.addEventListener('click', () => {
    saveProfile({ payday, paydayShift: shift });
    window.location.href = routes.me;
  });

  render();
</script>

<style>
  .muted {
    margin: 0;
    font-size: 16px;
    color: var(--ink-muted);
  }

  .head {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-weight: 700;
    text-decoration: none;
    color: var(--violet);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 40px;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .card {
    grid-column: span 7;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    border-radius: 28px;
    background: var(--white);
    border: 2.5px solid var(--ink);
    box-shadow: 0 6px 0 var(--ink);
  }

  .group {
    margin: 0;
    padding: 0;
    border: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .group[hidden] {
    display: none;
  }

  .group__label {
    padding: 0;
    margin-bottom: 0;
    font-weight: 700;
  }

  .days {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 7px;
  }

  .day,
  .chip {
    background: var(--white);
    color: var(--ink);
    font-weight: 800;
    font-size: 16px;
    cursor: pointer;
  }

  .day {
    height: 48px;
    padding: 0;
    border-radius: 14px;
    border: 2px solid var(--ink);
  }

  .chip {
    min-height: 44px;
    padding: 0 16px;
    border-radius: 99px;
    border: 2.5px solid var(--ink);
    font-weight: 700;
  }

  .chip--wide {
    border-radius: 16px;
    min-height: 48px;
  }

  .day[aria-pressed='true'],
  .chip[aria-pressed='true'] {
    background: var(--mango);
    box-shadow: 0 3px 0 var(--ink);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .next {
    margin: 0;
    padding: 12px 14px;
    border-radius: 16px;
    background: #ffe7b0;
    color: #8a5800;
    font-weight: 700;
  }

  @media (max-width: 1279px) {
    .card {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 639px) {
    .card {
      padding: 18px;
    }

    .days {
      gap: 5px;
    }

    .day {
      height: 42px;
      border-radius: 12px;
    }
  }
</style>
