---
import SheetPage from '../../../layouts/SheetPage.astro';
import Handy from '../../../components/Handy.astro';
import { routes } from '../../../lib/routes';

const perks = [
  'A 1-minute recap every Sunday',
  'Renewal alerts before you’re charged',
  'Unlimited coach chats, all 3 modes',
  'Autopay scans and PF deposit alerts',
];
---

<SheetPage title="Coach plan" active="home" closeHref={routes.home} width={780}>
  <div class="paywall">
    <div class="paywall__art">
      <Handy mood="chai" size={150} decorative />
      <span class="paywall__streak">6-week streak</span>
    </div>
    <div class="paywall__body" data-paywall>
      <span class="tag">COACH PLAN</span>
      <h1 id="sheet-title">Keep your Sunday check-ins</h1>
      <p class="muted"><b class="ink">₹19/week</b>, less than one cutting chai + samosa. Billed weekly via UPI autopay.</p>
      <ul class="perks">
        {
          perks.map((p) => (
            <li>
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10" /></svg>
              {p}
            </li>
          ))
        }
      </ul>
      <div class="actions" data-free-actions>
        <a href={routes.checkout} class="btn btn--mango btn--lg btn--block">Continue for ₹19/week</a>
        <a href={routes.home} class="btn btn--block">Maybe later, stay on Free</a>
      </div>
      <div class="actions" data-active-actions hidden>
        <p class="on-plan">You’re already on the Coach plan.</p>
        <a href={routes.managePlan} class="btn btn--mango btn--lg btn--block">Manage my plan</a>
      </div>
      <p class="muted">Cancel anytime from Me, in one click. Salary explainer and offer face-off stay free forever.</p>
    </div>
  </div>
</SheetPage>

<script>
  import { hasCoachPlan, loadSubscription } from '../../../scripts/subscription-store';

  // Already subscribed? Point to managing the plan instead of buying it again
  const on = hasCoachPlan(loadSubscription());
  document.querySelector<HTMLElement>('[data-free-actions]')!.hidden = on;
  document.querySelector<HTMLElement>('[data-active-actions]')!.hidden = !on;
</script>

<style>
  .paywall {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    margin: -32px;
  }

  .paywall__art {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 32px;
    background: var(--mango);
    border-right: 3px solid var(--ink);
  }

  .paywall__streak {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
  }

  .paywall__body {
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .tag {
    align-self: flex-start;
    padding: 4px 12px;
    border-radius: 99px;
    background: var(--ink);
    color: var(--mango);
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  h1 {
    margin: 0;
    padding-right: 40px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 34px;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .muted {
    margin: 0;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .ink {
    color: var(--ink);
  }

  .perks {
    margin: 0;
    padding: 16px;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-radius: 22px;
    background: var(--white);
    border: 2.5px solid var(--ink);
  }

  .perks li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-weight: 600;
    line-height: 1.4;
  }

  .perks svg {
    flex: none;
    color: #0a6b4d;
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .actions[hidden] {
    display: none;
  }

  .on-plan {
    margin: 0;
    padding: 12px 14px;
    border-radius: 14px;
    background: #e2f8ef;
    color: #0a6b4d;
    font-weight: 800;
  }

  @media (max-width: 767px) {
    .paywall {
      grid-template-columns: minmax(0, 1fr);
    }

    .paywall__art {
      display: none;
    }
  }

  @media (max-width: 639px) {
    .paywall {
      margin: -24px -20px -28px;
    }

    .paywall__body {
      padding: 24px 20px 28px;
    }

    h1 {
      font-size: 28px;
    }
  }
</style>
