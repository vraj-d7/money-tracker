---
import AppShell from '../../layouts/AppShell.astro';
import Handy from '../../components/Handy.astro';
import { routes } from '../../lib/routes';
import { inr } from '../../lib/format';
import {
  CTC_STEPS,
  FLOW_ROWS,
  calcSalary,
  compareRegimes,
  regimeLine,
  stepIndexOf,
  taxExplainer,
  type Regime,
} from '../../lib/salary';

// First render: ₹12L CTC, new regime, income tax row open (the client script takes over from here)
const startLakhs = 12;
const startRegime: Regime = 'new';
const startOpen = 'tax';

const b = calcSalary(startLakhs, startRegime);
const cmp = compareRegimes(startLakhs);
const idx = stepIndexOf(startLakhs);
const maxIdx = CTC_STEPS.length - 1;
const sliderPct = ((idx / maxIdx) * 100).toFixed(1) + '%';
const barPct = (v: number) => Math.max(0, Math.min(100, (Math.abs(v) / b.ctc) * 100)).toFixed(1) + '%';
const amt = (v: number) => (v < 0 ? '−' : '') + inr(Math.abs(v));
const mood = startRegime === cmp.winner ? (b.tax === 0 ? 'cheer' : 'happy') : 'gasp';
const shareHref = `${routes.share}?card=salary&inhand=${Math.round(b.inhand / 12)}`;

// Where each tick label sits on the slider track
const ticks = [2, 10, 20, 50, 100].map((l) => ({
  label: l === 100 ? '₹1Cr' : `₹${l}L`,
  left: ((stepIndexOf(l) / maxIdx) * 100).toFixed(1) + '%',
}));
---

<AppShell title="Salary explained" active="salary">
  <header class="head">
    <div class="head__text">
      <h1>Your salary, explained</h1>
      <p class="muted" data-salary-sub>Click any line to see what it means.</p>
      <p class="muted" data-fixed-offer>On a fixed monthly salary? <a href={`${routes.salaryDetails}?pay=fixed`}>Use that instead</a></p>
    </div>
    <a href={shareHref} class="btn head__share" data-share-link>
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7"></path><path d="M12 3v12M7 8l5-5 5 5"></path></svg>
      Share my salary card
    </a>
  </header>

  <section class="ctc" aria-label="Your CTC" data-salary data-start-idx={idx} data-start-regime={startRegime} data-start-open={startOpen}>
    <div class="ctc__value">
      <label for="ctc-range" class="eyebrow">Your CTC</label>
      <span class="num ctc__amount">
        <span aria-hidden="true">₹</span><input
          class="num ctc__input"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          aria-label="Your CTC in rupees per year"
          aria-describedby="ctc-hint"
          value={inr(b.ctc).replace('₹', '')}
          data-ctc
        /><span class="ctc__per"> /year</span>
      </span>
      <span class="ctc__hint" id="ctc-hint" role="status" data-ctc-hint hidden>Enter between ₹2,00,000 and ₹1,00,00,000 a year</span>
    </div>
    <div class="ctc__slider">
      <input
        id="ctc-range"
        class="rng"
        type="range"
        min="0"
        max={maxIdx}
        step="1"
        value={idx}
        aria-valuetext={`${inr(b.ctc)} per year`}
        style={`--p: ${sliderPct}`}
      />
      <div class="ctc__ticks" aria-hidden="true">
        {ticks.map((t) => <span style={`left: ${t.left}`}>{t.label}</span>)}
      </div>
    </div>
    <div class="ctc__steppers">
      <button type="button" class="btn ctc__step" data-step="-1" aria-label="Decrease CTC (₹2L minimum)">−</button>
      <button type="button" class="btn ctc__step" data-step="1" aria-label="Increase CTC (₹1Cr maximum)">+</button>
    </div>
  </section>

  <section class="card fixed" aria-labelledby="fixed-h" data-fixed-view hidden>
    <div class="fixed__top">
      <h2 id="fixed-h" class="fixed__title">Your monthly salary</h2>
      <a href={routes.salaryDetails} class="fixed__change">Change</a>
    </div>
    <dl class="num fixed__rows">
      <div><dt>Salary</dt><dd data-fixed-salary></dd></div>
      <div><dt>Cut before your bank</dt><dd data-fixed-cut-amt></dd></div>
      <div class="fixed__total"><dt>Lands in your bank</dt><dd data-fixed-lands></dd></div>
    </dl>
    <p class="fixed__note" data-fixed-note></p>
    <p class="fixed__note">Know your CTC instead? <a href={routes.salaryDetails}>Switch to CTC</a> to see tax, PF and a regime comparison.</p>
  </section>

  <section class="card flow" aria-labelledby="flow-h" data-ctc-view>
    <h2 id="flow-h" class="card__title flow__title">From CTC to your bank, per year</h2>
    {
      FLOW_ROWS.map((r) => {
        const v = r.value(b);
        const open = r.id === startOpen;
        return (
          <div class:list={['flow-row', { 'flow-row--total': r.total }]} data-row={r.id}>
            <button type="button" class="flow-row__btn" aria-expanded={open ? 'true' : 'false'} aria-controls={`explain-${r.id}`}>
              <span class="flow-row__sign" aria-hidden="true" style={`background: ${r.color}`}>
                {r.sign}
              </span>
              <span class="flow-row__label">{r.label}</span>
              <span class="flow-row__track" aria-hidden="true">
                <span class="flow-row__bar" style={`width: ${barPct(v)}; background: ${r.color}`} />
              </span>
              <span class:list={['num', 'flow-row__amt', { 'flow-row__amt--tax': r.id === 'tax' }]}>{amt(v)}</span>
              <svg class="flow-row__chev" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9l6 6 6-6" />
              </svg>
            </button>
            <div class="flow-row__panel">
              <div class="flow-row__clip">
                <p id={`explain-${r.id}`} class="flow-row__explain">
                  {r.id === 'tax' ? taxExplainer(startRegime) : r.explain}
                </p>
              </div>
            </div>
          </div>
        );
      })
    }
    <p class="flow__fine muted">
      Estimate. Assumes basic = 50% of CTC, PF at 12% of basic and ₹2,400 professional tax (varies by state). Old regime
      counts your PF under 80C only; add HRA and other deductions in Settings for a sharper answer. Not financial advice.
    </p>
  </section>

  <div class="side">
    <section class="inhand" aria-label="Your in-hand pay">
      <div class="inhand__text">
        <span class="inhand__label">Lands in your account</span>
        <span class="num inhand__amount" data-inhand>{inr(b.inhand / 12)}</span>
        <span class="muted" data-inhand-note>every month, <span data-regime-name>{startRegime} regime</span></span>
      </div>
      <div class="inhand__handy" data-handy={mood}>
        <span data-mood="happy"><Handy mood="happy" size={100} /></span>
        <span data-mood="cheer"><Handy mood="cheer" size={100} /></span>
        <span data-mood="gasp"><Handy mood="gasp" size={100} /></span>
      </div>
    </section>

    <section class="card regime" aria-labelledby="reg-h" data-ctc-view>
      <div class="card__top">
        <h2 id="reg-h" class="card__title">Tax regime</h2>
        <span class="muted">Tap to compare</span>
      </div>
      <div class="regime__options" role="group" aria-label="Tax regime">
        {
          (['new', 'old'] as const).map((id) => (
            <button type="button" class="regime__opt" data-regime={id} aria-pressed={id === startRegime ? 'true' : 'false'}>
              <span class="regime__name">{id === 'new' ? 'New regime' : 'Old regime'}</span>
              <span class="num regime__monthly">
                <span data-monthly>{inr(cmp[id].inhand / 12)}</span>
                <span class="regime__per">/mo</span>
              </span>
              <span class="winner" data-winner hidden={cmp.winner !== id}>
                <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4h8v5a4 4 0 0 1-8 0z"></path><path d="M12 13v4M8 20h8"></path></svg>
                Winner
              </span>
            </button>
          ))
        }
      </div>
      <p class="regime__line" data-regime-line>{regimeLine(cmp.winner, cmp.monthlyGap, inr)}</p>
    </section>

    <div class="actions">
      <a href={routes.offer} class="btn btn--mango btn--lg btn--block">
        Compare an offer
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
      <a href={routes.plan} class="btn btn--block actions__plan">Plan my salary day</a>
      <a href={shareHref} class="btn btn--block actions__share" data-share-link>Share “My first salary, explained”</a>
    </div>
  </div>
</AppShell>

<script>
  import { inr } from '../../lib/format';
  import { routes } from '../../lib/routes';
  import { fixedTaxNote, loadProfile, monthlyInhand } from '../../scripts/profile-store';
  import {
    CTC_STEPS,
    FLOW_ROWS,
    calcSalary,
    compareRegimes,
    regimeLine,
    stepIndexOf,
    taxExplainer,
    type Regime,
  } from '../../lib/salary';

  const root = document.querySelector<HTMLElement>('[data-salary]');
  if (root) {
    const $ = <T extends Element>(sel: string) => document.querySelector<T>(sel);
    const $$ = <T extends Element>(sel: string) => [...document.querySelectorAll<T>(sel)];

    const range = $<HTMLInputElement>('#ctc-range')!;
    const handyBox = $<HTMLElement>('.inhand__handy')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Any amount can be typed; the slider and +/− buttons move between CTC_STEPS
    let lakhs = CTC_STEPS[Number(root.dataset.startIdx)];
    const ctcInput = $<HTMLInputElement>('[data-ctc]')!;
    const ctcHint = $<HTMLElement>('[data-ctc-hint]')!;
    // The box is exactly as wide as its digits, so it sits in the row like plain text would
    function fitCtcInput() {
      ctcInput.style.width = '0';
      ctcInput.style.width = `${ctcInput.scrollWidth + 2}px`;
    }
    document.fonts.ready.then(fitCtcInput);
    window.addEventListener('resize', fitCtcInput);
    let regime = root.dataset.startRegime as Regime;
    let open: string | null = root.dataset.startOpen ?? null;
    let shownMonthly = calcSalary(lakhs, regime).inhand / 12;
    let raf = 0;

    const signed = (v: number) => (v < 0 ? '−' : '') + inr(Math.abs(v));

    // Count the in-hand number from where it is to the new value
    function animateInhand(target: number) {
      const el = $<HTMLElement>('[data-inhand]')!;
      cancelAnimationFrame(raf);
      if (reduceMotion) {
        shownMonthly = target;
        el.textContent = inr(target);
        return;
      }
      const from = shownMonthly;
      const t0 = performance.now();
      const step = (now: number) => {
        const k = Math.min(1, (now - t0) / 450);
        shownMonthly = from + (target - from) * (1 - Math.pow(1 - k, 3));
        el.textContent = inr(shownMonthly);
        if (k < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    }

    function render(regimeChanged = false) {
      const idx = stepIndexOf(lakhs);
      const b = calcSalary(lakhs, regime);
      const cmp = compareRegimes(lakhs);

      // CTC + slider
      // Leave the box alone while someone is typing in it
      if (document.activeElement !== ctcInput) ctcInput.value = inr(b.ctc).replace('₹', '');
      fitCtcInput();
      range.value = String(idx);
      range.setAttribute('aria-valuetext', `${inr(b.ctc)} per year`);
      range.style.setProperty('--p', ((idx / (CTC_STEPS.length - 1)) * 100).toFixed(1) + '%');

      // Breakdown rows
      for (const r of FLOW_ROWS) {
        const row = $<HTMLElement>(`.flow-row[data-row="${r.id}"]`)!;
        const v = r.value(b);
        row.querySelector<HTMLElement>('.flow-row__bar')!.style.width =
          Math.max(0, Math.min(100, (Math.abs(v) / b.ctc) * 100)).toFixed(1) + '%';
        row.querySelector('.flow-row__amt')!.textContent = signed(v);
        const isOpen = open === r.id;
        row.querySelector('.flow-row__btn')!.setAttribute('aria-expanded', String(isOpen));
      }
      $('#explain-tax')!.textContent = taxExplainer(regime);

      // Regime cards
      for (const btn of $$<HTMLElement>('[data-regime]')) {
        const id = btn.dataset.regime as Regime;
        btn.setAttribute('aria-pressed', String(id === regime));
        btn.querySelector('[data-monthly]')!.textContent = inr(cmp[id].inhand / 12);
        btn.querySelector<HTMLElement>('[data-winner]')!.hidden = cmp.winner !== id;
      }
      $('[data-regime-line]')!.textContent = regimeLine(cmp.winner, cmp.monthlyGap, inr);
      $('[data-regime-name]')!.textContent = `${regime} regime`;

      // In-hand + Handy's reaction
      animateInhand(b.inhand / 12);
      $$<HTMLAnchorElement>('[data-share-link]').forEach((a) => (a.href = `${routes.share}?card=salary&inhand=${Math.round(b.inhand / 12)}`));
      handyBox.dataset.handy = regime === cmp.winner ? (b.tax === 0 ? 'cheer' : 'happy') : 'gasp';
      if (regimeChanged && !reduceMotion) {
        handyBox.classList.remove('bob');
        void handyBox.offsetWidth; // restart the animation
        handyBox.classList.add('bob');
      }
    }

    range.addEventListener('input', () => {
      lakhs = CTC_STEPS[Number(range.value)];
      render();
    });

    const MIN_CTC = CTC_STEPS[0] * 100000;
    const MAX_CTC = CTC_STEPS[CTC_STEPS.length - 1] * 100000;
    const typedRupees = () => Number(ctcInput.value.split('.')[0].replace(/\D/g, ''));

    ctcInput.addEventListener('focus', () => ctcInput.select());
    ctcInput.addEventListener('input', () => {
      const rupees = typedRupees();
      const ok = rupees >= MIN_CTC && rupees <= MAX_CTC;
      // Half-typed amounts ("1", "12") just wait, with a hint, until they make sense
      ctcHint.hidden = ok || !ctcInput.value.trim();
      fitCtcInput();
      if (!ok) return;
      lakhs = rupees / 100000;
      render();
    });
    ctcInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') ctcInput.blur();
    });
    // Done typing: keep it within limits and tidy the commas. An empty box goes back to the last amount.
    ctcInput.addEventListener('blur', () => {
      const rupees = typedRupees();
      if (rupees > 0) lakhs = Math.max(MIN_CTC, Math.min(MAX_CTC, rupees)) / 100000;
      ctcHint.hidden = true;
      render();
    });

    for (const btn of $$<HTMLButtonElement>('[data-step]')) {
      btn.addEventListener('click', () => {
        // To the next step in that direction, even from a typed amount between steps
        lakhs =
          Number(btn.dataset.step) > 0
            ? (CTC_STEPS.find((x) => x > lakhs) ?? lakhs)
            : (CTC_STEPS.findLast((x) => x < lakhs) ?? lakhs);
        render();
      });
    }

    for (const btn of $$<HTMLButtonElement>('[data-regime]')) {
      btn.addEventListener('click', () => {
        const id = btn.dataset.regime as Regime;
        if (id === regime) return;
        regime = id;
        render(true);
      });
    }

    for (const row of $$<HTMLElement>('.flow-row')) {
      row.querySelector('.flow-row__btn')!.addEventListener('click', () => {
        open = open === row.dataset.row ? null : row.dataset.row!;
        render();
      });
    }

    // Open on the user's own CTC and their better regime (the page is pre-rendered for ₹12L, new regime)
    const profile = loadProfile();
    const ownRegime = compareRegimes(profile.ctc).winner;
    if (profile.payType === 'fixed') {
      // Fixed pay has no CTC to break down: just salary, what's cut, and what lands
      const lands = monthlyInhand(profile);
      root.hidden = true;
      $$<HTMLElement>('[data-ctc-view]').forEach((el) => (el.hidden = true));
      $<HTMLElement>('[data-fixed-view]')!.hidden = false;
      $('[data-salary-sub]')!.textContent = 'What lands in your account each month.';
      $<HTMLElement>('[data-fixed-offer]')!.hidden = true;
      $('[data-fixed-salary]')!.textContent = inr(profile.fixedMonthly);
      $('[data-fixed-cut-amt]')!.textContent = profile.fixedCuts ? `−${inr(profile.fixedCuts)}` : inr(0);
      $('[data-fixed-lands]')!.textContent = inr(lands);
      $('[data-fixed-note]')!.textContent = profile.fixedMonthly ? fixedTaxNote(profile.fixedMonthly) : '';
      $('[data-inhand]')!.textContent = inr(lands);
      $('[data-inhand-note]')!.textContent = 'every month';
      handyBox.dataset.handy = 'happy';
      $$<HTMLAnchorElement>('[data-share-link]').forEach((a) => (a.href = `${routes.share}?card=salary&inhand=${Math.round(lands)}`));
    } else if (profile.ctc !== lakhs || ownRegime !== regime) {
      lakhs = profile.ctc;
      // Jump straight to the user's number instead of counting up from the sample one
      shownMonthly = calcSalary(lakhs, ownRegime).inhand / 12;
      $('[data-inhand]')!.textContent = inr(shownMonthly);
      const regimeChanged = ownRegime !== regime;
      regime = ownRegime;
      render(regimeChanged);
    }
  }
</script>

<style>
  .muted {
    margin: 0;
    font-size: 16px;
    color: var(--ink-muted);
  }

  .eyebrow {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Header */
  .head {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .head__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 40px;
    letter-spacing: -0.03em;
  }

  /* CTC bar */
  .ctc {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 32px;
    padding: 22px 28px;
    border-radius: 28px;
    background: var(--mango);
    border: 3px solid var(--ink);
    box-shadow: 0 7px 0 var(--ink);
  }

  .ctc__value {
    display: flex;
    flex-direction: column;
    min-width: 220px;
  }

  .ctc__amount {
    font-weight: 800;
    font-size: 44px;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .ctc[hidden],
  [data-ctc-view][hidden],
  .fixed[hidden] {
    display: none;
  }

  .fixed {
    grid-column: span 7;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .fixed__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .fixed__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 24px;
  }

  .fixed__change {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-weight: 700;
    color: var(--violet);
  }

  .fixed__rows {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .fixed__rows > div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 14px;
  }

  .fixed__rows dt {
    font-weight: 600;
  }

  .fixed__rows dd {
    margin: 0;
    font-weight: 800;
  }

  .fixed__total {
    background: var(--paper-deep);
    font-size: 20px;
  }

  .fixed__note {
    margin: 0;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  /* Looks like the big number it replaced; the dashed line says it can be edited */
  .ctc__input {
    width: 9ch;
    min-width: 0;
    padding: 0;
    border: none;
    border-bottom: 3px dashed currentColor;
    border-radius: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    outline-offset: 4px;
  }

  .ctc__hint {
    font-weight: 700;
  }

  .ctc__hint[hidden] {
    display: none;
  }

  .ctc__per {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0;
  }

  .ctc__slider {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ctc__ticks {
    position: relative;
    height: 20px;
    font-size: 16px;
    font-weight: 700;
  }

  .ctc__ticks span {
    position: absolute;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .ctc__ticks span:first-child {
    transform: none;
  }

  .ctc__ticks span:last-child {
    transform: translateX(-100%);
  }

  .ctc__steppers {
    display: flex;
    gap: 8px;
  }

  .ctc__step {
    width: 52px;
    height: 52px;
    padding: 0;
    font-size: 24px;
    font-weight: 800;
  }

  /* Slider */
  .rng {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 44px;
    background: transparent;
    margin: 0;
    cursor: pointer;
  }

  .rng::-webkit-slider-runnable-track {
    height: 14px;
    border-radius: 99px;
    background: linear-gradient(to right, var(--ink) 0, var(--ink) var(--p), rgba(21, 19, 28, 0.14) var(--p));
    border: 2px solid var(--ink);
  }

  .rng::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 32px;
    height: 32px;
    margin-top: -11px;
    border-radius: 50%;
    background: var(--white);
    border: 3px solid var(--ink);
    box-shadow: 0 4px 0 var(--ink);
    transition: transform 0.25s cubic-bezier(0.34, 1.4, 0.5, 1);
  }

  .rng::-moz-range-track {
    height: 14px;
    border-radius: 99px;
    background: rgba(21, 19, 28, 0.14);
    border: 2px solid var(--ink);
  }

  .rng::-moz-range-progress {
    height: 14px;
    border-radius: 99px;
    background: var(--ink);
  }

  .rng::-moz-range-thumb {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--white);
    border: 3px solid var(--ink);
  }

  .rng:hover::-webkit-slider-thumb,
  .rng:focus-visible::-webkit-slider-thumb,
  .rng:active::-webkit-slider-thumb {
