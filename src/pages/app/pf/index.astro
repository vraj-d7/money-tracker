---
import AppShell from '../../../layouts/AppShell.astro';
import Handy from '../../../components/Handy.astro';
import { routes } from '../../../lib/routes';
import { inr } from '../../../lib/format';
import { PF } from '../../../data/demo-tools';

const { you, employer, interest } = PF.parts;
const share = (n: number) => ((n / PF.balance) * 100).toFixed(1) + '%';
const cell = (n: number) => (n ? inr(n) : '—');
const startTerm = 'er';
---

<AppShell title="PF corner" active="pf">
  <header class="head">
    <h1>PF corner</h1>
  </header>

  <div class="alert-slot" data-pf>
    <section class="alert" role="alert" data-alert>
      <div class="alert__main">
        <span class="alert__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v5M12 16.5v.5"></path><path d="M10.3 3.9L2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path></svg>
        </span>
        <div class="alert__text">
          <span class="alert__title">{PF.missing.month.split(' ')[0]}’s PF deposit is missing</span>
          <span>
            {inr(PF.missing.yourShare)} was cut from your salary, and neither it nor your employer’s share has reached your PF account. Employers should
            deposit by the 15th of the next month.
          </span>
        </div>
      </div>
      <div class="alert__actions">
        <a href={routes.hrEmail} class="btn btn--mango alert__btn">Draft email to HR</a>
        <button type="button" class="alert__dismiss" data-dismiss>It’s sorted now</button>
      </div>
    </section>
    <p class="ok" data-ok hidden>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10"></path></svg>
      All deposits look on time. We’ll keep watching.
      <button type="button" class="ok__undo" data-undo>Undo</button>
    </p>
  </div>

  <section class="balance" aria-label="PF balance">
    <div class="balance__top">
      <div>
        <span class="eyebrow">Your PF balance</span>
        <p class="num balance__amount">{inr(PF.balance)}</p>
        <span class="balance__note">Estimate from your passbook · locked savings, still yours</span>
      </div>
      <Handy mood="chill" size={90} decorative />
    </div>
    <div class="split-bar" role="img" aria-label={`Your share ${inr(you)}, employer share ${inr(employer)}, interest ${inr(interest)}`}>
      <div style={`width: ${share(you)}; background: var(--paper)`}></div>
      <div style={`width: ${share(employer)}; background: var(--mango)`}></div>
      <div style={`width: ${share(interest)}; background: var(--mint)`}></div>
    </div>
    <div class="num legend">
      {
        [
          ['You', you, 'var(--paper)'],
          ['Employer', employer, 'var(--mango)'],
          ['Interest', interest, 'var(--mint)'],
        ].map(([label, amt, color]) => (
          <span class="legend__item">
            <span class="legend__key">
              <span class="legend__swatch" style={`background: ${color}`} />
              {label}
            </span>
            <span class="legend__amt">{inr(amt as number)}</span>
          </span>
        ))
      }
    </div>
  </section>

  <section class="card passbook" aria-labelledby="pb-h">
    <h2 id="pb-h" class="card__title">Your passbook, decoded</h2>
    <div class="table-wrap">
      <table class="num">
        <thead>
          <tr>
            <th scope="col">Month</th>
            <th scope="col">You</th>
            <th scope="col">Employer</th>
            <th scope="col">Pension</th>
          </tr>
        </thead>
        <tbody>
          {
            PF.passbook.map((r) => (
              <tr class:list={[`row--${r.kind}`]} data-row={r.kind}>
                <th scope="row">
                  {r.month}
                  <span class="row__note" data-note data-sorted-note={r.sortedNote}>
                    {r.note}
                  </span>
                </th>
                <td data-amt={r.kind === 'miss' ? cell(r.you) : undefined}>{r.kind === 'ok' ? cell(r.you) : '—'}</td>
                <td data-amt={r.kind === 'miss' ? cell(r.er) : undefined}>{r.kind === 'ok' ? cell(r.er) : '—'}</td>
                <td data-amt={r.kind === 'miss' ? cell(r.eps) : undefined}>{r.kind === 'ok' ? cell(r.eps) : '—'}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="terms" role="group" aria-label="Explain a column">
      {
        Object.entries(PF.terms).map(([k, t]) => (
          <button type="button" class="term" data-term={k} data-text={t.text} aria-pressed={k === startTerm ? 'true' : 'false'}>
            What’s “{t.label}”?
          </button>
        ))
      }
    </div>
    <p class="term-text" aria-live="polite" data-term-text>{PF.terms[startTerm].text}</p>
  </section>

  <section class="move" aria-labelledby="move-h">
    <div class="move__top">
      <div>
        <h2 id="move-h" class="move__title">Switching jobs? Move your PF</h2>
        <p class="muted">Transfer, don’t withdraw. Withdrawing before 5 years of service can be taxed.</p>
      </div>
      <a href={routes.pfTransfer} class="btn move__cta">Open the step-by-step guide</a>
    </div>
    <ol class="move__steps">
      {
        PF.move.map((m, i) => (
          <li class="mstep">
            <span class="num mstep__n" aria-hidden="true">
              {i + 1}
            </span>
            <span class="mstep__title">{m.title}</span>
            <span class="muted">{m.body}</span>
          </li>
        ))
      }
    </ol>
    <p class="muted">
      Pension (EPS) is 8.33% of wages up to ₹15,000, so ₹1,250 a month; the rest of the employer’s 12% goes to your PF. Rules can change; check
      the EPFO portal. Not financial advice.
    </p>
  </section>
</AppShell>

<script>
  import { readLocal, writeLocal } from '../../../scripts/local-state';

  const root = document.querySelector<HTMLElement>('[data-pf]')!;
  const alertBox = root.querySelector<HTMLElement>('[data-alert]')!;
  const ok = root.querySelector<HTMLElement>('[data-ok]')!;
  const missRow = document.querySelector<HTMLElement>('[data-row="miss"]');

  // "It's sorted now" hides the alert and marks September as deposited
  function render(sorted: boolean) {
    alertBox.hidden = sorted;
    ok.hidden = !sorted;
    if (!missRow) return;
    missRow.classList.toggle('row--miss', !sorted);
    missRow.classList.toggle('row--ok', sorted);
    const note = missRow.querySelector<HTMLElement>('[data-note]')!;
    note.dataset.original ??= note.textContent ?? '';
    note.textContent = sorted ? note.dataset.sortedNote! : note.dataset.original;
    missRow.querySelectorAll<HTMLElement>('[data-amt]').forEach((td) => (td.textContent = sorted ? td.dataset.amt! : '—'));
  }

  root.querySelector('[data-dismiss]')!.addEventListener('click', () => {
    writeLocal('pf:sorted', true);
    render(true);
  });
  root.querySelector('[data-undo]')!.addEventListener('click', () => {
    writeLocal('pf:sorted', false);
    render(false);
  });
  render(readLocal('pf:sorted', false));

  // Column explainer
  const text = document.querySelector('[data-term-text]')!;
  document.querySelectorAll<HTMLElement>('[data-term]').forEach((b) =>
    b.addEventListener('click', () => {
      document.querySelectorAll('[data-term]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      text.textContent = b.dataset.text!;
    }),
  );
</script>

<style>
  .muted {
    margin: 0;
    font-size: 16px;
    line-height: 1.45;
    color: var(--ink-muted);
  }

  .head {
    grid-column: 1 / -1;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 40px;
    letter-spacing: -0.03em;
  }

  .eyebrow {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .alert-slot {
    grid-column: 1 / -1;
  }

  .alert {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
    padding: 20px 24px;
    border-radius: 24px;
    background: var(--danger-bg);
    border: 3px solid var(--coral);
    box-shadow: 0 6px 0 var(--ink);
  }

  .alert[hidden],
  .ok[hidden] {
    display: none;
  }

  .alert__main {
    flex: 1;
    min-width: 260px;
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .alert__icon {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: var(--coral);
    border: 2.5px solid var(--ink);
    box-sizing: border-box;
    animation: pulse 1.8s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(255, 107, 91, 0.5);
    }
    50% {
      box-shadow: 0 0 0 8px rgba(255, 107, 91, 0);
    }
  }

  .alert__text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    line-height: 1.45;
  }

  .alert__title {
    font-weight: 800;
  }

  .alert__actions {
    flex: none;
    display: grid;
    grid-template-columns: repeat(2, 180px);
    gap: 10px;
  }

  .alert__btn {
    min-height: 48px;
    border-radius: 14px;
    font-weight: 800;
  }

  .alert__dismiss {
    min-height: 48px;
    border-radius: 14px;
    background: transparent;
    border: 2.5px solid var(--ink);
    color: var(--ink);
    font-weight: 700;
    font-size: 16px;
    cursor: pointer;
  }

  .ok {
    margin: 0;
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 14px 18px;
    border-radius: 16px;
    background: #e2f8ef;
    color: #0a6b4d;
    font-weight: 700;
  }

  .ok__undo {
    margin-left: auto;
    min-height: 40px;
    padding: 0 8px;
    background: none;
    border: none;
    color: var(--violet);
    font-weight: 700;
    font-size: 16px;
    text-decoration: underline;
    cursor: pointer;
  }

  .balance {
    grid-column: span 5;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 28px;
    border-radius: 26px;
    background: #ffe7b0;
    border: 3px solid var(--ink);
    box-shadow: 0 6px 0 var(--ink);
  }

  .balance__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }

  .balance__amount {
    margin: 2px 0 0;
    font-weight: 800;
    font-size: 56px;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .balance__note {
    font-weight: 600;
  }

  .split-bar {
    display: flex;
    height: 18px;
    border-radius: 99px;
    overflow: hidden;
    border: 2px solid var(--ink);
  }

  .split-bar div + div {
    border-left: 2px solid var(--ink);
  }

  .legend {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    font-weight: 700;
  }

  .legend__item {
    display: flex;
    flex-direction: column;
  }

  .legend__key {
    display: inline-flex;
    gap: 4px;
    align-items: center;
  }

  .legend__swatch {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    border: 1.5px solid var(--ink);
  }

  .legend__amt {
    font-weight: 800;
  }

  .card {
    padding: 24px;
    border-radius: 24px;
    background: var(--white);
    border: 2.5px solid var(--ink);
    box-shadow: 0 6px 0 var(--ink);
  }

  .card__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
  }

  .passbook {
    grid-column: span 7;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 16px;
  }

  thead th {
    padding: 10px 8px;
    font-weight: 700;
    text-align: right;
    color: var(--ink-muted);
  }

  thead th:first-child {
    text-align: left;
  }

  tbody tr {
    border-top: 2px dashed var(--line);
  }

  tbody th {
    padding: 12px 8px;
    text-align: left;
    font-weight: 800;
  }

  tbody td {
    padding: 12px 8px;
    text-align: right;
    font-weight: 700;
  }

  .row__note {
    display: block;
    font-weight: 700;
    color: #0a6b4d;
  }

  .row--miss {
    background: var(--danger-bg);
  }

  .row--miss .row__note {
    color: var(--danger);
  }

  .row--wait .row__note {
    color: #8a5800;
  }

  .terms {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .term {
    min-height: 44px;
    padding: 6px 12px;
    border-radius: 99px;
    background: transparent;
    border: 2px solid var(--ink);
    color: var(--ink);
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
  }

  .term[aria-pressed='true'] {
    background: var(--mango);
  }

  .term-text {
    margin: 0;
    padding: 12px 14px;
    border-radius: 14px;
    background: #eee9ff;
    line-height: 1.5;
  }

  .move {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .move__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
  }

  .move__title {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 26px;
  }

  .move__cta {
    flex: none;
    font-weight: 800;
  }

  .move__steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
  }

  .mstep {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
    border-radius: 22px;
    background: var(--white);
    border: 2.5px solid var(--ink);
  }

  .mstep__n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--mango);
    border: 2.5px solid var(--ink);
    box-sizing: border-box;
    font-weight: 800;
  }

  .mstep__title {
    font-weight: 800;
  }

  @media (max-width: 1279px) {
    .balance,
    .passbook {
      grid-column: 1 / -1;
    }

    .move__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 1023px) {
    .move__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .alert {
      padding: 18px;
      gap: 16px;
    }

    .alert__main {
      min-width: 0;
    }

    .alert__actions {
      width: 100%;
      grid-template-columns: minmax(0, 1fr);
    }

    .balance {
      padding: 20px;
    }

    .balance__amount {
      font-size: 44px;
    }

    .move__top {
      flex-direction: column;
      align-items: stretch;
    }

    .move__steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
