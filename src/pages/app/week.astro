---
import AppShell from '../../layouts/AppShell.astro';
import { routes } from '../../lib/routes';
import { inr } from '../../lib/format';
import { CATEGORY_COLORS, WEEK, weekByCategory, weekSpent, type SpendCategory } from '../../data/demo-week';

const under = WEEK.plan - weekSpent;
const filters: ('all' | SpendCategory)[] = ['all', 'Food', 'Travel', 'Fun', 'Other'];
---

<AppShell title="This week’s spends" active="home">
  <header class="head">
    <a href={routes.home} class="back">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"></path></svg>
      Back to Home
    </a>
    <h1 class="num" data-week-h1>This week: {inr(weekSpent)} of {inr(WEEK.plan)}</h1>
    <p class="muted">
      <span data-week-sub>{WEEK.range} · {under >= 0 ? `${inr(under)} under plan` : `${inr(-under)} over plan`}</span> <span class="sample-tag" data-week-tag>Sample</span>
    </p>
    <a href={routes.addSpend} class="btn btn--mango head__add">Add a spend</a>
  </header>

  <div class="list" data-week>
    <div class="filters" role="group" aria-label="Filter by category">
      {
        filters.map((f) => (
          <button type="button" class="filter" data-filter={f} aria-pressed={f === 'all' ? 'true' : 'false'}>
            {f === 'all' ? 'All' : f}
          </button>
        ))
      }
    </div>

    <template id="day-row">
      <section class="day" data-day>
        <h2 class="num day__head">
          <span data-day-label></span>
          <span data-day-total></span>
        </h2>
      </section>
    </template>
    <template id="spend-row">
      <div class="spend" data-cat>
        <span class="spend__swatch" aria-hidden="true" data-swatch></span>
        <span class="spend__text">
          <span class="spend__what" data-what></span>
          <span class="spend__meta" data-meta></span>
        </span>
        <span class="num spend__amt" data-amt></span>
        <button type="button" class="spend__remove" data-remove hidden>
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        </button>
      </div>
    </template>
    {
      WEEK.days.map((d) => (
        <section class="day" aria-label={d.label} data-day>
          <h2 class="num day__head">
            <span>{d.label}</span>
            <span data-day-total>{inr(d.spends.reduce((s, x) => s + x.amount, 0))}</span>
          </h2>
          {d.spends.map((s) => (
            <div class="spend" data-cat={s.category} data-amount={s.amount}>
              <span class="spend__swatch" aria-hidden="true" style={`background: ${CATEGORY_COLORS[s.category]}`} />
              <span class="spend__text">
                <span class="spend__what">{s.what}</span>
                <span class="spend__meta">
                  {s.category} · {s.method}
                </span>
              </span>
              <span class="num spend__amt">{inr(s.amount)}</span>
            </div>
          ))}
        </section>
      ))
    }
  </div>

  <aside class="side">
    <section class="card" aria-labelledby="cat-h">
      <h2 id="cat-h" class="card__title">By category</h2>
      {
        weekByCategory.map((c) => {
          const pct = Math.round((c.amount / weekSpent) * 100);
          return (
            <div class="split" data-split={c.category}>
              <div class="num split__top">
                <b>{c.category}</b>
                <span data-split-text>
                  {inr(c.amount)} · {pct}%
                </span>
              </div>
              <div class="split__track" aria-hidden="true">
                <div data-split-bar style={`width: ${pct}%; background: ${CATEGORY_COLORS[c.category]}`} />
              </div>
            </div>
          );
        })
      }
    </section>
    <p class="note" data-week-note>{inr(under)} under plan. Move it to your Emergency jar on Sunday?</p>
    <p class="muted" data-week-source>Sample spends. <a href={routes.scan}>Scan a statement</a> to see yours.</p>
  </aside>
</AppShell>

<script>
  import { inr } from '../../lib/format';
  import { CATEGORY_COLORS } from '../../data/demo-week';
  import { loadTransactions, realWeek, removeSpend } from '../../scripts/scan-store';

  const root = document.querySelector<HTMLElement>('[data-week]');

  // Spends from the user's own statement, once one has been scanned on this device
  const week = realWeek();
  if (root && week) {
    const under = week.plan - week.spent;
    document.querySelector('[data-week-h1]')!.textContent = `${week.title}: ${inr(week.spent)} of ${inr(week.plan)}`;
    document.querySelector('[data-week-sub]')!.textContent =
      `${week.range} · ${under >= 0 ? `${inr(under)} under plan` : `${inr(-under)} over plan`}`;
    document.querySelector<HTMLElement>('[data-week-tag]')!.hidden = true;

    root.querySelectorAll('[data-day]').forEach((d) => d.remove());
    const dayTpl = root.querySelector<HTMLTemplateElement>('#day-row')!;
    const spendTpl = root.querySelector<HTMLTemplateElement>('#spend-row')!;
    for (const d of week.days) {
      const day = (dayTpl.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
      day.setAttribute('aria-label', d.label);
      day.querySelector('[data-day-label]')!.textContent = d.label;
      day.querySelector('[data-day-total]')!.textContent = inr(d.spends.reduce((s, x) => s + x.amount, 0));
      for (const s of d.spends) {
        const row = (spendTpl.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
        row.dataset.cat = s.category;
        row.dataset.amount = String(s.amount);
        row.querySelector<HTMLElement>('[data-swatch]')!.style.background = CATEGORY_COLORS[s.category];
        row.querySelector('[data-what]')!.textContent = s.what;
        row.querySelector('[data-meta]')!.textContent = `${s.category} · ${s.method}`;
        row.querySelector('[data-amt]')!.textContent = inr(s.amount);
        if (s.id) {
          const remove = row.querySelector<HTMLButtonElement>('[data-remove]')!;
          remove.hidden = false;
          remove.setAttribute('aria-label', `Remove ${s.what}, ${inr(s.amount)}`);
          remove.addEventListener('click', () => {
            removeSpend(s.id!);
            window.location.reload();
          });
        }
        day.append(row);
      }
      root.append(day);
    }

    for (const c of week.byCategory) {
      const pct = week.spent ? Math.round((c.amount / week.spent) * 100) : 0;
      const split = document.querySelector(`[data-split="${c.category}"]`)!;
      split.querySelector('[data-split-text]')!.textContent = `${inr(c.amount)} · ${pct}%`;
      split.querySelector<HTMLElement>('[data-split-bar]')!.style.width = `${pct}%`;
    }
    const note = document.querySelector<HTMLElement>('[data-week-note]')!;
    note.hidden = under <= 0;
    note.textContent = `${inr(under)} under plan. Move it to your Emergency jar on Sunday?`;
    document.querySelector('[data-week-source]')!.textContent = loadTransactions().length
      ? 'From your last statement scan and any spends you added. Rent, SIPs, EMIs and bills are left out: your jars already cover those.'
      : 'Spends you added yourself. Scan a statement to fill in the rest.';
  }

  if (root) {
    root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const f = btn.dataset.filter!;
        root.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        // Hide spends outside the filter, then days left empty, and re-total each day
        root.querySelectorAll<HTMLElement>('[data-day]').forEach((day) => {
          let total = 0;
          day.querySelectorAll<HTMLElement>('[data-cat]').forEach((s) => {
            const show = f === 'all' || s.dataset.cat === f;
            s.hidden = !show;
            if (show) total += Number(s.dataset.amount);
          });
          day.hidden = total === 0;
          day.querySelector('[data-day-total]')!.textContent = inr(total);
        });
      }),
    );
  }
</script>

<style>
  .muted {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .head {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-weight: 700;
    text-decoration: none;
    color: var(--violet);
  }

  .head__add {
    align-self: flex-start;
    margin-top: 6px;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 40px;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .list {
    grid-column: span 8;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .filter {
    min-height: 44px;
    padding: 0 16px;
    border-radius: 99px;
    background: var(--white);
    border: 2.5px solid var(--ink);
    color: var(--ink);
    font-weight: 700;
    font-size: 16px;
    cursor: pointer;
  }

  .filter[aria-pressed='true'] {
    background: var(--mango);
    box-shadow: 0 3px 0 var(--ink);
  }

  .day {
    padding: 8px 20px;
    border-radius: 28px;
    background: var(--white);
    border: 2.5px solid var(--ink);
    box-shadow: 0 6px 0 var(--ink);
  }

  .day[hidden],
  .spend[hidden] {
    display: none;
  }

  .day__head {
    display: flex;
    justify-content: space-between;
    margin: 12px 0 4px;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .spend {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 60px;
    padding: 8px 0;
    box-sizing: border-box;
    border-top: 2px dashed var(--line);
  }

  .spend__swatch {
    flex: none;
    width: 14px;
    height: 14px;
    border-radius: 4px;
    border: 2px solid var(--ink);
    box-sizing: border-box;
  }

  .spend__text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .spend__what {
    font-weight: 700;
  }

  .spend__meta {
    color: var(--ink-muted);
  }

  .spend__amt {
    font-weight: 800;
  }

  .spend__remove {
    flex: none;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 99px;
    background: none;
    color: var(--ink-muted);
    cursor: pointer;
  }

  .spend__remove:hover {
    color: var(--danger);
  }

  .spend__remove[hidden] {
    display: none;
  }

  .side {
    grid-column: span 4;
    align-self: start;
    position: sticky;
    top: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    border-radius: 28px;
    background: var(--white);
    border: 2.5px solid var(--ink);
    box-shadow: 0 6px 0 var(--ink);
  }

  .card__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
  }

  .split {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .split__top {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }

  .split__track {
    height: 12px;
    border-radius: 99px;
    background: #f1e7d3;
    overflow: hidden;
  }

  .split__track div {
    height: 100%;
    border-radius: 99px;
  }

  .note {
    margin: 0;
    padding: 14px 16px;
    border-radius: 16px;
    background: #e2f8ef;
    color: #0a6b4d;
    font-weight: 700;
  }

  /* Tablet and phone: the category summary comes first, the list after */
  @media (max-width: 1023px) {
    .side {
      position: static;
      order: 1;
    }

    .list {
      order: 2;
    }
  }

  @media (max-width: 639px) {
    .day {
      padding: 4px 16px;
      border-radius: 24px;
    }
  }
</style>
