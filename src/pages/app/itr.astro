---
import AppShell from '../../layouts/AppShell.astro';
import Handy from '../../components/Handy.astro';
import Checklist from '../../components/Checklist.astro';
import { inr } from '../../lib/format';
import { compareRegimes } from '../../lib/salary';
import { FORM16_LINES, ITR_STEPS } from '../../data/demo-tools';

const cmp = compareRegimes(12);
const regimeTag = `${cmp.winner === 'new' ? 'New' : 'Old'} regime saves ${inr(cmp.monthlyGap)}/mo`;
const steps = ITR_STEPS.map((s) => ({ title: s.title, body: s.body, tag: s.regimeTag ? regimeTag : undefined }));
const defaultDone = [0, 2];
const startOpen = 4;
---

<AppShell title="Your first ITR" active="itr">
  <header class="head">
    <h1>Your first ITR</h1>
  </header>

  <section class="hero">
    <div class="hero__text">
      <p class="hero__title">Filing your taxes, minus the panic</p>
      <p class="num hero__meta">FY 2026-27 · usually due 31 Jul 2027</p>
      <div class="hero__bar" role="progressbar" aria-label="Checklist progress" aria-valuemin="0" aria-valuemax={steps.length} aria-valuenow={defaultDone.length}>
        <div data-checklist-bar="itr" style={`width: ${(defaultDone.length / steps.length) * 100}%`}></div>
      </div>
      <span class="num hero__count"><span data-checklist-count="itr">{defaultDone.length}</span> of {steps.length} done</span>
    </div>
    <div class="hero__handy" data-itr-mood="chill">
      <span data-mood="chill"><Handy mood="chill" size={130} decorative /></span>
      <span data-mood="happy"><Handy mood="happy" size={130} decorative /></span>
      <span data-mood="cheer"><Handy mood="cheer" size={130} decorative /></span>
    </div>
  </section>

  <section class="steps" aria-labelledby="steps-h">
    <h2 id="steps-h" class="section-title">Step by step</h2>
    <Checklist storageKey="itr" steps={steps} defaultDone={defaultDone} label="ITR checklist" />
  </section>

  <section class="form16" aria-labelledby="f16-h">
    <div class="form16__intro">
      <h2 id="f16-h" class="section-title">Form 16, line by line</h2>
      <p class="muted">Form 16 is the tax certificate your employer gives you. Click a line.</p>
    </div>
    <div class="paper">
      <div class="paper__head">
        <span class="paper__part">PART B · SALARY DETAILS</span>
        <span class="num paper__eg">₹12L CTC example</span>
      </div>
      {
        FORM16_LINES.map((l, i) => (
          <div class:list={['line', { 'line--open': i === startOpen }]} data-line>
            <button type="button" class="line__btn" aria-expanded={i === startOpen ? 'true' : 'false'} aria-controls={`f16-${i}`}>
              <span class="line__code">{l.code}</span>
              <span class="line__label">{l.label}</span>
              <span class="num line__amt">{inr(l.amount)}</span>
            </button>
            <div class="line__panel">
              <div class="line__clip">
                <p id={`f16-${i}`} class="line__explain">
                  {l.explain}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
    <p class="muted">Dates and forms follow current income-tax rules and can change; check the official portal before you file. Not tax advice.</p>
  </section>
</AppShell>

<script>
  // Handy cheers you on as the checklist fills up
  document.addEventListener('checklist:change', (e) => {
    const { key, done, total } = (e as CustomEvent<{ key: string; done: number; total: number }>).detail;
    if (key !== 'itr') return;
    document.querySelector<HTMLElement>('[data-itr-mood]')!.dataset.itrMood = done === total ? 'cheer' : done >= 3 ? 'happy' : 'chill';
  });

  // Form 16: one line open at a time
  const lines = [...document.querySelectorAll<HTMLElement>('[data-line]')];
  lines.forEach((line) =>
    line.querySelector('button')!.addEventListener('click', () => {
      const opening = !line.classList.contains('line--open');
      lines.forEach((l) => {
        const on = l === line && opening;
        l.classList.toggle('line--open', on);
        l.querySelector('button')!.setAttribute('aria-expanded', String(on));
      });
    }),
  );
</script>

<style>
  .muted {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .head {
    grid-column: 1 / -1;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 40px;
    letter-spacing: -0.03em;
  }

  .section-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
  }

  .hero {
    grid-column: 1 / -1;
    display: flex;
    gap: 32px;
    align-items: center;
    padding: 28px 32px;
    border-radius: 32px;
    background: #ffe7b0;
    border: 3px solid var(--ink);
    box-shadow: 0 6px 0 var(--ink);
  }

  .hero__text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 36px;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .hero__meta {
    margin: 0;
    font-weight: 600;
  }

  .hero__bar {
    max-width: 560px;
    height: 14px;
    border-radius: 99px;
    background: rgba(21, 19, 28, 0.15);
    border: 2px solid var(--ink);
    overflow: hidden;
  }

  .hero__bar div {
    height: 100%;
    background: var(--mango);
    transition: width 0.5s cubic-bezier(0.3, 1.3, 0.5, 1);
  }

  .hero__count {
    font-weight: 800;
  }

  .hero__handy {
    line-height: 0;
  }

  .hero__handy > span {
    display: none;
  }

  .hero__handy[data-itr-mood='chill'] > [data-mood='chill'],
  .hero__handy[data-itr-mood='happy'] > [data-mood='happy'],
  .hero__handy[data-itr-mood='cheer'] > [data-mood='cheer'] {
    display: block;
  }

  .steps {
    grid-column: span 6;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .form16 {
    grid-column: span 6;
    position: sticky;
    top: 32px;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .form16__intro {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .paper {
    padding: 8px;
    border-radius: 22px;
    background: #fffdf7;
    border: 2.5px solid var(--ink);
    box-shadow: 0 6px 0 var(--ink);
  }

  .paper__head {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 10px 10px;
    border-bottom: 2px dashed var(--line);
    color: var(--ink-muted);
    font-weight: 700;
  }

  .paper__part {
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .line__btn {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    min-height: 52px;
    padding: 8px 10px;
    border-radius: 14px;
    background: transparent;
    border: none;
    color: var(--ink);
    text-align: left;
    font-size: 16px;
    cursor: pointer;
  }

  .line__btn:hover,
  .line--open .line__btn {
    background: var(--cream);
  }

  .line__code {
    flex: none;
    min-width: 44px;
    padding: 3px 6px;
    box-sizing: border-box;
    border-radius: 8px;
    background: var(--paper-deep);
    font-weight: 800;
    text-align: center;
    color: var(--ink-muted);
  }

  .line__label {
    flex: 1;
    min-width: 0;
    font-weight: 700;
  }

  .line__amt {
    font-weight: 800;
  }

  /* Slides open by growing from no height to the text's height. The button's aria-expanded drives it. */
  .line__panel {
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    opacity: 0;
    transition:
      grid-template-rows 0.3s ease,
      opacity 0.3s ease,
      visibility 0.3s;
  }

  [aria-expanded='true'] + .line__panel {
    grid-template-rows: 1fr;
    visibility: visible;
    opacity: 1;
  }

  .line__clip {
    min-height: 0;
    overflow: hidden;
  }

  .line__explain {
    margin: 2px 10px 10px;
    padding: 12px 14px;
    border-radius: 14px;
    background: #eee9ff;
    line-height: 1.5;
  }

  @media (max-width: 1279px) {
    .steps,
    .form16 {
      grid-column: 1 / -1;
    }

    .form16 {
      position: static;
    }
  }

  @media (max-width: 639px) {
    .hero {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 12px;
      padding: 20px;
    }

    .hero__handy :global(.handy) {
      width: 84px !important;
      height: 84px !important;
    }

    .hero__title {
      font-size: 28px;
    }
  }
</style>
