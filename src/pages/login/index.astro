---
// Sign up / Log in with a mobile number and a 6-digit code.
// No backend yet: no text is actually sent, and any 6-digit code is accepted.
import HandySplit from '../../layouts/HandySplit.astro';
import Logo from '../../components/Logo.astro';
import { routes } from '../../lib/routes';
import { backendOn } from '../../scripts/backend';

const checks = [
  'We never ask for your bank password',
  'Your statements are deleted after each scan',
  'Free forever for the salary explainer',
];
---

<HandySplit title="Sign up or log in" bubble="Hi! I’m Handy. I explain your salary, no jargon." moods={['happy', 'cheer', 'chai']}>
  {
    // With real accounts, phone codes aren't live yet, so sign-in happens by email
    backendOn && (
      <script is:inline define:vars={{ to: routes.emailAuth }}>
        location.replace(to + location.search);
      </script>
    )
  }
  <ul slot="aside-foot" class="checks">
    {
      checks.map((c) => (
        <li>
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10" /></svg>
          {c}
        </li>
      ))
    }
  </ul>

  <div class="auth" data-auth data-mode="signup" data-step="phone">
    <div class="auth__inner">
      <a href={routes.landing} class="auth__logo" aria-label="Inhandy home"><Logo size={36} /></a>

      <div class="tabs" role="tablist" aria-label="Sign up or log in">
        <button type="button" role="tab" class="tabs__tab" data-mode-tab="signup" aria-selected="true">Sign up</button>
        <button type="button" role="tab" class="tabs__tab" data-mode-tab="login" aria-selected="false">Log in</button>
      </div>

      <form class="step pop-in" data-step-panel="phone" novalidate>
        <h1 data-title>Salary aa gayi? Let’s make a plan.</h1>
        <p class="lead" data-sub>Takes a minute. Just your number and your name.</p>

        <div class="group">
          <label for="auth-phone" class="group__label">Mobile number</label>
          <div class="field">
            <span class="field__prefix">+91</span>
            <span class="field__divider" aria-hidden="true"></span>
            <input id="auth-phone" type="tel" inputmode="numeric" autocomplete="tel-national" placeholder="98765 43210" aria-describedby="phone-help" />
          </div>
          <p class="help" id="phone-help" data-phone-help>We’ll text you a 6-digit code. No spam, ever.</p>
        </div>

        <div class="group" data-signup-only>
          <label for="auth-name" class="group__label">What should Handy call you?</label>
          <div class="field"><input id="auth-name" type="text" autocomplete="given-name" placeholder="First name" /></div>
        </div>

        <button type="submit" class="btn btn--mango btn--lg btn--block">
          Send code
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </button>

        <div class="or" aria-hidden="true"><span></span>or<span></span></div>

        <a href={routes.emailAuth} class="btn btn--block">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18v12H3zM3 7l9 7 9-7"></path></svg>
          Continue with email
        </a>

        <p class="lead small">
          By continuing you agree to our <a href={routes.legal} class="link">Terms</a> and <a href={routes.legal} class="link">Privacy policy</a>.
        </p>
      </form>

      <form class="step pop-in" data-step-panel="otp" hidden novalidate>
        <h1>Enter the code</h1>
        <p class="lead num">
          Sent to +91 <span data-phone-shown></span>.
          <button type="button" class="text-btn" data-change-number>Change number</button>
        </p>
        <p class="test-note">
          {backendOn ? <>Phone codes aren’t live yet. To sign in for real, <a href={routes.emailAuth}>continue with email</a>. Or type any 6 digits to try the app.</> : 'Test mode: no text is sent yet. Type any 6 digits to continue.'}
        </p>
        <fieldset class="otp-group">
          <legend class="group__label">6-digit code</legend>
          <div class="otp" data-otp>
            {
              Array.from({ length: 6 }, (_, i) => (
                <input class="otp__digit num" type="text" inputmode="numeric" maxlength="1" autocomplete={i === 0 ? 'one-time-code' : 'off'} aria-label={`Digit ${i + 1} of 6`} />
              ))
            }
          </div>
          <p class="help help--error" data-otp-error hidden>Enter all 6 digits.</p>
        </fieldset>
        <p class="lead num">
          Didn’t get it?{' '}
          <span data-resend-wait>Resend in <span data-countdown>0:30</span></span>
          <button type="button" class="text-btn" data-resend-btn hidden>Resend code</button>
        </p>
        <button type="submit" class="btn btn--mango btn--lg btn--block">
          <span data-verify-label>Verify and continue</span>
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </button>
      </form>
    </div>
  </div>
</HandySplit>

<script>
  import { routes } from '../../lib/routes';
  import { saveProfile } from '../../scripts/profile-store';

  const root = document.querySelector<HTMLElement>('[data-auth]')!;
  const phoneForm = root.querySelector<HTMLFormElement>('[data-step-panel="phone"]')!;
  const otpForm = root.querySelector<HTMLFormElement>('[data-step-panel="otp"]')!;
  const phoneInput = root.querySelector<HTMLInputElement>('#auth-phone')!;
  const nameInput = root.querySelector<HTMLInputElement>('#auth-name')!;
  const digits = [...root.querySelectorAll<HTMLInputElement>('.otp__digit')];
  const bubble = document.querySelector('[data-bubble]')!;
  const handyBox = document.querySelector<HTMLElement>('[data-handy-box]')!;
  let timer = 0;

  const COPY = {
    signup: {
      title: 'Salary aa gayi? Let’s make a plan.',
      sub: 'Takes a minute. Just your number and your name.',
      bubble: 'Hi! I’m Handy. I explain your salary, no jargon.',
      mood: 'happy',
      verify: 'Verify and continue',
    },
    login: {
      title: 'Welcome back',
      sub: 'Log in with the number you signed up with.',
      bubble: 'Arre, you’re back! Missed you.',
      mood: 'cheer',
      verify: 'Verify and log in',
    },
  } as const;

  type Mode = keyof typeof COPY;

  function setMode(mode: Mode) {
    root.dataset.mode = mode;
    root.querySelectorAll<HTMLElement>('[data-mode-tab]').forEach((t) => t.setAttribute('aria-selected', String(t.dataset.modeTab === mode)));
    const c = COPY[mode];
    root.querySelector('[data-title]')!.textContent = c.title;
    root.querySelector('[data-sub]')!.textContent = c.sub;
    root.querySelector('[data-verify-label]')!.textContent = c.verify;
    root.querySelector<HTMLElement>('[data-signup-only]')!.hidden = mode !== 'signup';
    showStep('phone');
  }

  function showStep(step: 'phone' | 'otp') {
    const mode = root.dataset.mode as Mode;
    root.dataset.step = step;
    phoneForm.hidden = step !== 'phone';
    otpForm.hidden = step !== 'otp';
    bubble.textContent = step === 'otp' ? 'Check your messages. I’ll wait here with my chai.' : COPY[mode].bubble;
    handyBox.dataset.handy = step === 'otp' ? 'chai' : COPY[mode].mood;
    window.clearInterval(timer);
  }

  // Resend countdown on the code step
  const wait = root.querySelector<HTMLElement>('[data-resend-wait]')!;
  const resendBtn = root.querySelector<HTMLButtonElement>('[data-resend-btn]')!;

  function startCountdown() {
    let left = 30;
    wait.hidden = false;
    resendBtn.hidden = true;
    const tick = () => {
      if (left <= 0) {
        window.clearInterval(timer);
        wait.hidden = true;
        resendBtn.hidden = false;
        return;
      }
      root.querySelector('[data-countdown]')!.textContent = `0:${String(left).padStart(2, '0')}`;
      left--;
    };
    window.clearInterval(timer);
    tick();
    timer = window.setInterval(tick, 1000);
  }

  resendBtn.addEventListener('click', startCountdown);

  root.querySelectorAll<HTMLElement>('[data-mode-tab]').forEach((tab) =>
    tab.addEventListener('click', () => setMode(tab.dataset.modeTab as Mode)),
  );

  // Format as "98765 43210" while typing
  phoneInput.addEventListener('input', () => {
    const d = phoneInput.value.replace(/\D/g, '').slice(0, 10);
    phoneInput.value = d.length > 5 ? `${d.slice(0, 5)} ${d.slice(5)}` : d;
  });

  phoneForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const help = root.querySelector<HTMLElement>('[data-phone-help]')!;
    const d = phoneInput.value.replace(/\D/g, '');
    if (!/^[6-9]\d{9}$/.test(d)) {
      help.textContent = 'Enter a 10-digit Indian mobile number.';
      help.classList.add('help--error');
      phoneInput.focus();
      return;
    }
    help.textContent = 'We’ll text you a 6-digit code. No spam, ever.';
    help.classList.remove('help--error');
    if (root.dataset.mode === 'signup' && !nameInput.value.trim()) {
      nameInput.focus();
      return;
    }
    root.querySelector('[data-phone-shown]')!.textContent = phoneInput.value;
    digits.forEach((i) => (i.value = ''));
    showStep('otp');
    startCountdown();
    digits[0].focus();
  });

  root.querySelector('[data-change-number]')!.addEventListener('click', () => {
    showStep('phone');
    phoneInput.focus();
  });

  // Code boxes: one digit each, auto-advance, backspace goes back, paste fills all
  digits.forEach((input, i) => {
    input.addEventListener('input', () => {
      input.value = input.value.replace(/\D/g, '').slice(-1);
      if (input.value && i < digits.length - 1) digits[i + 1].focus();
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && !input.value && i > 0) digits[i - 1].focus();
    });
    input.addEventListener('paste', (e) => {
      const text = (e.clipboardData?.getData('text') ?? '').replace(/\D/g, '').slice(0, 6);
      if (!text) return;
      e.preventDefault();
      text.split('').forEach((ch, k) => (digits[k].value = ch));
      digits[Math.min(text.length, digits.length - 1)].focus();
    });
  });

  otpForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const code = digits.map((d) => d.value).join('');
    const err = root.querySelector<HTMLElement>('[data-otp-error]')!;
    if (code.length < 6) {
      err.hidden = false;
      digits.find((d) => !d.value)?.focus();
      return;
    }
    err.hidden = true;
    if (root.dataset.mode === 'signup') {
      saveProfile({ name: nameInput.value.trim(), lastName: '', phone: phoneInput.value });
      window.location.href = routes.onboarding;
    } else {
      window.location.href = routes.home;
    }
  });

  setMode('signup');
</script>

<style>
  .test-note {
    margin: 0;
    padding: 10px 14px;
    border-radius: 14px;
    background: var(--cream);
    border: 2px dashed var(--ink);
    font-weight: 700;
  }

  .checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 16px;
    font-weight: 700;
  }

  .checks li {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .auth {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 48px 80px;
  }

  .auth__inner {
    width: 100%;
    max-width: 520px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .auth__logo {
    display: none;
    align-self: flex-start;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .tabs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px;
    padding: 4px;
    border-radius: 18px;
    background: var(--paper-deep);
    border: 2px solid var(--ink);
  }

  .tabs__tab {
    min-height: 46px;
    border-radius: 14px;
    background: transparent;
    border: 2px solid transparent;
    color: var(--ink);
    font-weight: 800;
    font-size: 16px;
    cursor: pointer;
  }

  .tabs__tab[aria-selected='true'] {
    background: var(--mango);
    border-color: var(--ink);
    box-shadow: 0 3px 0 var(--ink);
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .step[hidden] {
    display: none;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 46px;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .lead {
    margin: 0;
    font-size: 18px;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .lead.small {
    font-size: 16px;
  }

  .link {
    color: var(--violet);
    font-weight: 700;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .group[hidden] {
    display: none;
  }

  .group__label {
    padding: 0;
    font-weight: 700;
    font-size: 16px;
  }

  .field__prefix {
    font-weight: 800;
    font-size: 16px;
  }

  .field__divider {
    width: 2px;
    height: 24px;
    background: var(--line);
  }

  .help {
    margin: 0;
    font-size: 16px;
    color: var(--ink-muted);
  }

  .help--error {
    color: var(--danger);
    font-weight: 700;
  }

  .help[hidden] {
    display: none;
  }

  .or {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 16px;
    color: var(--ink-muted);
  }

  .or span {
    flex: 1;
    height: 2px;
    background: var(--line);
  }

  .text-btn {
    min-height: 44px;
    padding: 0 4px;
    background: none;
    border: none;
    color: var(--violet);
    font-weight: 700;
    font-size: 16px;
    text-decoration: underline;
    cursor: pointer;
  }

  .otp-group {
    margin: 0;
    padding: 0;
    border: none;
  }

  .otp-group legend {
    margin-bottom: 10px;
  }

  .otp {
    display: flex;
    gap: 8px;
  }

  .otp__digit {
    width: 52px;
    height: 60px;
    box-sizing: border-box;
    text-align: center;
    font-size: 24px;
    font-weight: 800;
    border-radius: 14px;
    border: 2.5px solid var(--ink);
    background: var(--white);
    color: var(--ink);
  }

  .otp__digit:focus {
    border-color: var(--violet);
  }

  .otp + .help {
    margin-top: 10px;
  }

  @media (max-width: 1023px) {
    .auth {
      padding: 32px;
    }

    .auth__logo {
      display: inline-flex;
    }
  }

  @media (max-width: 639px) {
    .auth {
      justify-content: flex-start;
      padding: 20px 16px 28px;
    }

    h1 {
      font-size: 34px;
    }

    .otp {
      gap: 6px;
    }

    .otp__digit {
      flex: 1;
      min-width: 0;
      width: auto;
      height: 56px;
    }
  }
</style>
