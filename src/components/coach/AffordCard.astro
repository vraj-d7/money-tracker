---
// "Can I afford this?" card under a coach reply. The chat script fills it in for the item asked about.
---

<div class="afford">
  <div class="afford__top">
    <span class="afford__title">Can I afford this?</span>
    <span class="afford__badge">
      <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
      <span data-afford-badge></span>
    </span>
  </div>
  <div class="afford__bar" role="img" data-afford-bar>
    <div class="afford__fill" data-afford-fill></div>
    <div class="afford__gap" data-afford-gap></div>
  </div>
  <div class="num afford__nums">
    <span><b data-afford-fun></b> fun money a month</span>
    <span class="afford__short" data-afford-short></span>
  </div>
</div>

<style>
  .afford {
    padding: 18px;
    border-radius: 22px;
    background: var(--white);
    border: 2px solid var(--ink);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .afford__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .afford__title {
    font-weight: 800;
  }

  .afford__badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border-radius: 99px;
    background: #ffe7b0;
    color: #8a5800;
    font-weight: 800;
  }

  .afford__bar {
    position: relative;
    height: 22px;
    border-radius: 99px;
    background: #f1e7d3;
    border: 2px solid var(--ink);
    overflow: hidden;
  }

  .afford__fill {
    height: 100%;
    background: #ff7ec8;
  }

  .afford__gap {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    background: repeating-linear-gradient(45deg, transparent 0 6px, rgba(179, 54, 42, 0.35) 6px 9px);
  }

  .afford__nums {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }

  .afford__short[hidden] {
    display: none;
  }

  .afford__short {
    color: var(--danger);
    font-weight: 700;
  }
</style>
