---
// Desktop sidebar (264px). Under 1024px it shrinks to an 88px icon rail.
import Logo from './Logo.astro';
import { routes, type AppSection } from '../lib/routes';
import { demoUser } from '../data/demo-user';

interface Props {
  active?: AppSection;
}

const { active = 'home' } = Astro.props;

const items: { id: AppSection; label: string; href: string; d: string; badge?: boolean }[] = [
  { id: 'home', label: 'Home', href: routes.home, d: 'M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z' },
  { id: 'salary', label: 'Salary', href: routes.salary, d: 'M7 5h10M7 9h10M7 5c4 0 5 2 5 4s-1 4-5 4l8 7' },
  { id: 'offer', label: 'Offer face-off', href: routes.offer, d: 'M4 7h12l-3-3M20 17H8l3 3' },
  { id: 'plan', label: 'Plan & goals', href: routes.plan, d: 'M8 3h8v3H8zM6 6h12v13a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2zM6 13h12' },
  { id: 'coach', label: 'Coach', href: routes.coach, d: 'M4 5h16v11H9l-5 4z' },
  {
    id: 'scan',
    label: 'Autopay scan',
    href: routes.scan,
    d: 'M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3M4 12h16',
    badge: true,
  },
  { id: 'itr', label: 'First ITR', href: routes.itr, d: 'M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6' },
  { id: 'pf', label: 'PF corner', href: routes.pf, d: 'M5 10l7-6 7 6M6 10v9h12v-9M10 19v-5h4v5' },
  {
    id: 'notifications',
    label: 'Notifications',
    href: routes.notifications,
    d: 'M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.9 1.9 0 0 0 3.4 0',
    badge: true,
  },
];
---

<nav class="appnav" aria-label="App">
  <a href={routes.home} class="appnav__home" aria-label="Inhandy home">
    <Logo size={40} />
  </a>

  <ul class="appnav__list">
    {
      items.map((it) => {
        const on = it.id === active;
        return (
          <li>
            <a
              href={it.href}
              class:list={['navlink', { 'navlink--on': on }]}
              aria-current={on ? 'page' : undefined}
              title={it.label}
              data-nav-item={it.id}
            >
              <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex: none">
                <path d={it.d} />
              </svg>
              <span class="nav-text">{it.label}</span>
              {it.badge ? (
                <span class="nav-badge" aria-hidden="true" data-nav-badge hidden />
              ) : null}
            </a>
          </li>
        );
      })
    }
  </ul>

  <div class="appnav__foot">
    <section class="nav-plus" aria-label="Coach plan" data-nav-plus>
      <p class="nav-plus__title">Sunday check-ins, every week</p>
      <p class="nav-plus__text">The Coach plan is ₹19/week. Cancel anytime.</p>
      <a href={routes.paywall} class="btn btn--mango nav-plus__cta">Try the Coach plan</a>
    </section>
    <a
      href={routes.me}
      class:list={['navlink', 'nav-me', { 'navlink--me-on': active === 'me' }]}
      aria-current={active === 'me' ? 'page' : undefined}
      aria-label={`Me, ${demoUser.plan}`}
      data-nav-me
    >
      <span class="nav-me__avatar" aria-hidden="true" data-nav-initials></span>
      <span class="nav-text nav-me__text">
        <span class="nav-me__name" data-nav-name>Me</span>
        <span class="nav-me__plan" data-nav-plan>{demoUser.plan}</span>
      </span>
    </a>
  </div>
</nav>

<script>
  import { unreadCount } from '../scripts/notifications';
  import { displayName, initials, loadProfile } from '../scripts/profile-store';
  import { SCAN_RESULTS } from '../data/demo-tools';
  import { readLocal } from '../scripts/local-state';
  import { hasCoachPlan, loadSubscription } from '../scripts/subscription-store';

  // Show the saved profile's name and plan, and the live unread count, instead of the sample user
  const p = loadProfile();
  const name = displayName(p);
  const plan = hasCoachPlan(loadSubscription()) ? 'Coach plan' : 'Free plan';
  document.querySelectorAll('[data-nav-name]').forEach((el) => (el.textContent = name));
  document.querySelectorAll('[data-nav-initials]').forEach((el) => (el.textContent = initials(p)));
  document.querySelectorAll('[data-nav-plan]').forEach((el) => (el.textContent = plan));
  document.querySelectorAll('[data-nav-me]').forEach((el) => el.setAttribute('aria-label', `Me: ${name}, ${plan}`));
  // No need to advertise the Coach plan to someone already on it
  document.querySelectorAll<HTMLElement>('[data-nav-plus]').forEach((el) => (el.hidden = plan === 'Coach plan'));

  // "Autopays to review" only means something after a statement has been scanned,
  // and then it's what that statement turned up
  const scanned = readLocal('scan:done', false);
  const found = readLocal<unknown[] | null>('scan:subs', null);
  document.querySelectorAll<HTMLElement>('[data-nav-item="scan"]').forEach((link) => {
    const badge = link.querySelector<HTMLElement>('[data-nav-badge]');
    const count = !scanned ? 0 : found ? found.length : SCAN_RESULTS.length;
    if (badge) {
      badge.textContent = String(count);
      badge.hidden = count === 0;
    }
    link.setAttribute('aria-label', count ? `Autopay scan, ${count} autopays to review` : 'Autopay scan');
  });

  const unread = unreadCount(readLocal<string[]>('notifications:read', []));
  document.querySelectorAll<HTMLElement>('[data-nav-item="notifications"]').forEach((link) => {
    const badge = link.querySelector<HTMLElement>('[data-nav-badge]');
    if (badge) {
      badge.textContent = String(unread);
      badge.hidden = unread === 0;
    }
    link.setAttribute('aria-label', unread ? `Notifications, ${unread} new` : 'Notifications');
  });
</script>

<style>
  .appnav {
    position: sticky;
    top: 0;
    width: 264px;
    height: 100vh;
    height: 100dvh;
    overflow-y: auto;
    box-sizing: border-box;
    line-height: 1.35;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px 18px;
    background: var(--white);
    border-right: 2.5px solid var(--ink);
  }

  .appnav__home {
    display: flex;
    align-items: center;
    padding: 0 6px;
    min-height: 44px;
    text-decoration: none;
  }

  .appnav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .navlink {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 48px;
    padding: 0 14px;
    box-sizing: border-box;
    border-radius: 16px;
    border: 2.5px solid transparent;
    color: var(--ink);
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .navlink:not([aria-current]):hover {
    background: var(--paper-deep);
  }

  .navlink--on {
    background: var(--mango);
    border-color: var(--ink);
    font-weight: 800;
  }

  .nav-text {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav-badge {
    flex: none;
    min-width: 24px;
    padding: 1px 6px;
    box-sizing: border-box;
    text-align: center;
    border-radius: 99px;
    background: var(--danger-bg);
    color: var(--danger);
    font-size: 16px;
    font-weight: 800;
  }

  .nav-badge[hidden],
  .nav-plus[hidden] {
    display: none !important;
  }

  .appnav__foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .nav-plus {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px;
    border-radius: 22px;
    background: var(--cream);
    border: 2.5px solid var(--ink);
  }

  .nav-plus__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 18px;
    line-height: 1.15;
  }

  .nav-plus__text {
    margin: 0;
    font-size: 16px;
    line-height: 1.4;
    color: var(--ink-muted);
  }

  .nav-plus__cta {
    min-height: 46px;
    border-radius: 14px;
    font-weight: 800;
    box-shadow: 0 4px 0 var(--ink);
  }

  .nav-me {
    min-height: 56px;
    padding: 6px 10px;
    border: none;
  }

  .navlink--me-on {
    background: var(--cream);
  }

  .nav-me__avatar {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 14px;
    background: var(--mango);
    border: 2.5px solid var(--ink);
    box-sizing: border-box;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 16px;
  }

  .nav-me__text {
    display: flex;
    flex-direction: column;
  }

  .nav-me__name {
    font-weight: 700;
  }

  .nav-me__plan {
    font-weight: 400;
    color: var(--ink-muted);
  }

  @media (max-width: 1023px) {
    .appnav {
      width: 88px;
      padding: 20px 12px;
      align-items: center;
    }

    .appnav .nav-text,
    .appnav .nav-plus,
    .appnav :global(.logo-word) {
      display: none;
    }

    .appnav .navlink {
      justify-content: center;
      padding: 0;
      width: 56px;
    }

    .appnav .nav-badge {
      position: absolute;
      top: 2px;
      right: 0;
    }

    .appnav .nav-me {
      padding: 6px;
    }
  }
</style>
