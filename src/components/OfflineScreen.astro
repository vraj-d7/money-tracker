---
// Covers the page whenever the browser goes offline, and steps aside when the connection is back.
import Logo from './Logo.astro';
import StatePanel from './StatePanel.astro';
---

<div class="offline paper-dots" role="alertdialog" aria-modal="true" aria-labelledby="offline-title" data-offline hidden>
  <div class="offline__logo"><Logo size={36} /></div>
  <div class="offline__main">
    <StatePanel
      mood="chill"
      title="No internet right now"
      titleId="offline-title"
      as="h2"
      text="Handy will wait. Numbers you’ve already seen stay on screen; new scans and chats need a connection."
    >
      <p class="synced">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7v5l3 2"></path></svg>
        Last synced <span data-offline-since></span>
      </p>
      <div class="state__actions">
        <button type="button" class="btn btn--mango btn--lg" data-offline-retry>Try again</button>
      </div>
      <p class="still" role="status" data-offline-status></p>
    </StatePanel>
  </div>
</div>

<script>
  const screen = document.querySelector<HTMLElement>('[data-offline]');
  if (screen) {
    const status = screen.querySelector('[data-offline-status]')!;
    let lastFocus: HTMLElement | null = null;

    const time = (d: Date) => d.toLocaleTimeString('en-IN', { hour: 'numeric', minute: '2-digit' }).toUpperCase();

    function show() {
      if (!screen!.hidden) return;
      screen!.querySelector('[data-offline-since]')!.textContent = time(new Date());
      status.textContent = '';
      lastFocus = document.activeElement as HTMLElement | null;
      screen!.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      screen!.querySelector<HTMLButtonElement>('[data-offline-retry]')!.focus();
    }

    function hide() {
      if (screen!.hidden) return;
      screen!.hidden = true;
      document.documentElement.style.overflow = '';
      lastFocus?.focus?.();
    }

    window.addEventListener('offline', show);
    window.addEventListener('online', hide);
    screen.querySelector('[data-offline-retry]')!.addEventListener('click', () => {
      if (navigator.onLine) hide();
      else status.textContent = 'Still offline. Check your Wi-Fi or mobile data.';
    });
    if (!navigator.onLine) show();
  }
</script>

<style>
  .offline {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  .offline[hidden] {
    display: none;
  }

  .offline__logo {
    padding: 24px 32px;
  }

  .offline__main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 20px 64px;
  }

  .synced {
    margin: 0;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-radius: 14px;
    background: var(--danger-bg);
    color: var(--danger);
    font-weight: 700;
  }

  .still {
    margin: 0;
    min-height: 24px;
    font-weight: 700;
    color: var(--danger);
  }

  @media (max-width: 639px) {
    .offline__logo {
      padding: 16px;
    }

    .offline__main {
      align-items: flex-start;
      padding: 16px 16px 48px;
    }
  }
</style>
