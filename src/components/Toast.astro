---
// Static toast, for showing on a page as-is. To pop one up from code, use showToast() in scripts/toast.ts.
import { toastIcons, type ToastKind } from '../lib/toast-icons';

interface Props {
  kind?: ToastKind;
  text: string;
  action?: string;
}

const { kind = 'success', text, action } = Astro.props;
---

<div class="toast" role="status">
  <span class={`toast__icon toast__icon--${kind}`} aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
      <path d={toastIcons[kind]} />
    </svg>
  </span>
  <span class="toast__text">{text}</span>
  {action && <button type="button" class="toast__action">{action}</button>}
</div>
