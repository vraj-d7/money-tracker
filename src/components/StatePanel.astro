---
// Big friendly state: Handy in a dashed circle beside a title, a line of text and actions (slot).
// Used for page not found, offline and empty states.
import Handy from './Handy.astro';
import type { HandyMood } from '../lib/handy';

interface Props {
  mood: HandyMood;
  title: string;
  text: string;
  /** Heading level: h1 for whole pages, h2 inside a page */
  as?: 'h1' | 'h2';
  titleId?: string;
}

const { mood, title, text, as: Heading = 'h1', titleId } = Astro.props;
---

<div class="state">
  <div class="state__art" aria-hidden="true">
    <Handy mood={mood} size={150} decorative />
  </div>
  <div class="state__body">
    <Heading class="state__title" id={titleId}>{title}</Heading>
    <p class="state__text">{text}</p>
    <slot />
  </div>
</div>

<style>
  .state {
    display: flex;
    align-items: center;
    gap: 48px;
    max-width: 760px;
  }

  .state__art {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: var(--paper-deep);
    border: 3px dashed #8a5800;
    box-sizing: border-box;
  }

  .state__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .state__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 44px;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .state__text {
    margin: 0;
    font-size: 18px;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .state :global(.state__actions) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }

  @media (max-width: 767px) {
    .state {
      flex-direction: column;
      align-items: stretch;
      gap: 28px;
      text-align: left;
    }

    .state__art {
      align-self: center;
      width: 200px;
      height: 200px;
    }

    .state__art :global(.handy) {
      width: 120px !important;
      height: 120px !important;
    }

    .state__title {
      font-size: 34px;
    }

    .state :global(.state__actions) {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
