---
// Trust wall: animated padlock + four promises.
const promises = [
  { title: 'We never ask for your bank password', body: 'You upload a statement PDF. That’s it. No net-banking login, ever.', icon: 'M8 11a4 4 0 1 1 0 8 4 4 0 0 1 0-8zM10.8 12.2L20 3M17 6l3 3M14 9l2 2M3 3l18 18' },
  { title: 'We never store your bank statements', body: 'We read the PDF, keep only the patterns we need, and delete the file.', icon: 'M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zM14 3v5h5M9.5 12.5l5 5M14.5 12.5l-5 5' },
  { title: 'Delete everything in one tap', body: 'Settings, then “Delete my data”. Gone. No retention games.', icon: 'M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3' },
  { title: 'No selling your data', body: 'Not to lenders, not to advertisers, not to anyone.', icon: 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6zM9 12l2 2 4-4' },
];
---

<section id="trust" class="lp-sec lp-band trust" aria-labelledby="trust-h">
  <div class="trust__head">
    <div class="lock">
      <div class="lock__glow" aria-hidden="true"></div>
      <svg viewBox="0 0 100 100" width="104" height="104" role="img" aria-label="Padlock, locked">
        <path class="lock__shackle" d="M32 46 V34 a18 18 0 0 1 36 0 V46" stroke="#15131C" stroke-width="9" fill="none" stroke-linecap="round"></path>
        <rect x="20" y="44" width="60" height="46" rx="14" fill="#FFB21E" stroke="#15131C" stroke-width="4"></rect>
        <circle cx="50" cy="63" r="6" fill="#15131C"></circle>
        <path d="M50 66 V76" stroke="#15131C" stroke-width="5" stroke-linecap="round"></path>
      </svg>
    </div>
    <div class="trust__titles">
      <p class="lp-eyebrow">Trust, not fine print</p>
      <h2 id="trust-h" class="lp-h2">Your money stuff stays yours.</h2>
    </div>
  </div>
  <div class="promises">
    {
      promises.map((p) => (
        <div class="promise">
          <span class="promise__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d={p.icon} />
            </svg>
          </span>
          <h3 class="promise__title">{p.title}</h3>
          <p class="promise__body">{p.body}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .trust {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .trust__head {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .trust__titles {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .lock {
    position: relative;
    flex: none;
    width: 104px;
    height: 104px;
  }

  .lock svg {
    position: relative;
  }

  .lock__glow {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--mint);
    opacity: 0;
    animation: lock-glow 3.2s ease-out infinite;
  }

  @keyframes lock-glow {
    0%,
    30% {
      opacity: 0;
      transform: scale(0.8);
    }
    40% {
      opacity: 0.7;
    }
    100% {
      opacity: 0;
      transform: scale(1.5);
    }
  }

  .lock__shackle {
    animation: shackle 3.2s cubic-bezier(0.3, 1.5, 0.5, 1) infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes shackle {
    0%,
    15% {
      transform: translateY(-7px);
    }
    35%,
    100% {
      transform: translateY(0);
    }
  }

  .promises {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .promise {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
    border-radius: 26px;
    background: var(--white);
    border: 2.5px solid var(--ink);
    box-shadow: 0 6px 0 var(--ink);
  }

  .promise__icon {
    display: inline-flex;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    align-items: center;
    justify-content: center;
    background: var(--mango);
    border: 2.5px solid var(--ink);
    box-sizing: border-box;
  }

  .promise__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 23px;
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  .promise__body {
    margin: 0;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  @media (max-width: 1279px) {
    .promises {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .trust__head {
      flex-direction: column;
      align-items: flex-start;
    }

    .promises {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
