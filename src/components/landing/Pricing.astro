---
// Pricing: everything is free for now (see PAID_PLANS_ON in scripts/subscription-store.ts).
import { routes } from '../../lib/routes';

const everything = [
  'Salary explained: CTC to in-hand',
  'Old vs new tax regime check',
  'Offer face-off with share card',
  'First ITR checklist',
  'Salary-day plan, jars and goals',
  'Coach chat, all three modes',
  'Autopay scans + forgotten-subscription finder',
  'Sunday check-ins with your streak',
];
const tick = 'M5 12l4 4 10-10';
---

<section id="pricing" class="lp-sec pricing" aria-labelledby="price-h">
  <div class="lp-intro">
    <p class="lp-eyebrow">Pricing</p>
    <h2 id="price-h" class="lp-h2">Free for now. No card, no UPI.</h2>
  </div>

  <div class="plan">
    <div>
      <h3 class="plan__name">Everything, free</h3>
      <p class="plan__sub">Every part of Inhandy is free while we’re getting started.</p>
    </div>
    <ul class="plan__list">
      {
        everything.map((f) => (
          <li>
            <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0A6B4D" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d={tick} /></svg>
            {f}
          </li>
        ))
      }
    </ul>
    <a href={routes.auth} class="btn btn--mango btn--lg plan__cta">Start free</a>
  </div>
</section>

<style>
  .pricing {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .plan {
    align-self: center;
    width: 100%;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 28px;
    border-radius: 28px;
    background: var(--white);
    border: 2.5px solid var(--ink);
    box-shadow: 0 6px 0 var(--ink);
  }

  .plan__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 26px;
  }

  .plan__sub {
    margin: 4px 0 0;
    color: var(--ink-muted);
  }

  .plan__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .plan__list li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    line-height: 1.4;
  }

  .plan__list svg {
    flex: none;
  }

  .plan__cta {
    margin-top: auto;
    font-weight: 800;
  }

</style>
