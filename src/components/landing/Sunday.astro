---
// Sunday check-in: a phone mock-up where Handy types the weekly recap (starts when scrolled into view).
import Handy from '../Handy.astro';
import { SUNDAY_MESSAGE } from '../../lib/landing';

const points = [
  { text: 'Spend vs plan, in one line', icon: 'M4 19V9M10 19V5M16 19v-7M22 19H2' },
  { text: 'Renewals before they hit', icon: 'M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.9 1.9 0 0 0 3.4 0' },
  { text: 'A streak worth protecting', icon: 'M12 22c4 0 7-3 7-7 0-5-5-7-5-12-3 2-5 5-5 8-1-1-2-2-2-4-2 2-2 5-2 8 0 4 3 7 7 7z' },
];
---

<section class="lp-sec lp-band sunday" aria-labelledby="sun-h" data-sunday data-message={SUNDAY_MESSAGE}>
  <div class="sunday__text">
    <p class="lp-eyebrow">Sunday check-in</p>
    <h2 id="sun-h" class="lp-h2">One minute. Every Sunday. Chai optional.</h2>
    <p class="lp-lead">Your coach recaps the week: what you spent, what you saved, what’s renewing, and whether you’re on track for payday.</p>
    <div class="points">
      {
        points.map((p) => (
          <p class="point">
            <span class="point__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d={p.icon} />
              </svg>
            </span>
            {p.text}
          </p>
        ))
      }
    </div>
    <button type="button" class="btn replay" data-replay>
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"></path><path d="M3 4v5h5"></path></svg>
      Replay message
    </button>
  </div>

  <div class="phone-wrap">
    <div class="phone" role="img" aria-label={`Phone showing Handy's Sunday message: ${SUNDAY_MESSAGE}`}>
      <div class="screen" aria-hidden="true">
        <div class="chat-head">
          <Handy mood="chai" size={40} decorative />
          <div class="chat-head__who">
            <span class="chat-head__name">Handy</span>
            <span class="chat-head__sub">your money coach</span>
          </div>
        </div>
        <div class="chat">
          <span class="chat__time">Sunday, 9:00 AM</span>
          <p class="bubble"><span data-typed>{SUNDAY_MESSAGE}</span><span class="caret" data-caret hidden></span></p>
          <div class="after" data-after>
            <div class="week pop-in">
              <div class="week__top">
                <span class="week__label">THIS WEEK</span>
                <span class="num week__nums"><b>₹3,240</b> / ₹3,840</span>
              </div>
              <div class="week__bar"><div></div></div>
              <div class="week__chips">
                <span class="mini mini--mint">₹600 under plan</span>
                <span class="mini mini--coral">Tue · ₹149</span>
                <span class="mini mini--gold">6-week streak</span>
              </div>
            </div>
            <div class="replies pop-in">
              <span class="reply reply--ghost">Show my week</span>
              <span class="reply reply--lilac">Thanks, didi!</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-sunday]')!;
  const chars = Array.from(root.dataset.message!);
  const typed = root.querySelector('[data-typed]')!;
  const caret = root.querySelector<HTMLElement>('[data-caret]')!;
  const after = root.querySelector<HTMLElement>('[data-after]')!;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let timer = 0;

  function type() {
    window.clearInterval(timer);
    if (reduceMotion) return;
    let n = 0;
    typed.textContent = '';
    caret.hidden = false;
    after.hidden = true;
    timer = window.setInterval(() => {
      n++;
      typed.textContent = chars.slice(0, n).join('');
      if (n >= chars.length) {
        window.clearInterval(timer);
        caret.hidden = true;
        after.hidden = false;
      }
    }, 34);
  }

  root.querySelector('[data-replay]')!.addEventListener('click', type);

  // Start typing the first time the phone scrolls into view
  const io = new IntersectionObserver(
    (entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        io.disconnect();
        type();
      }
    },
    { threshold: 0.4 },
  );
  io.observe(root.querySelector('.phone')!);
</script>

<style>
  .sunday {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 64px;
    align-items: center;
  }

  .sunday__text {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .points {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .point {
    margin: 0;
    display: flex;
    gap: 12px;
    align-items: center;
    font-weight: 600;
  }

  .point__icon {
    flex: none;
    display: inline-flex;
    width: 36px;
    height: 36px;
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    background: var(--mango);
    border: 2px solid var(--ink);
    box-sizing: border-box;
  }

  .replay {
    align-self: flex-start;
    min-height: 48px;
    padding: 10px 18px;
    border-radius: 14px;
  }

  .phone-wrap {
    display: flex;
    justify-content: center;
  }

  .phone {
    width: 320px;
    height: 660px;
    max-width: 100%;
    box-sizing: border-box;
    padding: 10px;
    border-radius: 52px;
    background: var(--ink);
    box-shadow: 0 30px 60px rgba(21, 19, 28, 0.3);
  }

  .screen {
    width: 100%;
    height: 100%;
    border-radius: 42px;
    overflow: hidden;
    background: #f6f0e3;
    display: flex;
    flex-direction: column;
  }

  .chat-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 34px 16px 12px;
    border-bottom: 2px solid var(--line);
    background: var(--white);
  }

  .chat-head__who {
    display: flex;
    flex-direction: column;
  }

  .chat-head__name {
    font-weight: 800;
  }

  .chat-head__sub {
    color: var(--ink-muted);
  }

  .chat {
    flex: 1;
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .chat__time {
    align-self: center;
    padding: 4px 10px;
    border-radius: 99px;
    background: var(--paper-deep);
    font-weight: 600;
    color: var(--ink-muted);
  }

  .bubble {
    margin: 0;
    align-self: flex-start;
    max-width: 92%;
    padding: 12px 14px;
    border-radius: 20px 20px 20px 6px;
    background: var(--white);
    border: 2px solid var(--ink);
    line-height: 1.45;
  }

  .caret {
    display: inline-block;
    width: 2px;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: -0.18em;
    background: currentColor;
    animation: caret 1s steps(1) infinite;
  }

  .caret[hidden],
  .after[hidden] {
    display: none;
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  .after {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .week {
    width: 92%;
    box-sizing: border-box;
    padding: 14px;
    border-radius: 20px;
    background: var(--white);
    border: 2px solid var(--ink);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .week__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .week__label {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: var(--ink-muted);
  }

  .week__nums {
    font-size: 15px;
    font-weight: 700;
    white-space: nowrap;
  }

  .week__nums b {
    font-size: 18px;
    font-weight: 800;
  }

  .week__bar {
    height: 12px;
    border-radius: 99px;
    background: #f1e7d3;
    border: 2px solid var(--ink);
    overflow: hidden;
  }

  .week__bar div {
    width: 84%;
    height: 100%;
    background: var(--mint);
  }

  .week__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .mini {
    padding: 4px 10px;
    border-radius: 99px;
    font-weight: 700;
    font-size: 14px;
  }

  .mini--mint {
    background: #e2f8ef;
    color: #0a6b4d;
  }

  .mini--coral {
    background: var(--danger-bg);
    color: var(--danger);
  }

  .mini--gold {
    background: #ffe7b0;
    color: #8a5800;
  }

  .replies {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
    flex-wrap: wrap;
  }

  .reply {
    padding: 8px 12px;
    border-radius: 99px;
    font-weight: 700;
    font-size: 15px;
  }

  .reply--ghost {
    border: 2px solid var(--violet);
    color: var(--violet);
  }

  .reply--lilac {
    background: var(--focus);
    border: 2px solid var(--ink);
  }

  @media (max-width: 639px) {
    .sunday {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    .replay {
      align-self: stretch;
    }

    .phone {
      width: 300px;
      height: 620px;
    }
  }
</style>
